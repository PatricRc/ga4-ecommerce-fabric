		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 55 >= _min, CALCULATE([Revenue], DATESBETWEEN('Date'[date], _e - 55, _e - 28)))
	// [Base\Time\Rolling Windows]
	MEASURE '_Measures'[Revenue L28D Δ%] =
		VAR _p = [Revenue P28D]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Revenue L28D] - _p, _p))
	// [Base\Time\Rolling Windows] — Conversion Rate in the 28 days ending on the last selected day.
	MEASURE '_Measures'[Conversion Rate L28D] =
		VAR _e = [Period End]
		RETURN CALCULATE([Conversion Rate], DATESBETWEEN('Date'[date], _e - 27, _e))
	// [Base\Time\Rolling Windows] — Conversion Rate in the 28 days before the last 28 days (blank when that falls before Nov 1).
	MEASURE '_Measures'[Conversion Rate P28D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 55 >= _min, CALCULATE([Conversion Rate], DATESBETWEEN('Date'[date], _e - 55, _e - 28)))
	// [Base\Time\Rolling Windows]
	MEASURE '_Measures'[Conversion Rate L28D Δ pts] =
		VAR _p = [Conversion Rate P28D]
		RETURN IF(NOT ISBLANK(_p), ([Conversion Rate L28D] - _p) * 100)
	// [Base\Time\Rolling Windows] — AOV in the 28 days ending on the last selected day.
	MEASURE '_Measures'[AOV L28D] =
		VAR _e = [Period End]
		RETURN CALCULATE([AOV], DATESBETWEEN('Date'[date], _e - 27, _e))
	// [Base\Time\Rolling Windows] — AOV in the 28 days before the last 28 days (blank when that falls before Nov 1).
	MEASURE '_Measures'[AOV P28D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 55 >= _min, CALCULATE([AOV], DATESBETWEEN('Date'[date], _e - 55, _e - 28)))
	// [Base\Time\Rolling Windows]
	MEASURE '_Measures'[AOV L28D Δ%] =
		VAR _p = [AOV P28D]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([AOV L28D] - _p, _p))
	// [Base\Time\Rolling Windows] — Revenue per Session in the 28 days ending on the last selected day.
	MEASURE '_Measures'[Revenue per Session L28D] =
		VAR _e = [Period End]
		RETURN CALCULATE([Revenue per Session], DATESBETWEEN('Date'[date], _e - 27, _e))
	// [Base\Time\Rolling Windows] — Revenue per Session in the 28 days before the last 28 days (blank when that falls before Nov 1).
	MEASURE '_Measures'[Revenue per Session P28D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 55 >= _min, CALCULATE([Revenue per Session], DATESBETWEEN('Date'[date], _e - 55, _e - 28)))
	// [Base\Time\Rolling Windows]
	MEASURE '_Measures'[Revenue per Session L28D Δ%] =
		VAR _p = [Revenue per Session P28D]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Revenue per Session L28D] - _p, _p))
	// [Base\Time\Rolling Windows] — New Users in the 7 days ending on the last selected day.
	MEASURE '_Measures'[New Users L7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 6 >= _min, CALCULATE([New Users], DATESBETWEEN('Date'[date], _e - 6, _e)))
	// [Base\Time\Rolling Windows] — New Users in the 7 days before the last 7 days.
	MEASURE '_Measures'[New Users P7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 13 >= _min, CALCULATE([New Users], DATESBETWEEN('Date'[date], _e - 13, _e - 7)))
	// [Base\Time\Rolling Windows]
	MEASURE '_Measures'[New Users L7D Δ%] =
		VAR _p = [New Users P7D]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([New Users L7D] - _p, _p))
	// [Base\Time\Rolling Windows] — Engagement Rate in the 7 days ending on the last selected day.
	MEASURE '_Measures'[Engagement Rate L7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 6 >= _min, CALCULATE([Engagement Rate], DATESBETWEEN('Date'[date], _e - 6, _e)))
	// [Base\Time\Rolling Windows] — Engagement Rate in the 7 days before the last 7 days.
	MEASURE '_Measures'[Engagement Rate P7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 13 >= _min, CALCULATE([Engagement Rate], DATESBETWEEN('Date'[date], _e - 13, _e - 7)))
	// [Base\Time\Rolling Windows]
	MEASURE '_Measures'[Engagement Rate L7D Δ pts] =
		VAR _p = [Engagement Rate P7D]
		RETURN IF(NOT ISBLANK(_p), ([Engagement Rate L7D] - _p) * 100)
	// [Base\Time\Rolling Windows] — Pages per Session in the 7 days ending on the last selected day.
	MEASURE '_Measures'[Pages per Session L7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 6 >= _min, CALCULATE([Pages per Session], DATESBETWEEN('Date'[date], _e - 6, _e)))
	// [Base\Time\Rolling Windows] — Pages per Session in the 7 days before the last 7 days.
	MEASURE '_Measures'[Pages per Session P7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 13 >= _min, CALCULATE([Pages per Session], DATESBETWEEN('Date'[date], _e - 13, _e - 7)))
	// [Base\Time\Rolling Windows]
	MEASURE '_Measures'[Pages per Session L7D Δ%] =
		VAR _p = [Pages per Session P7D]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Pages per Session L7D] - _p, _p))
	// [Base\Time\Rolling Windows] — Avg Engagement Time (sec) in the 7 days ending on the last selected day.
	MEASURE '_Measures'[Avg Engagement Time (sec) L7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 6 >= _min, CALCULATE([Avg Engagement Time (sec)], DATESBETWEEN('Date'[date], _e - 6, _e)))
	// [Base\Time\Rolling Windows] — Avg Engagement Time (sec) in the 7 days before the last 7 days.
	MEASURE '_Measures'[Avg Engagement Time (sec) P7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 13 >= _min, CALCULATE([Avg Engagement Time (sec)], DATESBETWEEN('Date'[date], _e - 13, _e - 7)))
	// [Base\Time\Rolling Windows]
	MEASURE '_Measures'[Avg Engagement Time (sec) L7D Δ%] =
		VAR _p = [Avg Engagement Time (sec) P7D]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Avg Engagement Time (sec) L7D] - _p, _p))
	// [Base\Time\Rolling Windows] — View Item Sessions in the 7 days ending on the last selected day.
	MEASURE '_Measures'[View Item Sessions L7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 6 >= _min, CALCULATE([View Item Sessions], DATESBETWEEN('Date'[date], _e - 6, _e)))
	// [Base\Time\Rolling Windows] — View Item Sessions in the 7 days before the last 7 days.
	MEASURE '_Measures'[View Item Sessions P7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 13 >= _min, CALCULATE([View Item Sessions], DATESBETWEEN('Date'[date], _e - 13, _e - 7)))
	// [Base\Time\Rolling Windows]
	MEASURE '_Measures'[View Item Sessions L7D Δ%] =
		VAR _p = [View Item Sessions P7D]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([View Item Sessions L7D] - _p, _p))
	// [Base\Time\Rolling Windows] — Begin Checkout Sessions in the 7 days ending on the last selected day.
	MEASURE '_Measures'[Begin Checkout Sessions L7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 6 >= _min, CALCULATE([Begin Checkout Sessions], DATESBETWEEN('Date'[date], _e - 6, _e)))
	// [Base\Time\Rolling Windows] — Begin Checkout Sessions in the 7 days before the last 7 days.
	MEASURE '_Measures'[Begin Checkout Sessions P7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 13 >= _min, CALCULATE([Begin Checkout Sessions], DATESBETWEEN('Date'[date], _e - 13, _e - 7)))
	// [Base\Time\Rolling Windows]
	MEASURE '_Measures'[Begin Checkout Sessions L7D Δ%] =
		VAR _p = [Begin Checkout Sessions P7D]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Begin Checkout Sessions L7D] - _p, _p))
	// [Base\Time\Rolling Windows] — Purchase Sessions in the 7 days ending on the last selected day.
	MEASURE '_Measures'[Purchase Sessions L7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 6 >= _min, CALCULATE([Purchase Sessions], DATESBETWEEN('Date'[date], _e - 6, _e)))
	// [Base\Time\Rolling Windows] — Purchase Sessions in the 7 days before the last 7 days.
	MEASURE '_Measures'[Purchase Sessions P7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 13 >= _min, CALCULATE([Purchase Sessions], DATESBETWEEN('Date'[date], _e - 13, _e - 7)))
	// [Base\Time\Rolling Windows]
	MEASURE '_Measures'[Purchase Sessions L7D Δ%] =
		VAR _p = [Purchase Sessions P7D]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Purchase Sessions L7D] - _p, _p))
	// [Base\Time\Rolling Windows] — Cart Abandonment Rate in the 7 days ending on the last selected day.
	MEASURE '_Measures'[Cart Abandonment Rate L7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 6 >= _min, CALCULATE([Cart Abandonment Rate], DATESBETWEEN('Date'[date], _e - 6, _e)))
	// [Base\Time\Rolling Windows] — Cart Abandonment Rate in the 7 days before the last 7 days.
	MEASURE '_Measures'[Cart Abandonment Rate P7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 13 >= _min, CALCULATE([Cart Abandonment Rate], DATESBETWEEN('Date'[date], _e - 13, _e - 7)))
	// [Base\Time\Rolling Windows]
	MEASURE '_Measures'[Cart Abandonment Rate L7D Δ pts] =
		VAR _p = [Cart Abandonment Rate P7D]
		RETURN IF(NOT ISBLANK(_p), ([Cart Abandonment Rate L7D] - _p) * 100)
	// [Base\Time\Rolling Windows] — Item Revenue in the 7 days ending on the last selected day.
	MEASURE '_Measures'[Item Revenue L7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 6 >= _min, CALCULATE([Item Revenue], DATESBETWEEN('Date'[date], _e - 6, _e)))
	// [Base\Time\Rolling Windows] — Item Revenue in the 7 days before the last 7 days.
	MEASURE '_Measures'[Item Revenue P7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 13 >= _min, CALCULATE([Item Revenue], DATESBETWEEN('Date'[date], _e - 13, _e - 7)))
	// [Base\Time\Rolling Windows]
	MEASURE '_Measures'[Item Revenue L7D Δ%] =
		VAR _p = [Item Revenue P7D]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Item Revenue L7D] - _p, _p))
	// [Base\Time\Rolling Windows] — Units Purchased in the 7 days ending on the last selected day.
	MEASURE '_Measures'[Units Purchased L7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 6 >= _min, CALCULATE([Units Purchased], DATESBETWEEN('Date'[date], _e - 6, _e)))
	// [Base\Time\Rolling Windows] — Units Purchased in the 7 days before the last 7 days.
	MEASURE '_Measures'[Units Purchased P7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 13 >= _min, CALCULATE([Units Purchased], DATESBETWEEN('Date'[date], _e - 13, _e - 7)))
	// [Base\Time\Rolling Windows]
	MEASURE '_Measures'[Units Purchased L7D Δ%] =
		VAR _p = [Units Purchased P7D]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Units Purchased L7D] - _p, _p))
	// [Base\Time\Rolling Windows] — Avg Item Price in the 7 days ending on the last selected day.
	MEASURE '_Measures'[Avg Item Price L7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 6 >= _min, CALCULATE([Avg Item Price], DATESBETWEEN('Date'[date], _e - 6, _e)))
	// [Base\Time\Rolling Windows] — Avg Item Price in the 7 days before the last 7 days.
	MEASURE '_Measures'[Avg Item Price P7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 13 >= _min, CALCULATE([Avg Item Price], DATESBETWEEN('Date'[date], _e - 13, _e - 7)))
	// [Base\Time\Rolling Windows]
	MEASURE '_Measures'[Avg Item Price L7D Δ%] =
		VAR _p = [Avg Item Price P7D]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Avg Item Price L7D] - _p, _p))
	// [Base\Time\Rolling Windows] — Items Sold in the 7 days ending on the last selected day.
	MEASURE '_Measures'[Items Sold L7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 6 >= _min, CALCULATE([Items Sold], DATESBETWEEN('Date'[date], _e - 6, _e)))
	// [Base\Time\Rolling Windows] — Items Sold in the 7 days before the last 7 days.
	MEASURE '_Measures'[Items Sold P7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 13 >= _min, CALCULATE([Items Sold], DATESBETWEEN('Date'[date], _e - 13, _e - 7)))
	// [Base\Time\Rolling Windows]
	MEASURE '_Measures'[Items Sold L7D Δ%] =
		VAR _p = [Items Sold P7D]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Items Sold L7D] - _p, _p))
	// [Pages\01 Overview] — Channel with the most revenue in the selection.
	MEASURE '_Measures'[Top Channel] =
		VAR _t = ADDCOLUMNS(ALLSELECTED('Channel'[channel_group]), "@r", [Revenue])
		RETURN MAXX(TOPN(1, _t, [@r], DESC), 'Channel'[channel_group])
	// [Pages\01 Overview] — Revenue on peak-season days (dim_ga4_date.is_peak_season: Black Friday week to Christmas).
	MEASURE '_Measures'[Peak Season Revenue] =
		CALCULATE([Revenue], 'Date'[is_peak_season] = TRUE())
	// [Pages\01 Overview]
	MEASURE '_Measures'[Peak Season Revenue Share] =
		DIVIDE([Peak Season Revenue], [Revenue])
	// [Pages\01 Overview]
	MEASURE '_Measures'[Peak Season Day Share] =
		DIVIDE(CALCULATE(COUNTROWS('Date'), 'Date'[is_peak_season] = TRUE()), COUNTROWS('Date'))
	// [Pages\01 Overview]
	MEASURE '_Measures'[Peak Season Conversion Rate] =
		CALCULATE([Conversion Rate], 'Date'[is_peak_season] = TRUE())
	// [Pages\01 Overview]
	MEASURE '_Measures'[Off-Peak Conversion Rate] =
		CALCULATE([Conversion Rate], 'Date'[is_peak_season] = FALSE())
	// [Pages\01 Overview] — Peak-season conversion rate vs off-peak, relative. Blank unless the selection has both kinds of day.
	MEASURE '_Measures'[Peak Conversion Lift] =
		VAR _p = [Peak Season Conversion Rate]
		VAR _o = [Off-Peak Conversion Rate]
		RETURN IF(NOT ISBLANK(_p) && NOT ISBLANK(_o), DIVIDE(_p, _o) - 1)
	// [Pages\01 Overview]
	MEASURE '_Measures'[Best Revenue Day] =
		VAR _t = ADDCOLUMNS(VALUES('Date'[date]), "@r", [Revenue])
		VAR _top = TOPN(1, _t, [@r], DESC)
		RETURN FORMAT(MAXX(_top, 'Date'[date]), "ddd, mmm d") & " · $" & FORMAT(MAXX(_top, [@r]), "#,##0")
	// [Pages\01 Overview] — Revenue on Black Friday, Cyber Monday, Christmas and New Year days.
	MEASURE '_Measures'[Holiday Day Revenue] =
		CALCULATE([Revenue], NOT ISBLANK('Date'[holiday_name]))
	// [Pages\01 Overview] — Story headline for page 1 (finding first, then the driver).
	MEASURE '_Measures'[01 Headline] =
		VAR _r = [Revenue]
		VAR _d = [Revenue Δ%]
		VAR _ch = [Top Channel]
		VAR _sh = [Revenue Share of Top Channel]
		VAR _peak = [Peak Season Revenue Share]
		VAR _peakDays = [Peak Season Day Share]
		RETURN
		IF(ISBLANK(_d),
		    FORMAT(_peakDays, "0%") & " of the days brought " & FORMAT(_peak, "0%") & " of the revenue.",
		    "Revenue " & IF(_d >= 0, "grew ", "fell ") & FORMAT(ABS(_d), "0%") & " " & [PP Label] & ", and " & _ch &
		    " carried " & FORMAT(_sh, "0%") & " of it.")
	// [Pages\02 Acquisition] — Share of selected sessions for channel, device or source/medium rows.
	MEASURE '_Measures'[Session Share] =
		DIVIDE([Sessions], CALCULATE([Sessions], ALLSELECTED('Channel'), ALLSELECTED('Device'), ALLSELECTED('Sessions'[session_source], 'Sessions'[session_medium], 'Sessions'[session_campaign])))
	// [Pages\02 Acquisition]
	MEASURE '_Measures'[Revenue Share] =
		DIVIDE([Revenue], CALCULATE([Revenue], ALLSELECTED('Channel'), ALLSELECTED('Device'), ALLSELECTED('Sessions'[session_source], 'Sessions'[session_medium], 'Sessions'[session_campaign])))
	// [Pages\02 Acquisition] — Revenue share ÷ session share. Above 1× the row earns more than the traffic it brings.
	MEASURE '_Measures'[Revenue Index] =
		DIVIDE([Revenue Share], [Session Share])
	// [Pages\02 Acquisition] (hidden)
	MEASURE '_Measures'[Site Conversion Rate] =
		CALCULATE([Conversion Rate], ALLSELECTED('Channel'), ALLSELECTED('Device'), ALLSELECTED('Sessions'[session_source], 'Sessions'[session_medium], 'Sessions'[session_campaign]))
	// [Pages\02 Acquisition] — Conversion rate gap to the selection average, in percentage points.
	MEASURE '_Measures'[Conversion vs Site] =
		([Conversion Rate] - [Site Conversion Rate]) * 100
	// [Pages\02 Acquisition]
	MEASURE '_Measures'[Channel Revenue Rank] =
		IF(ISINSCOPE('Channel'[channel_group]), RANKX(ALLSELECTED('Channel'[channel_group]), [Revenue]))
	// [Pages\02 Acquisition] — Revenue attributed to the store's own domain as a referrer — an attribution leak (cross-domain/checkout redirect), not a real partner.
	MEASURE '_Measures'[Self-Referral Revenue] =
		CALCULATE([Revenue], 'Sessions'[session_source] = "shop.googlemerchandisestore.com")
	// [Pages\02 Acquisition]
	MEASURE '_Measures'[Self-Referral Revenue Share] =
		DIVIDE([Self-Referral Revenue], [Revenue])
	// [Pages\02 Acquisition]
	MEASURE '_Measures'[Self-Referral Sessions] =
		CALCULATE([Sessions], 'Sessions'[session_source] = "shop.googlemerchandisestore.com")
	// [Pages\02 Acquisition]
	MEASURE '_Measures'[02 Headline] =
		VAR _t = ADDCOLUMNS(ALLSELECTED('Channel'[channel_group]), "@s", [Sessions], "@r", [Revenue])
		VAR _ts = CALCULATE([Sessions], ALLSELECTED('Channel'))
		VAR _tr = CALCULATE([Revenue], ALLSELECTED('Channel'))
		VAR _vol = MAXX(TOPN(1, _t, [@s], DESC), 'Channel'[channel_group])
		VAR _volS = DIVIDE(MAXX(TOPN(1, _t, [@s], DESC), [@s]), _ts)
		VAR _volR = DIVIDE(MAXX(TOPN(1, _t, [@s], DESC), [@r]), _tr)
		VAR _rev = MAXX(TOPN(1, _t, [@r], DESC), 'Channel'[channel_group])
		VAR _revR = DIVIDE(MAXX(TOPN(1, _t, [@r], DESC), [@r]), _tr)
		RETURN
		IF(_vol = _rev,
		    _vol & " leads both traffic (" & FORMAT(_volS, "0%") & ") and revenue (" & FORMAT(_revR, "0%") & ").",
		    _vol & " brings " & FORMAT(_volS, "0%") & " of sessions but " & FORMAT(_volR, "0%") & " of revenue; " &
		    _rev & " earns " & FORMAT(_revR, "0%") & ".")
	// [Pages\03 Content]
	MEASURE '_Measures'[Entrances] =
		SUM('Page Sessions'[entrances])
	// [Pages\03 Content]
	MEASURE '_Measures'[Exits] =
		SUM('Page Sessions'[exits])
	// [Pages\03 Content] — Exits ÷ pageviews of the page.
	MEASURE '_Measures'[Exit Rate] =
		DIVIDE([Exits], [Pageviews])
	// [Pages\03 Content] — Sessions that viewed the page (date × URL grain; not additive across pages).
	MEASURE '_Measures'[Page Sessions] =
		SUM('Page Sessions'[sessions])
	// [Pages\03 Content] — Session-weighted average of avg_engagement_time_sec (never a plain AVERAGE of the averages).
	MEASURE '_Measures'[Page Avg Engagement Time (sec)] =
		DIVIDE(SUMX('Page Sessions', 'Page Sessions'[sessions] * 'Page Sessions'[avg_engagement_time_sec]), [Page Sessions])
	// [Pages\03 Content]
	MEASURE '_Measures'[Landing Session Share] =
		DIVIDE([Sessions], CALCULATE([Sessions], ALLSELECTED('Page Type')))
	// [Pages\03 Content]
	MEASURE '_Measures'[Landing Revenue Share] =
		DIVIDE([Revenue], CALCULATE([Revenue], ALLSELECTED('Page Type')))
	// [Pages\03 Content] — Landing page revenue per session ÷ selection average.
	MEASURE '_Measures'[Landing RPS Index] =
		DIVIDE([Revenue per Session], CALCULATE([Revenue per Session], ALLSELECTED('Page Type')))
	// [Pages\03 Content] — Earner = high traffic and above-average revenue per session; Attractor = high traffic, below-average yield; Hidden gem = small but above-average yield. High traffic = at least 2% of landing sessions.
	MEASURE '_Measures'[Landing Page Role] =
		VAR _sh = [Landing Session Share]
		VAR _ix = [Landing RPS Index]
		RETURN
		SWITCH(TRUE(),
		    ISBLANK([Sessions]), BLANK(),
		    _sh >= 0.02 && _ix >= 1, "Earner",
		    _sh >= 0.02, "Attractor",
		    _ix >= 1, "Hidden gem",
		    "Long tail")
	// [Pages\03 Content]
	MEASURE '_Measures'[Home Session Share] =
		DIVIDE(CALCULATE([Sessions], 'Page Type'[page_type] = "home"), CALCULATE([Sessions], ALLSELECTED('Page Type')))
	// [Pages\03 Content]
	MEASURE '_Measures'[Home Revenue Share] =
		DIVIDE(CALCULATE([Revenue], 'Page Type'[page_type] = "home"), CALCULATE([Revenue], ALLSELECTED('Page Type')))
	// [Pages\03 Content] — Story headline for page 3: the home page's weight, then the biggest attractor (high traffic, low yield).
	MEASURE '_Measures'[03 Headline] =
		VAR _t = FILTER(ADDCOLUMNS(ALLSELECTED('Page Type'[page_path]), "@s", [Sessions], "@rps", [Revenue per Session]), [@s] > 0)
		VAR _site = CALCULATE([Revenue per Session], ALLSELECTED('Page Type'))
		VAR _big = FILTER(_t, DIVIDE([@s], SUMX(_t, [@s])) >= 0.02 && [@rps] < _site)
		VAR _top = TOPN(1, _big, [@s], DESC)
		VAR _path = MAXX(_top, 'Page Type'[page_path])
		VAR _name = SUBSTITUTE(PATHITEMREVERSE(SUBSTITUTE(_path, "/", "|"), 1), "+", " ")
		VAR _s = MAXX(_top, [@s])
		VAR _ix = DIVIDE(MAXX(_top, [@rps]), _site)
		RETURN
		"Home lands " & FORMAT([Home Session Share], "0%") & " of sessions and " & FORMAT([Home Revenue Share], "0%") & " of revenue" &
		IF(NOT ISBLANK(_path), "; " & _name & " pulls " & FORMAT(_s / 1000, "0.0") & "K sessions at " & FORMAT(_ix, "0.00") & "× the average yield.", ".")
	// [Pages\04 Funnel] (hidden) — The GA4 sample has almost no add_to_cart events before 2020-11-25 (0 on most days, a short burst on Nov 16-19). Every rate that uses the cart step is computed from this date on.
	MEASURE '_Measures'[Cart Tracking Start] =
		DATE(2020, 11, 25)
	// [Pages\04 Funnel] REVISED — REVISED. Add to Cart Sessions / View Item Sessions on days with add_to_cart tracking (from Cart Tracking Start).
	MEASURE '_Measures'[View Item to Cart Rate] =
		CALCULATE(DIVIDE([Add to Cart Sessions], [View Item Sessions]), KEEPFILTERS(DATESBETWEEN('Date'[date], [Cart Tracking Start], BLANK())))
	// [Pages\04 Funnel] REVISED — REVISED. Begin Checkout Sessions / Add to Cart Sessions on days with add_to_cart tracking.
	MEASURE '_Measures'[Cart to Checkout Rate] =
		CALCULATE(DIVIDE([Begin Checkout Sessions], [Add to Cart Sessions]), KEEPFILTERS(DATESBETWEEN('Date'[date], [Cart Tracking Start], BLANK())))
	// [Pages\04 Funnel] — Footnote shown under the funnel when the selection starts before cart tracking.
	MEASURE '_Measures'[Cart Window Note] =
		IF([Period Start] < [Cart Tracking Start],
		    "Cart step measured from " & FORMAT([Cart Tracking Start], "mmm d") & " (add_to_cart not tracked earlier).")
	// [Pages\04 Funnel] — Share of sessions that viewed a product. Note: Page Type filters reach Sessions but not Funnel Daily.
	MEASURE '_Measures'[Session to View Item Rate] =
		DIVIDE([View Item Sessions], [Sessions])
	// [Pages\04 Funnel] — Share of add-to-cart sessions that did not purchase, on days with add_to_cart tracking.
	MEASURE '_Measures'[Cart Abandonment Rate] =
		CALCULATE(1 - DIVIDE([Purchase Sessions], [Add to Cart Sessions]), KEEPFILTERS(DATESBETWEEN('Date'[date], [Cart Tracking Start], BLANK())))
	// [Pages\04 Funnel]
	MEASURE '_Measures'[Checkout Abandonment Rate] =
		1 - DIVIDE([Purchase Sessions], [Begin Checkout Sessions])
	// [Pages\04 Funnel]
	MEASURE '_Measures'[Lost at View to Cart] =
		[View Item Sessions] - [Add to Cart Sessions]
	// [Pages\04 Funnel]
	MEASURE '_Measures'[Lost at Cart to Checkout] =
		[Add to Cart Sessions] - [Begin Checkout Sessions]
	// [Pages\04 Funnel]
	MEASURE '_Measures'[Lost at Checkout to Payment] =
		[Begin Checkout Sessions] - [Add Payment Info Sessions]
	// [Pages\04 Funnel]
	MEASURE '_Measures'[Lost at Payment to Purchase] =
		[Add Payment Info Sessions] - [Purchase Sessions]
	// [Pages\04 Funnel] — Step with the lowest step-to-step rate.
	MEASURE '_Measures'[Biggest Drop Step] =
		VAR _t = {
		    ("View item → Add to cart", [View Item to Cart Rate]),
		    ("Add to cart → Checkout", [Cart to Checkout Rate]),
		    ("Checkout → Payment", [Checkout to Payment Rate]),
		    ("Payment → Purchase", [Payment to Purchase Rate]) }
		RETURN CONCATENATEX(TOPN(1, _t, [Value2], ASC), [Value1], "")
	// [Pages\04 Funnel]
	MEASURE '_Measures'[04 Headline] =
		VAR _vi = [View Item Sessions]
		VAR _ps = [Purchase Sessions]
		VAR _step = [Biggest Drop Step]
		VAR _rate = MINX({[View Item to Cart Rate], [Cart to Checkout Rate], [Checkout to Payment Rate], [Payment to Purchase Rate]}, [Value])
		RETURN
		"Of every 100 product viewers, " & FORMAT(DIVIDE(_ps, _vi) * 100, "0.0") & " buy. The leak is " & _step &
		": only " & FORMAT(_rate, "0%") & " move on."
	// [Pages\05 Products] — Purchased item quantity.
	MEASURE '_Measures'[Units Purchased] =
		SUM('Items Daily'[purchases])
	// [Pages\05 Products] — Item rows in begin_checkout events (fully unnested). Rows, not quantity.
	MEASURE '_Measures'[Checkout Item Rows] =
		SUM('Items Daily'[checkouts])
	// [Pages\05 Products]
	MEASURE '_Measures'[Avg Item Price] =
		DIVIDE([Item Revenue], [Units Purchased])
	// [Pages\05 Products]
	MEASURE '_Measures'[Items Sold] =
		CALCULATE(DISTINCTCOUNT('Items Daily'[item_id]), 'Items Daily'[purchases] > 0)
	// [Pages\05 Products]
	MEASURE '_Measures'[Item Revenue Share] =
		DIVIDE([Item Revenue], CALCULATE([Item Revenue], ALLSELECTED('Items Daily'[item_name], 'Items Daily'[item_id], 'Items Daily'[item_category], 'Items Daily'[item_brand])))
	// [Pages\05 Products]
	MEASURE '_Measures'[Item Revenue Rank] =
		IF(ISINSCOPE('Items Daily'[item_name]), RANKX(ALLSELECTED('Items Daily'[item_name]), [Item Revenue]))
	// [Pages\05 Products] — Concentration: share of item revenue from the ten best-selling items.
	MEASURE '_Measures'[Top 10 Item Revenue Share] =
		VAR _t = ADDCOLUMNS(CALCULATETABLE(VALUES('Items Daily'[item_name]), ALLSELECTED('Items Daily'[item_name], 'Items Daily'[item_id], 'Items Daily'[item_category], 'Items Daily'[item_brand])), "@r", CALCULATE([Item Revenue]))
		RETURN DIVIDE(SUMX(TOPN(10, _t, [@r], DESC), [@r]), SUMX(_t, [@r]))
	// [Pages\05 Products] — Pareto: how many items (best first) it takes to reach 50% of item revenue.
	MEASURE '_Measures'[Items for Half of Revenue] =
		VAR _t = ADDCOLUMNS(VALUES('Items Daily'[item_name]), "@r", CALCULATE([Item Revenue]))
		VAR _tot = SUMX(_t, [@r])
		VAR _ranked = ADDCOLUMNS(_t, "@cum", VAR _me = [@r] RETURN SUMX(FILTER(_t, [@r] >= _me), [@r]))
		RETURN COUNTROWS(FILTER(_ranked, [@cum] - [@r] < _tot / 2))
	// [Pages\05 Products]
	MEASURE '_Measures'[Top Item] =
		VAR _t = ADDCOLUMNS(VALUES('Items Daily'[item_name]), "@r", CALCULATE([Item Revenue]))
		RETURN MAXX(TOPN(1, _t, [@r], DESC), 'Items Daily'[item_name])
	// [Pages\05 Products]
	MEASURE '_Measures'[Top Category] =
		VAR _t = ADDCOLUMNS(VALUES('Items Daily'[item_category]), "@r", CALCULATE([Item Revenue]))
		RETURN MAXX(TOPN(1, _t, [@r], DESC), 'Items Daily'[item_category])
	// [Pages\05 Products]
	MEASURE '_Measures'[Top Category Revenue Share] =
		VAR _t = ADDCOLUMNS(VALUES('Items Daily'[item_category]), "@r", CALCULATE([Item Revenue]))
		RETURN DIVIDE(MAXX(_t, [@r]), SUMX(_t, [@r]))
	// [Pages\05 Products] — Data-quality guard for the item funnel; shown as a footnote while the gold fix is pending.
	MEASURE '_Measures'[Item Data Check] =
		IF([Add to Carts] > [Item Views],
		    "Item views are under-counted in gold (add-to-carts exceed views), so item-level view → cart rates are not shown.",
		    BLANK())
	// [Pages\05 Products]
	MEASURE '_Measures'[05 Headline] =
		"Ten items earn " & FORMAT([Top 10 Item Revenue Share], "0%") & " of item revenue; " & [Top Category] &
		" alone is " & FORMAT([Top Category Revenue Share], "0%") & "."
	// [Base\Prior Period] — Sessions in the prior period (see PP Label).
	MEASURE '_Measures'[Sessions PP] =
		VAR _s = [Period Start]
		VAR _e = [Period End]
		VAR _d = [Period Days]
		VAR _full = _s = DATE(YEAR(_s), MONTH(_s), 1) && _e = EOMONTH(_s, 0)
		VAR _ps = IF(_full, EDATE(_s, -1), _s - _d)
		VAR _pe = IF(_full, EOMONTH(_s, -1), _s - 1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_ps >= _min, CALCULATE([Sessions], DATESBETWEEN('Date'[date], _ps, _pe)))
	// [Base\Prior Period]
	MEASURE '_Measures'[Sessions Δ%] =
		VAR _p = [Sessions PP]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Sessions] - _p, _p))
	// [Base\Prior Period] — Users in the prior period (see PP Label).
	MEASURE '_Measures'[Users PP] =
		VAR _s = [Period Start]
		VAR _e = [Period End]
		VAR _d = [Period Days]
		VAR _full = _s = DATE(YEAR(_s), MONTH(_s), 1) && _e = EOMONTH(_s, 0)
		VAR _ps = IF(_full, EDATE(_s, -1), _s - _d)
		VAR _pe = IF(_full, EOMONTH(_s, -1), _s - 1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_ps >= _min, CALCULATE([Users], DATESBETWEEN('Date'[date], _ps, _pe)))
	// [Base\Prior Period]
	MEASURE '_Measures'[Users Δ%] =
		VAR _p = [Users PP]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Users] - _p, _p))
	// [Base\Prior Period] — New Users in the prior period (see PP Label).
	MEASURE '_Measures'[New Users PP] =
		VAR _s = [Period Start]
		VAR _e = [Period End]
		VAR _d = [Period Days]
		VAR _full = _s = DATE(YEAR(_s), MONTH(_s), 1) && _e = EOMONTH(_s, 0)
		VAR _ps = IF(_full, EDATE(_s, -1), _s - _d)
		VAR _pe = IF(_full, EOMONTH(_s, -1), _s - 1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_ps >= _min, CALCULATE([New Users], DATESBETWEEN('Date'[date], _ps, _pe)))
	// [Base\Prior Period]
	MEASURE '_Measures'[New Users Δ%] =
		VAR _p = [New Users PP]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([New Users] - _p, _p))
	// [Base\Prior Period] — Revenue in the prior period (see PP Label).
	MEASURE '_Measures'[Revenue PP] =
		VAR _s = [Period Start]
		VAR _e = [Period End]
		VAR _d = [Period Days]
		VAR _full = _s = DATE(YEAR(_s), MONTH(_s), 1) && _e = EOMONTH(_s, 0)
		VAR _ps = IF(_full, EDATE(_s, -1), _s - _d)
		VAR _pe = IF(_full, EOMONTH(_s, -1), _s - 1)
