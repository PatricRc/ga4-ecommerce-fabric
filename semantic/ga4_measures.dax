		const DAYS = D.day.filter(r => r.date).map(tag0), CHD = D.ch_day.filter(r => r.date).map(tag0), DVD = D.dev_day.filter(r => r.date).map(tag0);
		const DAYMAP = Object.fromEntries(DAYS.map(r => [r.d, r]));
