		RETURN IF(NOT ISBLANK(_p), DIVIDE([Transactions] - _p, _p))
	// [Base\Prior Period] — Conversion Rate in the prior period (see PP Label).
	MEASURE '_Measures'[Conversion Rate PP] =
		VAR _s = [Period Start]
		VAR _e = [Period End]
		VAR _d = [Period Days]
		VAR _full = _s = DATE(YEAR(_s), MONTH(_s), 1) && _e = EOMONTH(_s, 0)
		VAR _ps = IF(_full, EDATE(_s, -1), _s - _d)
		VAR _pe = IF(_full, EOMONTH(_s, -1), _s - 1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_ps >= _min, CALCULATE([Conversion Rate], DATESBETWEEN('Date'[date], _ps, _pe)))
	// [Base\Prior Period]
	MEASURE '_Measures'[Conversion Rate Δ pts] =
		VAR _p = [Conversion Rate PP]
		RETURN IF(NOT ISBLANK(_p), ([Conversion Rate] - _p) * 100)
	// [Base\Prior Period] — AOV in the prior period (see PP Label).
	MEASURE '_Measures'[AOV PP] =
		VAR _s = [Period Start]
		VAR _e = [Period End]
		VAR _d = [Period Days]
		VAR _full = _s = DATE(YEAR(_s), MONTH(_s), 1) && _e = EOMONTH(_s, 0)
		VAR _ps = IF(_full, EDATE(_s, -1), _s - _d)
		VAR _pe = IF(_full, EOMONTH(_s, -1), _s - 1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_ps >= _min, CALCULATE([AOV], DATESBETWEEN('Date'[date], _ps, _pe)))
	// [Base\Prior Period]
	MEASURE '_Measures'[AOV Δ%] =
		VAR _p = [AOV PP]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([AOV] - _p, _p))
	// [Base\Prior Period] — Revenue per Session in the prior period (see PP Label).
	MEASURE '_Measures'[Revenue per Session PP] =
		VAR _s = [Period Start]
		VAR _e = [Period End]
		VAR _d = [Period Days]
		VAR _full = _s = DATE(YEAR(_s), MONTH(_s), 1) && _e = EOMONTH(_s, 0)
		VAR _ps = IF(_full, EDATE(_s, -1), _s - _d)
		VAR _pe = IF(_full, EOMONTH(_s, -1), _s - 1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_ps >= _min, CALCULATE([Revenue per Session], DATESBETWEEN('Date'[date], _ps, _pe)))
	// [Base\Prior Period]
	MEASURE '_Measures'[Revenue per Session Δ%] =
