		    'Weekend Revenue Share': dv(we.r, tot.r), 'Weekend Day Share': dv(we.n, tot.n), 'Weekend Conversion Rate': dv(we.cs, we.s), 'Weekday Conversion Rate': dv(wk.cs, wk.s)};
