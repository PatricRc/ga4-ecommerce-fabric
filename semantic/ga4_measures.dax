		    K[n + ' PP'] = b; if (PTS.includes(n)) K[n + ' Δ pts'] = ok ? (a - b) * 100 : null; else K[n + ' Δ%'] = ok && b ? (a - b) / b : null; }
		  K['Period Label'] = rangeLabel(s, e); K['PP Label'] = ppLabel(s, e, pr);
