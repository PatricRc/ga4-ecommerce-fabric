		RETURN IF(NOT ISBLANK(_p), DIVIDE([Revenue per Session] - _p, _p))
	// [Base\Prior Period] — Engagement Rate in the prior period (see PP Label).
	MEASURE '_Measures'[Engagement Rate PP] =
		VAR _s = [Period Start]
		VAR _e = [Period End]
		VAR _d = [Period Days]
		VAR _full = _s = DATE(YEAR(_s), MONTH(_s), 1) && _e = EOMONTH(_s, 0)
		VAR _ps = IF(_full, EDATE(_s, -1), _s - _d)
		VAR _pe = IF(_full, EOMONTH(_s, -1), _s - 1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_ps >= _min, CALCULATE([Engagement Rate], DATESBETWEEN('Date'[date], _ps, _pe)))
	// [Base\Prior Period]
	MEASURE '_Measures'[Engagement Rate Δ pts] =
		VAR _p = [Engagement Rate PP]
		RETURN IF(NOT ISBLANK(_p), ([Engagement Rate] - _p) * 100)
	// [Base\Prior Period] — Pageviews in the prior period (see PP Label).
	MEASURE '_Measures'[Pageviews PP] =
		VAR _s = [Period Start]
		VAR _e = [Period End]
		VAR _d = [Period Days]
		VAR _full = _s = DATE(YEAR(_s), MONTH(_s), 1) && _e = EOMONTH(_s, 0)
		VAR _ps = IF(_full, EDATE(_s, -1), _s - _d)
		VAR _pe = IF(_full, EOMONTH(_s, -1), _s - 1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_ps >= _min, CALCULATE([Pageviews], DATESBETWEEN('Date'[date], _ps, _pe)))
	// [Base\Prior Period]
	MEASURE '_Measures'[Pageviews Δ%] =
		VAR _p = [Pageviews PP]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Pageviews] - _p, _p))
	// [Base\Prior Period] — Pages per Session in the prior period (see PP Label).
	MEASURE '_Measures'[Pages per Session PP] =
		VAR _s = [Period Start]
		VAR _e = [Period End]
		VAR _d = [Period Days]
		VAR _full = _s = DATE(YEAR(_s), MONTH(_s), 1) && _e = EOMONTH(_s, 0)
		VAR _ps = IF(_full, EDATE(_s, -1), _s - _d)
		VAR _pe = IF(_full, EOMONTH(_s, -1), _s - 1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_ps >= _min, CALCULATE([Pages per Session], DATESBETWEEN('Date'[date], _ps, _pe)))
	// [Base\Prior Period]
	MEASURE '_Measures'[Pages per Session Δ%] =
		VAR _p = [Pages per Session PP]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Pages per Session] - _p, _p))
	// [Base\Prior Period] — Avg Engagement Time (sec) in the prior period (see PP Label).
	MEASURE '_Measures'[Avg Engagement Time (sec) PP] =
		VAR _s = [Period Start]
		VAR _e = [Period End]
		VAR _d = [Period Days]
		VAR _full = _s = DATE(YEAR(_s), MONTH(_s), 1) && _e = EOMONTH(_s, 0)
		VAR _ps = IF(_full, EDATE(_s, -1), _s - _d)
		VAR _pe = IF(_full, EOMONTH(_s, -1), _s - 1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_ps >= _min, CALCULATE([Avg Engagement Time (sec)], DATESBETWEEN('Date'[date], _ps, _pe)))
	// [Base\Prior Period]
	MEASURE '_Measures'[Avg Engagement Time (sec) Δ%] =
		VAR _p = [Avg Engagement Time (sec) PP]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Avg Engagement Time (sec)] - _p, _p))
	// [Base\Prior Period] — View Item Sessions in the prior period (see PP Label).
	MEASURE '_Measures'[View Item Sessions PP] =
		VAR _s = [Period Start]
		VAR _e = [Period End]
		VAR _d = [Period Days]
		VAR _full = _s = DATE(YEAR(_s), MONTH(_s), 1) && _e = EOMONTH(_s, 0)
		VAR _ps = IF(_full, EDATE(_s, -1), _s - _d)
		VAR _pe = IF(_full, EOMONTH(_s, -1), _s - 1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_ps >= _min, CALCULATE([View Item Sessions], DATESBETWEEN('Date'[date], _ps, _pe)))
	// [Base\Prior Period]
	MEASURE '_Measures'[View Item Sessions Δ%] =
		VAR _p = [View Item Sessions PP]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([View Item Sessions] - _p, _p))
	// [Base\Prior Period] — Begin Checkout Sessions in the prior period (see PP Label).
	MEASURE '_Measures'[Begin Checkout Sessions PP] =
		VAR _s = [Period Start]
		VAR _e = [Period End]
		VAR _d = [Period Days]
		VAR _full = _s = DATE(YEAR(_s), MONTH(_s), 1) && _e = EOMONTH(_s, 0)
		VAR _ps = IF(_full, EDATE(_s, -1), _s - _d)
		VAR _pe = IF(_full, EOMONTH(_s, -1), _s - 1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_ps >= _min, CALCULATE([Begin Checkout Sessions], DATESBETWEEN('Date'[date], _ps, _pe)))
	// [Base\Prior Period]
	MEASURE '_Measures'[Begin Checkout Sessions Δ%] =
