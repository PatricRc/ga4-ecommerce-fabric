		  const a7 = addD(e, -6) >= DAY0 ? l7.r / 7 : null, a28 = addD(e, -27) >= DAY0 ? agg(addD(e, -27), e).r / 28 : null;
		  const wd = weekdayRows(s, e), best = wd.slice().sort((a,b) => b.adr - a.adr)[0], worst = wd.slice().sort((a,b) => a.adr - b.adr)[0];
