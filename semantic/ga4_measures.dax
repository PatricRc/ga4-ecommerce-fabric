		RETURN IF(_ps >= _min, CALCULATE([Revenue], DATESBETWEEN('Date'[date], _ps, _pe)))
	// [Base\Prior Period]
	MEASURE '_Measures'[Revenue Δ%] =
		VAR _p = [Revenue PP]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Revenue] - _p, _p))
	// [Base\Prior Period] — Transactions in the prior period (see PP Label).
	MEASURE '_Measures'[Transactions PP] =
		VAR _s = [Period Start]
		VAR _e = [Period End]
		VAR _d = [Period Days]
		VAR _full = _s = DATE(YEAR(_s), MONTH(_s), 1) && _e = EOMONTH(_s, 0)
		VAR _ps = IF(_full, EDATE(_s, -1), _s - _d)
		VAR _pe = IF(_full, EOMONTH(_s, -1), _s - 1)
