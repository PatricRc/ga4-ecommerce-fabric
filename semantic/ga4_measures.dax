		RETURN IF(NOT ISBLANK(_p), DIVIDE([Begin Checkout Sessions] - _p, _p))
	// [Base\Prior Period] — Purchase Sessions in the prior period (see PP Label).
	MEASURE '_Measures'[Purchase Sessions PP] =
		VAR _s = [Period Start]
		VAR _e = [Period End]
		VAR _d = [Period Days]
		VAR _full = _s = DATE(YEAR(_s), MONTH(_s), 1) && _e = EOMONTH(_s, 0)
		VAR _ps = IF(_full, EDATE(_s, -1), _s - _d)
		VAR _pe = IF(_full, EOMONTH(_s, -1), _s - 1)
