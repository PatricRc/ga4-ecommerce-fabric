		    const p = addD(a, -7) >= DAY0 ? agg(addD(a, -7), addD(b, -7)) : null;
		    return {week_start: ws + 'T00:00:00', days: rows.length, r: o.r, s: o.s, cr: o.cr, tx: o.tx, wr: p && p.r ? (o.r - p.r) / p.r : null, ws: p && p.s ? (o.s - p.s) / p.s : null}; });
