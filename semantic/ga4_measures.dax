// GA4 Ecommerce · report measures (generated by semantic/ga4_measures.py — do not edit by hand)
// Base measures already in the model are referenced, not redefined (except REVISED ones).
DEFINE
	// [Base\Core] — Distinct purchase transactions (transaction_id). 5,281 vs 5,692 purchase events: some transactions fire purchase twice.
	MEASURE '_Measures'[Transactions] =
		SUM('Sessions'[transactions])
	// [Base\Core] REVISED — REVISED. Average order value = Revenue / Transactions. The deployed version divides by purchase events, which double-counts duplicated purchase hits and understates AOV ($63.63 vs $68.58).
	MEASURE '_Measures'[AOV] =
		DIVIDE([Revenue], [Transactions])
	// [Base\Core] (hidden) — The previous AOV definition, kept for reconciliation only.
	MEASURE '_Measures'[Revenue per Purchase Event] =
		DIVIDE([Revenue], [Purchases])
	// [Base\Core] — Sessions with at least one purchase; numerator of Conversion Rate.
	MEASURE '_Measures'[Converting Sessions] =
		CALCULATE([Sessions], 'Sessions'[purchases] > 0)
	// [Base\Core] — Distinct users with a session that is not their first.
	MEASURE '_Measures'[Returning Users] =
		CALCULATE(DISTINCTCOUNT('Sessions'[user_pseudo_id]), 'Sessions'[is_new_user] = FALSE())
	// [Base\Core]
	MEASURE '_Measures'[New User Share] =
		DIVIDE([New Users], [Users])
	// [Base\Core]
	MEASURE '_Measures'[Pages per Session] =
		DIVIDE(SUM('Sessions'[pageviews]), [Sessions])
	// [Base\Core] — Mean engaged seconds per session (sum of engagement_time_msec / 1000).
	MEASURE '_Measures'[Avg Engagement Time (sec)] =
		AVERAGE('Sessions'[engagement_time_sec])
	// [Base\Core] — Text, e.g. 1m 10s.
	MEASURE '_Measures'[Avg Engagement Time] =
		VAR _s = [Avg Engagement Time (sec)]
		RETURN IF(ISBLANK(_s), BLANK(), FORMAT(INT(_s / 60), "0") & "m " & FORMAT(MOD(INT(_s), 60), "00") & "s")
	// [Base\Core] — Share of sessions whose source/medium came from session event params (the rest fall back to first-touch traffic_source).
	MEASURE '_Measures'[Event Param Attribution Share] =
		DIVIDE(CALCULATE([Sessions], 'Sessions'[attribution_source] = "event_params"), [Sessions])
	// [Base\Time] (hidden)
	MEASURE '_Measures'[Period Start] =
		MIN('Date'[date])
	// [Base\Time] (hidden)
	MEASURE '_Measures'[Period End] =
		MAX('Date'[date])
	// [Base\Time] (hidden)
	MEASURE '_Measures'[Period Days] =
		INT([Period End] - [Period Start]) + 1
	// [Base\Time] — Selected window as text: 'December 2020', 'Nov 1 – Nov 30, 2020'.
	MEASURE '_Measures'[Period Label] =
		VAR _s = [Period Start]
		VAR _e = [Period End]
		RETURN
		SWITCH(TRUE(),
		    ISBLANK(_s), BLANK(),
		    _s = DATE(YEAR(_s), MONTH(_s), 1) && _e = EOMONTH(_s, 0), FORMAT(_s, "mmmm yyyy"),
		    YEAR(_s) = YEAR(_e), FORMAT(_s, "mmm d") & " – " & FORMAT(_e, "mmm d, yyyy"),
		    FORMAT(_s, "mmm d, yyyy") & " – " & FORMAT(_e, "mmm d, yyyy"))
	// [Base\Time] (hidden)
	MEASURE '_Measures'[PP Start] =
		VAR _s = [Period Start]
		VAR _e = [Period End]
		VAR _d = [Period Days]
		VAR _full = _s = DATE(YEAR(_s), MONTH(_s), 1) && _e = EOMONTH(_s, 0)
		VAR _ps = IF(_full, EDATE(_s, -1), _s - _d)
		VAR _pe = IF(_full, EOMONTH(_s, -1), _s - 1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_ps >= _min, _ps)
	// [Base\Time] (hidden)
	MEASURE '_Measures'[PP End] =
		VAR _s = [Period Start]
		VAR _e = [Period End]
		VAR _d = [Period Days]
		VAR _full = _s = DATE(YEAR(_s), MONTH(_s), 1) && _e = EOMONTH(_s, 0)
		VAR _ps = IF(_full, EDATE(_s, -1), _s - _d)
		VAR _pe = IF(_full, EOMONTH(_s, -1), _s - 1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_ps >= _min, _pe)
	// [Base\Time] — Comparison label used under every KPI: 'vs Nov 2020' or 'vs prior 14 days'.
	MEASURE '_Measures'[PP Label] =
		VAR _ps = [PP Start]
		VAR _pe = [PP End]
		RETURN
		SWITCH(TRUE(),
		    ISBLANK(_ps), "no earlier period in data",
		    _ps = DATE(YEAR(_ps), MONTH(_ps), 1) && _pe = EOMONTH(_ps, 0), "vs " & FORMAT(_ps, "mmm yyyy"),
		    "vs prior " & FORMAT(INT(_pe - _ps) + 1, "0") & " days")
	// [Base\Time] — Sessions in the 7 days ending on the last selected day.
	MEASURE '_Measures'[Sessions L7D] =
		VAR _e = [Period End]
		RETURN CALCULATE([Sessions], DATESBETWEEN('Date'[date], _e - 6, _e))
	// [Base\Time]
	MEASURE '_Measures'[Sessions P7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 13 >= _min, CALCULATE([Sessions], DATESBETWEEN('Date'[date], _e - 13, _e - 7)))
	// [Base\Time]
	MEASURE '_Measures'[Sessions WoW %] =
		VAR _p = [Sessions P7D]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Sessions L7D] - _p, _p))
	// [Base\Time] — Revenue in the 7 days ending on the last selected day.
	MEASURE '_Measures'[Revenue L7D] =
		VAR _e = [Period End]
		RETURN CALCULATE([Revenue], DATESBETWEEN('Date'[date], _e - 6, _e))
	// [Base\Time]
	MEASURE '_Measures'[Revenue P7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 13 >= _min, CALCULATE([Revenue], DATESBETWEEN('Date'[date], _e - 13, _e - 7)))
	// [Base\Time]
	MEASURE '_Measures'[Revenue WoW %] =
		VAR _p = [Revenue P7D]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Revenue L7D] - _p, _p))
	// [Base\Time]
	MEASURE '_Measures'[Daily Avg Sessions] =
		DIVIDE([Sessions], [Period Days])
	// [Base\Time]
	MEASURE '_Measures'[Daily Avg Revenue] =
		DIVIDE([Revenue], [Period Days])
	// [Base\Time\Rolling Windows]
	MEASURE '_Measures'[Sessions L7D Δ%] =
		VAR _p = [Sessions P7D]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Sessions L7D] - _p, _p))
	// [Base\Time\Rolling Windows] — Engaged Sessions in the 7 days ending on the last selected day.
	MEASURE '_Measures'[Engaged Sessions L7D] =
		VAR _e = [Period End]
		RETURN CALCULATE([Engaged Sessions], DATESBETWEEN('Date'[date], _e - 6, _e))
	// [Base\Time\Rolling Windows] — Engaged Sessions in the 7 days before the last 7 days (blank when that falls before Nov 1).
	MEASURE '_Measures'[Engaged Sessions P7D] =
		VAR _e = [Period End]
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 13 >= _min, CALCULATE([Engaged Sessions], DATESBETWEEN('Date'[date], _e - 13, _e - 7)))
	// [Base\Time\Rolling Windows]
	MEASURE '_Measures'[Engaged Sessions L7D Δ%] =
		VAR _p = [Engaged Sessions P7D]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Engaged Sessions L7D] - _p, _p))
	// [Base\Time\Rolling Windows] — Pageviews in the 7 days ending on the last selected day.
	MEASURE '_Measures'[Pageviews L7D] =
		VAR _e = [Period End]
