		RETURN IF(_e - 13 >= _min, CALCULATE([Pageviews], DATESBETWEEN('Date'[date], _e - 13, _e - 7)))
	// [Base\Time\Rolling Windows]
	MEASURE '_Measures'[Pageviews L7D Δ%] =
		VAR _p = [Pageviews P7D]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Pageviews L7D] - _p, _p))
	// [Base\Time\Rolling Windows] — Transactions in the 7 days ending on the last selected day.
	MEASURE '_Measures'[Transactions L7D] =
		VAR _e = [Period End]
		RETURN CALCULATE([Transactions], DATESBETWEEN('Date'[date], _e - 6, _e))
	// [Base\Time\Rolling Windows] — Transactions in the 7 days before the last 7 days (blank when that falls before Nov 1).
	MEASURE '_Measures'[Transactions P7D] =
		VAR _e = [Period End]
