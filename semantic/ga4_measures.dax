		RETURN IF(_ps >= _min, CALCULATE([Purchase Sessions], DATESBETWEEN('Date'[date], _ps, _pe)))
	// [Base\Prior Period]
	MEASURE '_Measures'[Purchase Sessions Δ%] =
		VAR _p = [Purchase Sessions PP]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Purchase Sessions] - _p, _p))
	// [Base\Prior Period] — View Item to Purchase Rate in the prior period (see PP Label).
	MEASURE '_Measures'[View Item to Purchase Rate PP] =
		VAR _s = [Period Start]
		VAR _e = [Period End]
		VAR _d = [Period Days]
		VAR _full = _s = DATE(YEAR(_s), MONTH(_s), 1) && _e = EOMONTH(_s, 0)
		VAR _ps = IF(_full, EDATE(_s, -1), _s - _d)
		VAR _pe = IF(_full, EOMONTH(_s, -1), _s - 1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_ps >= _min, CALCULATE([View Item to Purchase Rate], DATESBETWEEN('Date'[date], _ps, _pe)))
	// [Base\Prior Period]
	MEASURE '_Measures'[View Item to Purchase Rate Δ pts] =
		VAR _p = [View Item to Purchase Rate PP]
		RETURN IF(NOT ISBLANK(_p), ([View Item to Purchase Rate] - _p) * 100)
	// [Base\Prior Period] — Cart Abandonment Rate in the prior period (see PP Label).
	MEASURE '_Measures'[Cart Abandonment Rate PP] =
		VAR _s = [Period Start]
		VAR _e = [Period End]
		VAR _d = [Period Days]
		VAR _full = _s = DATE(YEAR(_s), MONTH(_s), 1) && _e = EOMONTH(_s, 0)
		VAR _ps = IF(_full, EDATE(_s, -1), _s - _d)
		VAR _pe = IF(_full, EOMONTH(_s, -1), _s - 1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_ps >= _min, CALCULATE([Cart Abandonment Rate], DATESBETWEEN('Date'[date], _ps, _pe)))
	// [Base\Prior Period]
	MEASURE '_Measures'[Cart Abandonment Rate Δ pts] =
		VAR _p = [Cart Abandonment Rate PP]
		RETURN IF(NOT ISBLANK(_p), ([Cart Abandonment Rate] - _p) * 100)
	// [Base\Prior Period] — Item Revenue in the prior period (see PP Label).
	MEASURE '_Measures'[Item Revenue PP] =
		VAR _s = [Period Start]
		VAR _e = [Period End]
		VAR _d = [Period Days]
		VAR _full = _s = DATE(YEAR(_s), MONTH(_s), 1) && _e = EOMONTH(_s, 0)
		VAR _ps = IF(_full, EDATE(_s, -1), _s - _d)
		VAR _pe = IF(_full, EOMONTH(_s, -1), _s - 1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_ps >= _min, CALCULATE([Item Revenue], DATESBETWEEN('Date'[date], _ps, _pe)))
	// [Base\Prior Period]
	MEASURE '_Measures'[Item Revenue Δ%] =
		VAR _p = [Item Revenue PP]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Item Revenue] - _p, _p))
	// [Base\Prior Period] — Units Purchased in the prior period (see PP Label).
	MEASURE '_Measures'[Units Purchased PP] =
		VAR _s = [Period Start]
		VAR _e = [Period End]
		VAR _d = [Period Days]
		VAR _full = _s = DATE(YEAR(_s), MONTH(_s), 1) && _e = EOMONTH(_s, 0)
		VAR _ps = IF(_full, EDATE(_s, -1), _s - _d)
		VAR _pe = IF(_full, EOMONTH(_s, -1), _s - 1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_ps >= _min, CALCULATE([Units Purchased], DATESBETWEEN('Date'[date], _ps, _pe)))
	// [Base\Prior Period]
	MEASURE '_Measures'[Units Purchased Δ%] =
		VAR _p = [Units Purchased PP]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Units Purchased] - _p, _p))
	// [Base\Prior Period] — Avg Item Price in the prior period (see PP Label).
	MEASURE '_Measures'[Avg Item Price PP] =
		VAR _s = [Period Start]
		VAR _e = [Period End]
		VAR _d = [Period Days]
		VAR _full = _s = DATE(YEAR(_s), MONTH(_s), 1) && _e = EOMONTH(_s, 0)
		VAR _ps = IF(_full, EDATE(_s, -1), _s - _d)
		VAR _pe = IF(_full, EOMONTH(_s, -1), _s - 1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_ps >= _min, CALCULATE([Avg Item Price], DATESBETWEEN('Date'[date], _ps, _pe)))
	// [Base\Prior Period]
	MEASURE '_Measures'[Avg Item Price Δ%] =
		VAR _p = [Avg Item Price PP]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Avg Item Price] - _p, _p))
	// [Base\Prior Period] — Items Sold in the prior period (see PP Label).
	MEASURE '_Measures'[Items Sold PP] =
		VAR _s = [Period Start]
		VAR _e = [Period End]
		VAR _d = [Period Days]
		VAR _full = _s = DATE(YEAR(_s), MONTH(_s), 1) && _e = EOMONTH(_s, 0)
		VAR _ps = IF(_full, EDATE(_s, -1), _s - _d)
		VAR _pe = IF(_full, EOMONTH(_s, -1), _s - 1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_ps >= _min, CALCULATE([Items Sold], DATESBETWEEN('Date'[date], _ps, _pe)))
	// [Base\Prior Period]
	MEASURE '_Measures'[Items Sold Δ%] =
		VAR _p = [Items Sold PP]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Items Sold] - _p, _p))
	// [Base\Prior Period] — Top 10 Item Revenue Share in the prior period (see PP Label).
	MEASURE '_Measures'[Top 10 Item Revenue Share PP] =
		VAR _s = [Period Start]
		VAR _e = [Period End]
		VAR _d = [Period Days]
		VAR _full = _s = DATE(YEAR(_s), MONTH(_s), 1) && _e = EOMONTH(_s, 0)
		VAR _ps = IF(_full, EDATE(_s, -1), _s - _d)
		VAR _pe = IF(_full, EOMONTH(_s, -1), _s - 1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_ps >= _min, CALCULATE([Top 10 Item Revenue Share], DATESBETWEEN('Date'[date], _ps, _pe)))
	// [Base\Prior Period]
	MEASURE '_Measures'[Top 10 Item Revenue Share Δ pts] =
		VAR _p = [Top 10 Item Revenue Share PP]
		RETURN IF(NOT ISBLANK(_p), ([Top 10 Item Revenue Share] - _p) * 100)
	// [Pages\01 Overview] — Header card: page title, story headline and the comparison period (date slicer sits on top, right).
	MEASURE '_Measures'[01 · 000 Headline HTML] =
		VAR _h = SUBSTITUTE(SUBSTITUTE([01 Headline], "&", "&amp;"), "<", "&lt;")
		VAR _c = FORMAT([Period Days], "0") & " days · " & IF(ISBLANK([PP Start]), "no earlier period in data", "compared " & SUBSTITUTE([PP Label], "vs ", "with "))
		RETURN
		"<!DOCTYPE html><html><head><meta charset='utf-8'><link href='https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cormorant+Garamond:ital,wght@1,400&display=swap' rel='stylesheet'><style>*{box-sizing:border-box;margin:0;padding:0}html,body{height:100vh;overflow:hidden;background:transparent;font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:#1A1840}.c{height:100vh;background:#fff;border:1px solid #ECEDF6;border-radius:16px;display:flex;justify-content:space-between;align-items:center;padding:0 22px;gap:24px}.t{display:flex;align-items:center;gap:10px}.n{font-size:10px;font-weight:800;color:#5B5BD6;background:#EEEFFD;border-radius:6px;padding:3px 7px;letter-spacing:.06em}h1{font-size:19px;font-weight:800;letter-spacing:-.3px}p{font-size:12px;line-height:1.5;color:#5E6189;margin-top:5px;max-width:640px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.r{align-self:flex-end;margin-bottom:12px;font-size:10.5px;color:#9A9DC0;white-space:nowrap}</style></head><body><div class='c'><div><div class='t'><span class='n'>01</span><h1>Overview</h1></div><p>" & _h & "</p></div><div class='r'>" & _c & "</div></div></body></html>"
	// [Pages\02 Acquisition] — Header card: page title, story headline and the comparison period (date slicer sits on top, right).
	MEASURE '_Measures'[02 · 000 Headline HTML] =
		VAR _h = SUBSTITUTE(SUBSTITUTE([02 Headline], "&", "&amp;"), "<", "&lt;")
		VAR _c = FORMAT([Period Days], "0") & " days · " & IF(ISBLANK([PP Start]), "no earlier period in data", "compared " & SUBSTITUTE([PP Label], "vs ", "with "))
		RETURN
		"<!DOCTYPE html><html><head><meta charset='utf-8'><link href='https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cormorant+Garamond:ital,wght@1,400&display=swap' rel='stylesheet'><style>*{box-sizing:border-box;margin:0;padding:0}html,body{height:100vh;overflow:hidden;background:transparent;font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:#1A1840}.c{height:100vh;background:#fff;border:1px solid #ECEDF6;border-radius:16px;display:flex;justify-content:space-between;align-items:center;padding:0 22px;gap:24px}.t{display:flex;align-items:center;gap:10px}.n{font-size:10px;font-weight:800;color:#5B5BD6;background:#EEEFFD;border-radius:6px;padding:3px 7px;letter-spacing:.06em}h1{font-size:19px;font-weight:800;letter-spacing:-.3px}p{font-size:12px;line-height:1.5;color:#5E6189;margin-top:5px;max-width:640px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.r{align-self:flex-end;margin-bottom:12px;font-size:10.5px;color:#9A9DC0;white-space:nowrap}</style></head><body><div class='c'><div><div class='t'><span class='n'>02</span><h1>Acquisition</h1></div><p>" & _h & "</p></div><div class='r'>" & _c & "</div></div></body></html>"
	// [Pages\03 Content] — Header card: page title, story headline and the comparison period (date slicer sits on top, right).
	MEASURE '_Measures'[03 · 000 Headline HTML] =
		VAR _h = SUBSTITUTE(SUBSTITUTE([03 Headline], "&", "&amp;"), "<", "&lt;")
		VAR _c = FORMAT([Period Days], "0") & " days · " & IF(ISBLANK([PP Start]), "no earlier period in data", "compared " & SUBSTITUTE([PP Label], "vs ", "with "))
		RETURN
		"<!DOCTYPE html><html><head><meta charset='utf-8'><link href='https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cormorant+Garamond:ital,wght@1,400&display=swap' rel='stylesheet'><style>*{box-sizing:border-box;margin:0;padding:0}html,body{height:100vh;overflow:hidden;background:transparent;font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:#1A1840}.c{height:100vh;background:#fff;border:1px solid #ECEDF6;border-radius:16px;display:flex;justify-content:space-between;align-items:center;padding:0 22px;gap:24px}.t{display:flex;align-items:center;gap:10px}.n{font-size:10px;font-weight:800;color:#5B5BD6;background:#EEEFFD;border-radius:6px;padding:3px 7px;letter-spacing:.06em}h1{font-size:19px;font-weight:800;letter-spacing:-.3px}p{font-size:12px;line-height:1.5;color:#5E6189;margin-top:5px;max-width:640px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.r{align-self:flex-end;margin-bottom:12px;font-size:10.5px;color:#9A9DC0;white-space:nowrap}</style></head><body><div class='c'><div><div class='t'><span class='n'>03</span><h1>Content &amp; Landing</h1></div><p>" & _h & "</p></div><div class='r'>" & _c & "</div></div></body></html>"
	// [Pages\04 Funnel] — Header card: page title, story headline and the comparison period (date slicer sits on top, right).
	MEASURE '_Measures'[04 · 000 Headline HTML] =
		VAR _h = SUBSTITUTE(SUBSTITUTE([04 Headline], "&", "&amp;"), "<", "&lt;")
		VAR _c = FORMAT([Period Days], "0") & " days · " & IF(ISBLANK([PP Start]), "no earlier period in data", "compared " & SUBSTITUTE([PP Label], "vs ", "with "))
		RETURN
		"<!DOCTYPE html><html><head><meta charset='utf-8'><link href='https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cormorant+Garamond:ital,wght@1,400&display=swap' rel='stylesheet'><style>*{box-sizing:border-box;margin:0;padding:0}html,body{height:100vh;overflow:hidden;background:transparent;font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:#1A1840}.c{height:100vh;background:#fff;border:1px solid #ECEDF6;border-radius:16px;display:flex;justify-content:space-between;align-items:center;padding:0 22px;gap:24px}.t{display:flex;align-items:center;gap:10px}.n{font-size:10px;font-weight:800;color:#5B5BD6;background:#EEEFFD;border-radius:6px;padding:3px 7px;letter-spacing:.06em}h1{font-size:19px;font-weight:800;letter-spacing:-.3px}p{font-size:12px;line-height:1.5;color:#5E6189;margin-top:5px;max-width:640px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.r{align-self:flex-end;margin-bottom:12px;font-size:10.5px;color:#9A9DC0;white-space:nowrap}</style></head><body><div class='c'><div><div class='t'><span class='n'>04</span><h1>Funnel</h1></div><p>" & _h & "</p></div><div class='r'>" & _c & "</div></div></body></html>"
	// [Pages\05 Products] — Header card: page title, story headline and the comparison period (date slicer sits on top, right).
	MEASURE '_Measures'[05 · 000 Headline HTML] =
		VAR _h = SUBSTITUTE(SUBSTITUTE([05 Headline], "&", "&amp;"), "<", "&lt;")
		VAR _c = FORMAT([Period Days], "0") & " days · " & IF(ISBLANK([PP Start]), "no earlier period in data", "compared " & SUBSTITUTE([PP Label], "vs ", "with "))
		RETURN
		"<!DOCTYPE html><html><head><meta charset='utf-8'><link href='https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cormorant+Garamond:ital,wght@1,400&display=swap' rel='stylesheet'><style>*{box-sizing:border-box;margin:0;padding:0}html,body{height:100vh;overflow:hidden;background:transparent;font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:#1A1840}.c{height:100vh;background:#fff;border:1px solid #ECEDF6;border-radius:16px;display:flex;justify-content:space-between;align-items:center;padding:0 22px;gap:24px}.t{display:flex;align-items:center;gap:10px}.n{font-size:10px;font-weight:800;color:#5B5BD6;background:#EEEFFD;border-radius:6px;padding:3px 7px;letter-spacing:.06em}h1{font-size:19px;font-weight:800;letter-spacing:-.3px}p{font-size:12px;line-height:1.5;color:#5E6189;margin-top:5px;max-width:640px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.r{align-self:flex-end;margin-bottom:12px;font-size:10.5px;color:#9A9DC0;white-space:nowrap}</style></head><body><div class='c'><div><div class='t'><span class='n'>05</span><h1>Products</h1></div><p>" & _h & "</p></div><div class='r'>" & _c & "</div></div></body></html>"
	// [Pages\01 Overview] — HTML Content visual. KPI cards: icon, value, last-7-day value and week-over-week change, hover card with what it is and why it matters.
	MEASURE '_Measures'[01 · 001 KPI Strip HTML] =
		VAR _v0 = [Revenue]
		VAR _d0 = [Revenue L7D Δ%]
		VAR _p0 = [Revenue L7D]
		VAR _l0 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Last 7 days", "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f0 = IF(ISBLANK(_v0), "—", "$" & IF(_v0 >= 1E6, FORMAT(_v0 / 1E6, "0.00") & "M", IF(_v0 >= 1E4, FORMAT(_v0 / 1E3, "0.0") & "K", FORMAT(_v0, "#,##0"))))
		VAR _pf0 = IF(ISBLANK(_p0), "not in data", "$" & IF(_p0 >= 1E6, FORMAT(_p0 / 1E6, "0.00") & "M", IF(_p0 >= 1E4, FORMAT(_p0 / 1E3, "0.0") & "K", FORMAT(_p0, "#,##0"))))
		VAR _c0 = IF(ISBLANK(_d0), "#9A9DC0", IF(_d0 * 1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t0 = IF(ISBLANK(_d0), "—", IF(_d0 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d0), "0.0%"))
		VAR _v1 = [Sessions]
		VAR _d1 = [Sessions L7D Δ%]
		VAR _p1 = [Sessions L7D]
		VAR _l1 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Last 7 days", "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f1 = IF(ISBLANK(_v1), "—", IF(_v1 >= 1E6, FORMAT(_v1 / 1E6, "0.00") & "M", IF(_v1 >= 1E4, FORMAT(_v1 / 1E3, "0.0") & "K", FORMAT(_v1, "#,##0"))))
		VAR _pf1 = IF(ISBLANK(_p1), "not in data", IF(_p1 >= 1E6, FORMAT(_p1 / 1E6, "0.00") & "M", IF(_p1 >= 1E4, FORMAT(_p1 / 1E3, "0.0") & "K", FORMAT(_p1, "#,##0"))))
		VAR _c1 = IF(ISBLANK(_d1), "#9A9DC0", IF(_d1 * 1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t1 = IF(ISBLANK(_d1), "—", IF(_d1 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d1), "0.0%"))
		VAR _v2 = [Conversion Rate]
		VAR _d2 = [Conversion Rate L7D Δ pts]
		VAR _p2 = [Conversion Rate L7D]
		VAR _l2 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Last 7 days", "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f2 = IF(ISBLANK(_v2), "—", FORMAT(_v2, "0.00%"))
		VAR _pf2 = IF(ISBLANK(_p2), "not in data", FORMAT(_p2, "0.00%"))
		VAR _c2 = IF(ISBLANK(_d2), "#9A9DC0", IF(_d2 * 1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t2 = IF(ISBLANK(_d2), "—", IF(_d2 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d2), "0.00") & " pts")
		VAR _v3 = [AOV]
		VAR _d3 = [AOV L7D Δ%]
		VAR _p3 = [AOV L7D]
		VAR _l3 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Last 7 days", "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f3 = IF(ISBLANK(_v3), "—", "$" & FORMAT(_v3, "0.00"))
		VAR _pf3 = IF(ISBLANK(_p3), "not in data", "$" & FORMAT(_p3, "0.00"))
		VAR _c3 = IF(ISBLANK(_d3), "#9A9DC0", IF(_d3 * 1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t3 = IF(ISBLANK(_d3), "—", IF(_d3 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d3), "0.0%"))
		VAR _v4 = [Transactions]
		VAR _d4 = [Transactions L7D Δ%]
		VAR _p4 = [Transactions L7D]
		VAR _l4 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Last 7 days", "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f4 = IF(ISBLANK(_v4), "—", IF(_v4 >= 1E6, FORMAT(_v4 / 1E6, "0.00") & "M", IF(_v4 >= 1E4, FORMAT(_v4 / 1E3, "0.0") & "K", FORMAT(_v4, "#,##0"))))
		VAR _pf4 = IF(ISBLANK(_p4), "not in data", IF(_p4 >= 1E6, FORMAT(_p4 / 1E6, "0.00") & "M", IF(_p4 >= 1E4, FORMAT(_p4 / 1E3, "0.0") & "K", FORMAT(_p4, "#,##0"))))
		VAR _c4 = IF(ISBLANK(_d4), "#9A9DC0", IF(_d4 * 1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t4 = IF(ISBLANK(_d4), "—", IF(_d4 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d4), "0.0%"))
		RETURN
		"<!DOCTYPE html><html><head><meta charset='utf-8'><link href='https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cormorant+Garamond:ital,wght@1,400&display=swap' rel='stylesheet'><style>*{box-sizing:border-box;margin:0;padding:0}html,body{height:100vh;overflow:hidden;background:transparent;font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:#1A1840}.row{display:flex;gap:12px;height:100vh;padding:1px}.k{position:relative;overflow:hidden;flex:1;min-width:0;background:#fff;border:1px solid #ECEDF6;border-radius:16px;padding:14px 16px 12px;display:flex;flex-direction:column;box-shadow:0 1px 2px rgba(26,24,64,.04)}.h{display:flex;align-items:center;gap:9px}.i{width:26px;height:26px;border-radius:8px;background:#EEEFFD;display:grid;place-items:center;flex:none}.i svg{width:14px;height:14px;stroke:#5B5BD6;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.l{font-size:11px;font-weight:600;color:#5E6189;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.n{font-size:25px;font-weight:800;letter-spacing:-.6px;margin-top:7px;line-height:1}.d{border-top:1px solid #ECEDF6;margin-top:auto;padding-top:7px;display:flex;flex-direction:column;gap:3px}.r{display:flex;justify-content:space-between;gap:8px;font-size:10px}.r span{color:#9A9DC0;font-weight:600;letter-spacing:.04em;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.r b{font-weight:700;white-space:nowrap;color:#5E6189}.w{position:absolute;inset:0;background:#1A1840;color:#fff;padding:12px 14px;font-size:10px;line-height:1.45;opacity:0;transition:opacity .2s;pointer-events:none;border-radius:16px}.w b{display:block;font-size:8.5px;letter-spacing:.12em;color:#C9CAF5;margin:6px 0 2px}.w b:first-child{margin-top:0}.k:hover .w{opacity:1}</style></head><body><div class='row'><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><path d='M12 2v20M17 6.5C17 4.6 14.8 4 12 4S7 5 7 7.5 9.5 10.5 12 11s5 1.5 5 4-2.2 3.5-5 3.5-5-.8-5-2.8'/></svg></span><span class='l'>Revenue</span></div><div class='n'>" & _f0 & "</div><div class='d'><div class='r'><span>" & _l0 & "</span><b>" & _pf0 & "</b></div><div class='r' title='Week over week: the last 7 days of the selection against the 7 days before them.'><span>WoW</span><b style='color:" & _c0 & "'>" & _t0 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Purchase revenue in USD from all sessions in the window.<b>WHY IT MATTERS</b>The bottom line. Every other card explains where it came from.</div></div><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><circle cx='9' cy='8' r='3.5'/><path d='M2.5 20a6.5 6.5 0 0 1 13 0'/><path d='M16 4.5a3.5 3.5 0 0 1 0 7M18.5 20a6.5 6.5 0 0 0-3-5.5'/></svg></span><span class='l'>Sessions</span></div><div class='n'>" & _f1 & "</div><div class='d'><div class='r'><span>" & _l1 & "</span><b>" & _pf1 & "</b></div><div class='r' title='Week over week: the last 7 days of the selection against the 7 days before them.'><span>WoW</span><b style='color:" & _c1 & "'>" & _t1 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Visits to the site. One person can start several sessions.<b>WHY IT MATTERS</b>Traffic. Revenue rises with visits or with conversion, so read both.</div></div><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><circle cx='12' cy='12' r='9'/><circle cx='12' cy='12' r='5'/><circle cx='12' cy='12' r='1'/></svg></span><span class='l'>Conversion rate</span></div><div class='n'>" & _f2 & "</div><div class='d'><div class='r'><span>" & _l2 & "</span><b>" & _pf2 & "</b></div><div class='r' title='Week over week: the last 7 days of the selection against the 7 days before them.'><span>WoW</span><b style='color:" & _c2 & "'>" & _t2 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Sessions with a purchase divided by all sessions.<b>WHY IT MATTERS</b>How well visitors become buyers. Shown in points so small moves stay readable.</div></div><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><path d='M3 12V3h9l9 9-9 9z'/><circle cx='7.5' cy='7.5' r='1.5'/></svg></span><span class='l'>Average order value</span></div><div class='n'>" & _f3 & "</div><div class='d'><div class='r'><span>" & _l3 & "</span><b>" & _pf3 & "</b></div><div class='r' title='Week over week: the last 7 days of the selection against the 7 days before them.'><span>WoW</span><b style='color:" & _c3 & "'>" & _t3 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Revenue divided by transactions: what one order is worth.<b>WHY IT MATTERS</b>Rising AOV with flat conversion means bigger baskets.</div></div><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><path d='M6 3h12v18l-3-2-3 2-3-2-3 2z'/><path d='M9 8h6M9 12h6'/></svg></span><span class='l'>Transactions</span></div><div class='n'>" & _f4 & "</div><div class='d'><div class='r'><span>" & _l4 & "</span><b>" & _pf4 & "</b></div><div class='r' title='Week over week: the last 7 days of the selection against the 7 days before them.'><span>WoW</span><b style='color:" & _c4 & "'>" & _t4 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Orders placed in the window, each counted once.<b>WHY IT MATTERS</b>Revenue equals transactions times AOV. Read them together.</div></div></div></body></html>"
	// [Pages\01 Overview] — Alt text for the KPI strip.
	MEASURE '_Measures'[01 · 001 KPI Strip Alt Text] =
		"Revenue " & "$" & IF([Revenue] >= 1E6, FORMAT([Revenue] / 1E6, "0.00") & "M", IF([Revenue] >= 1E4, FORMAT([Revenue] / 1E3, "0.0") & "K", FORMAT([Revenue], "#,##0"))) & " · " & "Sessions " & IF([Sessions] >= 1E6, FORMAT([Sessions] / 1E6, "0.00") & "M", IF([Sessions] >= 1E4, FORMAT([Sessions] / 1E3, "0.0") & "K", FORMAT([Sessions], "#,##0"))) & " · " & "Conversion rate " & FORMAT([Conversion Rate], "0.00%") & " · " & "Average order value " & "$" & FORMAT([AOV], "0.00") & " · " & "Transactions " & IF([Transactions] >= 1E6, FORMAT([Transactions] / 1E6, "0.00") & "M", IF([Transactions] >= 1E4, FORMAT([Transactions] / 1E3, "0.0") & "K", FORMAT([Transactions], "#,##0"))) & " (" & [Period Label] & ", " & [PP Label] & ")"
	// [Pages\02 Acquisition] — HTML Content visual. KPI cards: icon, value, last-7-day value and week-over-week change, hover card with what it is and why it matters.
	MEASURE '_Measures'[02 · 001 KPI Strip HTML] =
		VAR _v0 = [Sessions]
		VAR _d0 = [Sessions L7D Δ%]
		VAR _p0 = [Sessions L7D]
		VAR _l0 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Last 7 days", "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f0 = IF(ISBLANK(_v0), "—", IF(_v0 >= 1E6, FORMAT(_v0 / 1E6, "0.00") & "M", IF(_v0 >= 1E4, FORMAT(_v0 / 1E3, "0.0") & "K", FORMAT(_v0, "#,##0"))))
		VAR _pf0 = IF(ISBLANK(_p0), "not in data", IF(_p0 >= 1E6, FORMAT(_p0 / 1E6, "0.00") & "M", IF(_p0 >= 1E4, FORMAT(_p0 / 1E3, "0.0") & "K", FORMAT(_p0, "#,##0"))))
		VAR _c0 = IF(ISBLANK(_d0), "#9A9DC0", IF(_d0 * 1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t0 = IF(ISBLANK(_d0), "—", IF(_d0 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d0), "0.0%"))
		VAR _v1 = [New Users]
		VAR _d1 = [New Users L7D Δ%]
		VAR _p1 = [New Users L7D]
		VAR _l1 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Last 7 days", "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f1 = IF(ISBLANK(_v1), "—", IF(_v1 >= 1E6, FORMAT(_v1 / 1E6, "0.00") & "M", IF(_v1 >= 1E4, FORMAT(_v1 / 1E3, "0.0") & "K", FORMAT(_v1, "#,##0"))))
		VAR _pf1 = IF(ISBLANK(_p1), "not in data", IF(_p1 >= 1E6, FORMAT(_p1 / 1E6, "0.00") & "M", IF(_p1 >= 1E4, FORMAT(_p1 / 1E3, "0.0") & "K", FORMAT(_p1, "#,##0"))))
		VAR _c1 = IF(ISBLANK(_d1), "#9A9DC0", IF(_d1 * 1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t1 = IF(ISBLANK(_d1), "—", IF(_d1 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d1), "0.0%"))
		VAR _v2 = [Engagement Rate]
		VAR _d2 = [Engagement Rate L7D Δ pts]
		VAR _p2 = [Engagement Rate L7D]
		VAR _l2 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Last 7 days", "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f2 = IF(ISBLANK(_v2), "—", FORMAT(_v2, "0.00%"))
		VAR _pf2 = IF(ISBLANK(_p2), "not in data", FORMAT(_p2, "0.00%"))
		VAR _c2 = IF(ISBLANK(_d2), "#9A9DC0", IF(_d2 * 1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t2 = IF(ISBLANK(_d2), "—", IF(_d2 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d2), "0.00") & " pts")
		VAR _v3 = [Revenue per Session]
		VAR _d3 = [Revenue per Session L7D Δ%]
		VAR _p3 = [Revenue per Session L7D]
		VAR _l3 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Last 7 days", "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f3 = IF(ISBLANK(_v3), "—", "$" & FORMAT(_v3, "0.00"))
		VAR _pf3 = IF(ISBLANK(_p3), "not in data", "$" & FORMAT(_p3, "0.00"))
		VAR _c3 = IF(ISBLANK(_d3), "#9A9DC0", IF(_d3 * 1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t3 = IF(ISBLANK(_d3), "—", IF(_d3 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d3), "0.0%"))
		RETURN
		"<!DOCTYPE html><html><head><meta charset='utf-8'><link href='https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cormorant+Garamond:ital,wght@1,400&display=swap' rel='stylesheet'><style>*{box-sizing:border-box;margin:0;padding:0}html,body{height:100vh;overflow:hidden;background:transparent;font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:#1A1840}.row{display:flex;gap:12px;height:100vh;padding:1px}.k{position:relative;overflow:hidden;flex:1;min-width:0;background:#fff;border:1px solid #ECEDF6;border-radius:16px;padding:14px 16px 12px;display:flex;flex-direction:column;box-shadow:0 1px 2px rgba(26,24,64,.04)}.h{display:flex;align-items:center;gap:9px}.i{width:26px;height:26px;border-radius:8px;background:#EEEFFD;display:grid;place-items:center;flex:none}.i svg{width:14px;height:14px;stroke:#5B5BD6;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.l{font-size:11px;font-weight:600;color:#5E6189;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.n{font-size:25px;font-weight:800;letter-spacing:-.6px;margin-top:7px;line-height:1}.d{border-top:1px solid #ECEDF6;margin-top:auto;padding-top:7px;display:flex;flex-direction:column;gap:3px}.r{display:flex;justify-content:space-between;gap:8px;font-size:10px}.r span{color:#9A9DC0;font-weight:600;letter-spacing:.04em;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.r b{font-weight:700;white-space:nowrap;color:#5E6189}.w{position:absolute;inset:0;background:#1A1840;color:#fff;padding:12px 14px;font-size:10px;line-height:1.45;opacity:0;transition:opacity .2s;pointer-events:none;border-radius:16px}.w b{display:block;font-size:8.5px;letter-spacing:.12em;color:#C9CAF5;margin:6px 0 2px}.w b:first-child{margin-top:0}.k:hover .w{opacity:1}</style></head><body><div class='row'><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><circle cx='9' cy='8' r='3.5'/><path d='M2.5 20a6.5 6.5 0 0 1 13 0'/><path d='M16 4.5a3.5 3.5 0 0 1 0 7M18.5 20a6.5 6.5 0 0 0-3-5.5'/></svg></span><span class='l'>Sessions</span></div><div class='n'>" & _f0 & "</div><div class='d'><div class='r'><span>" & _l0 & "</span><b>" & _pf0 & "</b></div><div class='r' title='Week over week: the last 7 days of the selection against the 7 days before them.'><span>WoW</span><b style='color:" & _c0 & "'>" & _t0 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Visits to the site. One person can start several sessions.<b>WHY IT MATTERS</b>Traffic. Revenue rises with visits or with conversion, so read both.</div></div><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><circle cx='9' cy='8' r='3.5'/><path d='M2.5 20a6.5 6.5 0 0 1 13 0'/><path d='M16 4.5a3.5 3.5 0 0 1 0 7M18.5 20a6.5 6.5 0 0 0-3-5.5'/></svg></span><span class='l'>New users</span></div><div class='n'>" & _f1 & "</div><div class='d'><div class='r'><span>" & _l1 & "</span><b>" & _pf1 & "</b></div><div class='r' title='Week over week: the last 7 days of the selection against the 7 days before them.'><span>WoW</span><b style='color:" & _c1 & "'>" & _t1 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Visitors who saw the site for the first time.<b>WHY IT MATTERS</b>Reach. Many new users with flat revenue means they are not converting yet.</div></div><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><path d='M13 2L4 14h7l-1 8 9-12h-7z'/></svg></span><span class='l'>Engagement rate</span></div><div class='n'>" & _f2 & "</div><div class='d'><div class='r'><span>" & _l2 & "</span><b>" & _pf2 & "</b></div><div class='r' title='Week over week: the last 7 days of the selection against the 7 days before them.'><span>WoW</span><b style='color:" & _c2 & "'>" & _t2 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Sessions over 10 seconds, with a conversion, or with 2+ pages.<b>WHY IT MATTERS</b>Traffic quality. Low engagement means the wrong audience arrived.</div></div><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><path d='M12 2v20M17 6.5C17 4.6 14.8 4 12 4S7 5 7 7.5 9.5 10.5 12 11s5 1.5 5 4-2.2 3.5-5 3.5-5-.8-5-2.8'/></svg></span><span class='l'>Revenue per session</span></div><div class='n'>" & _f3 & "</div><div class='d'><div class='r'><span>" & _l3 & "</span><b>" & _pf3 & "</b></div><div class='r' title='Week over week: the last 7 days of the selection against the 7 days before them.'><span>WoW</span><b style='color:" & _c3 & "'>" & _t3 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Revenue divided by sessions: what one visit is worth.<b>WHY IT MATTERS</b>Compares channels of any size fairly, because it removes volume.</div></div></div></body></html>"
	// [Pages\02 Acquisition] — Alt text for the KPI strip.
	MEASURE '_Measures'[02 · 001 KPI Strip Alt Text] =
		"Sessions " & IF([Sessions] >= 1E6, FORMAT([Sessions] / 1E6, "0.00") & "M", IF([Sessions] >= 1E4, FORMAT([Sessions] / 1E3, "0.0") & "K", FORMAT([Sessions], "#,##0"))) & " · " & "New users " & IF([New Users] >= 1E6, FORMAT([New Users] / 1E6, "0.00") & "M", IF([New Users] >= 1E4, FORMAT([New Users] / 1E3, "0.0") & "K", FORMAT([New Users], "#,##0"))) & " · " & "Engagement rate " & FORMAT([Engagement Rate], "0.00%") & " · " & "Revenue per session " & "$" & FORMAT([Revenue per Session], "0.00") & " (" & [Period Label] & ", " & [PP Label] & ")"
	// [Pages\03 Content] — HTML Content visual. KPI cards: icon, value, last-7-day value and week-over-week change, hover card with what it is and why it matters.
	MEASURE '_Measures'[03 · 001 KPI Strip HTML] =
		VAR _v0 = [Pageviews]
		VAR _d0 = [Pageviews L7D Δ%]
		VAR _p0 = [Pageviews L7D]
		VAR _l0 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Last 7 days", "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f0 = IF(ISBLANK(_v0), "—", IF(_v0 >= 1E6, FORMAT(_v0 / 1E6, "0.00") & "M", IF(_v0 >= 1E4, FORMAT(_v0 / 1E3, "0.0") & "K", FORMAT(_v0, "#,##0"))))
		VAR _pf0 = IF(ISBLANK(_p0), "not in data", IF(_p0 >= 1E6, FORMAT(_p0 / 1E6, "0.00") & "M", IF(_p0 >= 1E4, FORMAT(_p0 / 1E3, "0.0") & "K", FORMAT(_p0, "#,##0"))))
		VAR _c0 = IF(ISBLANK(_d0), "#9A9DC0", IF(_d0 * 1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t0 = IF(ISBLANK(_d0), "—", IF(_d0 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d0), "0.0%"))
		VAR _v1 = [Pages per Session]
		VAR _d1 = [Pages per Session L7D Δ%]
		VAR _p1 = [Pages per Session L7D]
		VAR _l1 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Last 7 days", "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f1 = IF(ISBLANK(_v1), "—", FORMAT(_v1, "0.00"))
		VAR _pf1 = IF(ISBLANK(_p1), "not in data", FORMAT(_p1, "0.00"))
		VAR _c1 = IF(ISBLANK(_d1), "#9A9DC0", IF(_d1 * 1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t1 = IF(ISBLANK(_d1), "—", IF(_d1 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d1), "0.0%"))
		VAR _v2 = [Avg Engagement Time (sec)]
		VAR _d2 = [Avg Engagement Time (sec) L7D Δ%]
		VAR _p2 = [Avg Engagement Time (sec) L7D]
		VAR _l2 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Last 7 days", "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f2 = IF(ISBLANK(_v2), "—", FORMAT(INT(_v2 / 60), "0") & "m " & FORMAT(MOD(INT(_v2), 60), "00") & "s")
		VAR _pf2 = IF(ISBLANK(_p2), "not in data", FORMAT(INT(_p2 / 60), "0") & "m " & FORMAT(MOD(INT(_p2), 60), "00") & "s")
		VAR _c2 = IF(ISBLANK(_d2), "#9A9DC0", IF(_d2 * 1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t2 = IF(ISBLANK(_d2), "—", IF(_d2 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d2), "0.0%"))
		VAR _v3 = [Revenue per Session]
		VAR _d3 = [Revenue per Session L7D Δ%]
		VAR _p3 = [Revenue per Session L7D]
		VAR _l3 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Last 7 days", "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f3 = IF(ISBLANK(_v3), "—", "$" & FORMAT(_v3, "0.00"))
		VAR _pf3 = IF(ISBLANK(_p3), "not in data", "$" & FORMAT(_p3, "0.00"))
		VAR _c3 = IF(ISBLANK(_d3), "#9A9DC0", IF(_d3 * 1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t3 = IF(ISBLANK(_d3), "—", IF(_d3 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d3), "0.0%"))
		RETURN
		"<!DOCTYPE html><html><head><meta charset='utf-8'><link href='https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cormorant+Garamond:ital,wght@1,400&display=swap' rel='stylesheet'><style>*{box-sizing:border-box;margin:0;padding:0}html,body{height:100vh;overflow:hidden;background:transparent;font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:#1A1840}.row{display:flex;gap:12px;height:100vh;padding:1px}.k{position:relative;overflow:hidden;flex:1;min-width:0;background:#fff;border:1px solid #ECEDF6;border-radius:16px;padding:14px 16px 12px;display:flex;flex-direction:column;box-shadow:0 1px 2px rgba(26,24,64,.04)}.h{display:flex;align-items:center;gap:9px}.i{width:26px;height:26px;border-radius:8px;background:#EEEFFD;display:grid;place-items:center;flex:none}.i svg{width:14px;height:14px;stroke:#5B5BD6;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.l{font-size:11px;font-weight:600;color:#5E6189;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.n{font-size:25px;font-weight:800;letter-spacing:-.6px;margin-top:7px;line-height:1}.d{border-top:1px solid #ECEDF6;margin-top:auto;padding-top:7px;display:flex;flex-direction:column;gap:3px}.r{display:flex;justify-content:space-between;gap:8px;font-size:10px}.r span{color:#9A9DC0;font-weight:600;letter-spacing:.04em;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.r b{font-weight:700;white-space:nowrap;color:#5E6189}.w{position:absolute;inset:0;background:#1A1840;color:#fff;padding:12px 14px;font-size:10px;line-height:1.45;opacity:0;transition:opacity .2s;pointer-events:none;border-radius:16px}.w b{display:block;font-size:8.5px;letter-spacing:.12em;color:#C9CAF5;margin:6px 0 2px}.w b:first-child{margin-top:0}.k:hover .w{opacity:1}</style></head><body><div class='row'><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><path d='M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z'/><circle cx='12' cy='12' r='3'/></svg></span><span class='l'>Pageviews</span></div><div class='n'>" & _f0 & "</div><div class='d'><div class='r'><span>" & _l0 & "</span><b>" & _pf0 & "</b></div><div class='r' title='Week over week: the last 7 days of the selection against the 7 days before them.'><span>WoW</span><b style='color:" & _c0 & "'>" & _t0 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Pages loaded in the window.<b>WHY IT MATTERS</b>Reach of the content. Read it with pages per session.</div></div><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><path d='M12 3l9 5-9 5-9-5z'/><path d='M3 13l9 5 9-5'/></svg></span><span class='l'>Pages per session</span></div><div class='n'>" & _f1 & "</div><div class='d'><div class='r'><span>" & _l1 & "</span><b>" & _pf1 & "</b></div><div class='r' title='Week over week: the last 7 days of the selection against the 7 days before them.'><span>WoW</span><b style='color:" & _c1 & "'>" & _t1 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Pageviews divided by sessions: how deep each visit goes.<b>WHY IT MATTERS</b>Low depth on busy landing pages means they do not guide people on.</div></div><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><circle cx='12' cy='12' r='9'/><path d='M12 7v5l3 2'/></svg></span><span class='l'>Engagement time</span></div><div class='n'>" & _f2 & "</div><div class='d'><div class='r'><span>" & _l2 & "</span><b>" & _pf2 & "</b></div><div class='r' title='Week over week: the last 7 days of the selection against the 7 days before them.'><span>WoW</span><b style='color:" & _c2 & "'>" & _t2 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Average seconds the site was in focus per session.<b>WHY IT MATTERS</b>Attention. Long time on a page that earns nothing needs a fix.</div></div><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><path d='M12 2v20M17 6.5C17 4.6 14.8 4 12 4S7 5 7 7.5 9.5 10.5 12 11s5 1.5 5 4-2.2 3.5-5 3.5-5-.8-5-2.8'/></svg></span><span class='l'>Revenue per session</span></div><div class='n'>" & _f3 & "</div><div class='d'><div class='r'><span>" & _l3 & "</span><b>" & _pf3 & "</b></div><div class='r' title='Week over week: the last 7 days of the selection against the 7 days before them.'><span>WoW</span><b style='color:" & _c3 & "'>" & _t3 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Revenue divided by sessions: what one visit is worth.<b>WHY IT MATTERS</b>Compares channels of any size fairly, because it removes volume.</div></div></div></body></html>"
	// [Pages\03 Content] — Alt text for the KPI strip.
	MEASURE '_Measures'[03 · 001 KPI Strip Alt Text] =
		"Pageviews " & IF([Pageviews] >= 1E6, FORMAT([Pageviews] / 1E6, "0.00") & "M", IF([Pageviews] >= 1E4, FORMAT([Pageviews] / 1E3, "0.0") & "K", FORMAT([Pageviews], "#,##0"))) & " · " & "Pages per session " & FORMAT([Pages per Session], "0.00") & " · " & "Engagement time " & FORMAT(INT([Avg Engagement Time (sec)] / 60), "0") & "m " & FORMAT(MOD(INT([Avg Engagement Time (sec)]), 60), "00") & "s" & " · " & "Revenue per session " & "$" & FORMAT([Revenue per Session], "0.00") & " (" & [Period Label] & ", " & [PP Label] & ")"
	// [Pages\04 Funnel] — HTML Content visual. KPI cards: icon, value, last-7-day value and week-over-week change, hover card with what it is and why it matters.
	MEASURE '_Measures'[04 · 001 KPI Strip HTML] =
		VAR _v0 = [View Item Sessions]
		VAR _d0 = [View Item Sessions L7D Δ%]
		VAR _p0 = [View Item Sessions L7D]
		VAR _l0 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Last 7 days", "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f0 = IF(ISBLANK(_v0), "—", IF(_v0 >= 1E6, FORMAT(_v0 / 1E6, "0.00") & "M", IF(_v0 >= 1E4, FORMAT(_v0 / 1E3, "0.0") & "K", FORMAT(_v0, "#,##0"))))
		VAR _pf0 = IF(ISBLANK(_p0), "not in data", IF(_p0 >= 1E6, FORMAT(_p0 / 1E6, "0.00") & "M", IF(_p0 >= 1E4, FORMAT(_p0 / 1E3, "0.0") & "K", FORMAT(_p0, "#,##0"))))
		VAR _c0 = IF(ISBLANK(_d0), "#9A9DC0", IF(_d0 * 1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t0 = IF(ISBLANK(_d0), "—", IF(_d0 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d0), "0.0%"))
		VAR _v1 = [Begin Checkout Sessions]
		VAR _d1 = [Begin Checkout Sessions L7D Δ%]
		VAR _p1 = [Begin Checkout Sessions L7D]
		VAR _l1 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Last 7 days", "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f1 = IF(ISBLANK(_v1), "—", IF(_v1 >= 1E6, FORMAT(_v1 / 1E6, "0.00") & "M", IF(_v1 >= 1E4, FORMAT(_v1 / 1E3, "0.0") & "K", FORMAT(_v1, "#,##0"))))
		VAR _pf1 = IF(ISBLANK(_p1), "not in data", IF(_p1 >= 1E6, FORMAT(_p1 / 1E6, "0.00") & "M", IF(_p1 >= 1E4, FORMAT(_p1 / 1E3, "0.0") & "K", FORMAT(_p1, "#,##0"))))
		VAR _c1 = IF(ISBLANK(_d1), "#9A9DC0", IF(_d1 * 1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t1 = IF(ISBLANK(_d1), "—", IF(_d1 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d1), "0.0%"))
		VAR _v2 = [Purchase Sessions]
		VAR _d2 = [Purchase Sessions L7D Δ%]
		VAR _p2 = [Purchase Sessions L7D]
		VAR _l2 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Last 7 days", "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f2 = IF(ISBLANK(_v2), "—", IF(_v2 >= 1E6, FORMAT(_v2 / 1E6, "0.00") & "M", IF(_v2 >= 1E4, FORMAT(_v2 / 1E3, "0.0") & "K", FORMAT(_v2, "#,##0"))))
		VAR _pf2 = IF(ISBLANK(_p2), "not in data", IF(_p2 >= 1E6, FORMAT(_p2 / 1E6, "0.00") & "M", IF(_p2 >= 1E4, FORMAT(_p2 / 1E3, "0.0") & "K", FORMAT(_p2, "#,##0"))))
		VAR _c2 = IF(ISBLANK(_d2), "#9A9DC0", IF(_d2 * 1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t2 = IF(ISBLANK(_d2), "—", IF(_d2 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d2), "0.0%"))
		VAR _v3 = [Cart Abandonment Rate]
		VAR _d3 = [Cart Abandonment Rate L7D Δ pts]
		VAR _p3 = [Cart Abandonment Rate L7D]
		VAR _l3 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Last 7 days", "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f3 = IF(ISBLANK(_v3), "—", FORMAT(_v3, "0.00%"))
		VAR _pf3 = IF(ISBLANK(_p3), "not in data", FORMAT(_p3, "0.00%"))
		VAR _c3 = IF(ISBLANK(_d3), "#9A9DC0", IF(_d3 * -1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t3 = IF(ISBLANK(_d3), "—", IF(_d3 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d3), "0.00") & " pts")
		RETURN
		"<!DOCTYPE html><html><head><meta charset='utf-8'><link href='https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cormorant+Garamond:ital,wght@1,400&display=swap' rel='stylesheet'><style>*{box-sizing:border-box;margin:0;padding:0}html,body{height:100vh;overflow:hidden;background:transparent;font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:#1A1840}.row{display:flex;gap:12px;height:100vh;padding:1px}.k{position:relative;overflow:hidden;flex:1;min-width:0;background:#fff;border:1px solid #ECEDF6;border-radius:16px;padding:14px 16px 12px;display:flex;flex-direction:column;box-shadow:0 1px 2px rgba(26,24,64,.04)}.h{display:flex;align-items:center;gap:9px}.i{width:26px;height:26px;border-radius:8px;background:#EEEFFD;display:grid;place-items:center;flex:none}.i svg{width:14px;height:14px;stroke:#5B5BD6;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.l{font-size:11px;font-weight:600;color:#5E6189;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.n{font-size:25px;font-weight:800;letter-spacing:-.6px;margin-top:7px;line-height:1}.d{border-top:1px solid #ECEDF6;margin-top:auto;padding-top:7px;display:flex;flex-direction:column;gap:3px}.r{display:flex;justify-content:space-between;gap:8px;font-size:10px}.r span{color:#9A9DC0;font-weight:600;letter-spacing:.04em;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.r b{font-weight:700;white-space:nowrap;color:#5E6189}.w{position:absolute;inset:0;background:#1A1840;color:#fff;padding:12px 14px;font-size:10px;line-height:1.45;opacity:0;transition:opacity .2s;pointer-events:none;border-radius:16px}.w b{display:block;font-size:8.5px;letter-spacing:.12em;color:#C9CAF5;margin:6px 0 2px}.w b:first-child{margin-top:0}.k:hover .w{opacity:1}</style></head><body><div class='row'><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><path d='M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z'/><circle cx='12' cy='12' r='3'/></svg></span><span class='l'>Product viewers</span></div><div class='n'>" & _f0 & "</div><div class='d'><div class='r'><span>" & _l0 & "</span><b>" & _pf0 & "</b></div><div class='r' title='Week over week: the last 7 days of the selection against the 7 days before them.'><span>WoW</span><b style='color:" & _c0 & "'>" & _t0 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Sessions that viewed a product page.<b>WHY IT MATTERS</b>Top of the shopping funnel. Compare with checkout to find the leak.</div></div><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><circle cx='9' cy='20' r='1.5'/><circle cx='18' cy='20' r='1.5'/><path d='M2 3h3l2.5 12h11L21 7H6'/></svg></span><span class='l'>Checkout sessions</span></div><div class='n'>" & _f1 & "</div><div class='d'><div class='r'><span>" & _l1 & "</span><b>" & _pf1 & "</b></div><div class='r' title='Week over week: the last 7 days of the selection against the 7 days before them.'><span>WoW</span><b style='color:" & _c1 & "'>" & _t1 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Sessions that started checkout.<b>WHY IT MATTERS</b>Buying intent. A big gap to buyers points at the checkout itself.</div></div><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><path d='M6 3h12v18l-3-2-3 2-3-2-3 2z'/><path d='M9 8h6M9 12h6'/></svg></span><span class='l'>Buyers</span></div><div class='n'>" & _f2 & "</div><div class='d'><div class='r'><span>" & _l2 & "</span><b>" & _pf2 & "</b></div><div class='r' title='Week over week: the last 7 days of the selection against the 7 days before them.'><span>WoW</span><b style='color:" & _c2 & "'>" & _t2 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Sessions that completed a purchase.<b>WHY IT MATTERS</b>The end of the funnel, counted in people rather than percentages.</div></div><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><path d='M3 4h18l-7 8v6l-4 2v-8z'/></svg></span><span class='l'>Cart abandonment</span></div><div class='n'>" & _f3 & "</div><div class='d'><div class='r'><span>" & _l3 & "</span><b>" & _pf3 & "</b></div><div class='r' title='Week over week: the last 7 days of the selection against the 7 days before them.'><span>WoW</span><b style='color:" & _c3 & "'>" & _t3 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Add-to-cart sessions that did not buy, counted from Nov 25.<b>WHY IT MATTERS</b>Lower is better. Falling with flat sessions is a checkout win.</div></div></div></body></html>"
	// [Pages\04 Funnel] — Alt text for the KPI strip.
	MEASURE '_Measures'[04 · 001 KPI Strip Alt Text] =
		"Product viewers " & IF([View Item Sessions] >= 1E6, FORMAT([View Item Sessions] / 1E6, "0.00") & "M", IF([View Item Sessions] >= 1E4, FORMAT([View Item Sessions] / 1E3, "0.0") & "K", FORMAT([View Item Sessions], "#,##0"))) & " · " & "Checkout sessions " & IF([Begin Checkout Sessions] >= 1E6, FORMAT([Begin Checkout Sessions] / 1E6, "0.00") & "M", IF([Begin Checkout Sessions] >= 1E4, FORMAT([Begin Checkout Sessions] / 1E3, "0.0") & "K", FORMAT([Begin Checkout Sessions], "#,##0"))) & " · " & "Buyers " & IF([Purchase Sessions] >= 1E6, FORMAT([Purchase Sessions] / 1E6, "0.00") & "M", IF([Purchase Sessions] >= 1E4, FORMAT([Purchase Sessions] / 1E3, "0.0") & "K", FORMAT([Purchase Sessions], "#,##0"))) & " · " & "Cart abandonment " & FORMAT([Cart Abandonment Rate], "0.00%") & " (" & [Period Label] & ", " & [PP Label] & ")"
	// [Pages\05 Products] — HTML Content visual. KPI cards: icon, value, last-7-day value and week-over-week change, hover card with what it is and why it matters.
	MEASURE '_Measures'[05 · 001 KPI Strip HTML] =
		VAR _v0 = [Item Revenue]
		VAR _d0 = [Item Revenue L7D Δ%]
		VAR _p0 = [Item Revenue L7D]
		VAR _l0 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Last 7 days", "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f0 = IF(ISBLANK(_v0), "—", "$" & IF(_v0 >= 1E6, FORMAT(_v0 / 1E6, "0.00") & "M", IF(_v0 >= 1E4, FORMAT(_v0 / 1E3, "0.0") & "K", FORMAT(_v0, "#,##0"))))
		VAR _pf0 = IF(ISBLANK(_p0), "not in data", "$" & IF(_p0 >= 1E6, FORMAT(_p0 / 1E6, "0.00") & "M", IF(_p0 >= 1E4, FORMAT(_p0 / 1E3, "0.0") & "K", FORMAT(_p0, "#,##0"))))
		VAR _c0 = IF(ISBLANK(_d0), "#9A9DC0", IF(_d0 * 1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t0 = IF(ISBLANK(_d0), "—", IF(_d0 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d0), "0.0%"))
		VAR _v1 = [Units Purchased]
		VAR _d1 = [Units Purchased L7D Δ%]
		VAR _p1 = [Units Purchased L7D]
		VAR _l1 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Last 7 days", "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f1 = IF(ISBLANK(_v1), "—", IF(_v1 >= 1E6, FORMAT(_v1 / 1E6, "0.00") & "M", IF(_v1 >= 1E4, FORMAT(_v1 / 1E3, "0.0") & "K", FORMAT(_v1, "#,##0"))))
		VAR _pf1 = IF(ISBLANK(_p1), "not in data", IF(_p1 >= 1E6, FORMAT(_p1 / 1E6, "0.00") & "M", IF(_p1 >= 1E4, FORMAT(_p1 / 1E3, "0.0") & "K", FORMAT(_p1, "#,##0"))))
		VAR _c1 = IF(ISBLANK(_d1), "#9A9DC0", IF(_d1 * 1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t1 = IF(ISBLANK(_d1), "—", IF(_d1 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d1), "0.0%"))
		VAR _v2 = [Avg Item Price]
		VAR _d2 = [Avg Item Price L7D Δ%]
		VAR _p2 = [Avg Item Price L7D]
		VAR _l2 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Last 7 days", "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f2 = IF(ISBLANK(_v2), "—", "$" & FORMAT(_v2, "0.00"))
		VAR _pf2 = IF(ISBLANK(_p2), "not in data", "$" & FORMAT(_p2, "0.00"))
		VAR _c2 = IF(ISBLANK(_d2), "#9A9DC0", IF(_d2 * 1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t2 = IF(ISBLANK(_d2), "—", IF(_d2 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d2), "0.0%"))
		VAR _v3 = [Items Sold]
		VAR _d3 = [Items Sold L7D Δ%]
		VAR _p3 = [Items Sold L7D]
		VAR _l3 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Last 7 days", "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f3 = IF(ISBLANK(_v3), "—", IF(_v3 >= 1E6, FORMAT(_v3 / 1E6, "0.00") & "M", IF(_v3 >= 1E4, FORMAT(_v3 / 1E3, "0.0") & "K", FORMAT(_v3, "#,##0"))))
		VAR _pf3 = IF(ISBLANK(_p3), "not in data", IF(_p3 >= 1E6, FORMAT(_p3 / 1E6, "0.00") & "M", IF(_p3 >= 1E4, FORMAT(_p3 / 1E3, "0.0") & "K", FORMAT(_p3, "#,##0"))))
		VAR _c3 = IF(ISBLANK(_d3), "#9A9DC0", IF(_d3 * 1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t3 = IF(ISBLANK(_d3), "—", IF(_d3 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d3), "0.0%"))
		RETURN
		"<!DOCTYPE html><html><head><meta charset='utf-8'><link href='https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cormorant+Garamond:ital,wght@1,400&display=swap' rel='stylesheet'><style>*{box-sizing:border-box;margin:0;padding:0}html,body{height:100vh;overflow:hidden;background:transparent;font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:#1A1840}.row{display:flex;gap:12px;height:100vh;padding:1px}.k{position:relative;overflow:hidden;flex:1;min-width:0;background:#fff;border:1px solid #ECEDF6;border-radius:16px;padding:14px 16px 12px;display:flex;flex-direction:column;box-shadow:0 1px 2px rgba(26,24,64,.04)}.h{display:flex;align-items:center;gap:9px}.i{width:26px;height:26px;border-radius:8px;background:#EEEFFD;display:grid;place-items:center;flex:none}.i svg{width:14px;height:14px;stroke:#5B5BD6;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.l{font-size:11px;font-weight:600;color:#5E6189;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.n{font-size:25px;font-weight:800;letter-spacing:-.6px;margin-top:7px;line-height:1}.d{border-top:1px solid #ECEDF6;margin-top:auto;padding-top:7px;display:flex;flex-direction:column;gap:3px}.r{display:flex;justify-content:space-between;gap:8px;font-size:10px}.r span{color:#9A9DC0;font-weight:600;letter-spacing:.04em;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.r b{font-weight:700;white-space:nowrap;color:#5E6189}.w{position:absolute;inset:0;background:#1A1840;color:#fff;padding:12px 14px;font-size:10px;line-height:1.45;opacity:0;transition:opacity .2s;pointer-events:none;border-radius:16px}.w b{display:block;font-size:8.5px;letter-spacing:.12em;color:#C9CAF5;margin:6px 0 2px}.w b:first-child{margin-top:0}.k:hover .w{opacity:1}</style></head><body><div class='row'><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><path d='M12 2v20M17 6.5C17 4.6 14.8 4 12 4S7 5 7 7.5 9.5 10.5 12 11s5 1.5 5 4-2.2 3.5-5 3.5-5-.8-5-2.8'/></svg></span><span class='l'>Item revenue</span></div><div class='n'>" & _f0 & "</div><div class='d'><div class='r'><span>" & _l0 & "</span><b>" & _pf0 & "</b></div><div class='r' title='Week over week: the last 7 days of the selection against the 7 days before them.'><span>WoW</span><b style='color:" & _c0 & "'>" & _t0 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Revenue from products sold, item by item.<b>WHY IT MATTERS</b>Shows which products carry the money. Can differ from order revenue.</div></div><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><path d='M3 7l9-4 9 4v10l-9 4-9-4z'/><path d='M3 7l9 4 9-4M12 11v10'/></svg></span><span class='l'>Units sold</span></div><div class='n'>" & _f1 & "</div><div class='d'><div class='r'><span>" & _l1 & "</span><b>" & _pf1 & "</b></div><div class='r' title='Week over week: the last 7 days of the selection against the 7 days before them.'><span>WoW</span><b style='color:" & _c1 & "'>" & _t1 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Items purchased, counting every unit in the basket.<b>WHY IT MATTERS</b>Volume. Units up with revenue flat means a cheaper mix or discounts.</div></div><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><path d='M3 12V3h9l9 9-9 9z'/><circle cx='7.5' cy='7.5' r='1.5'/></svg></span><span class='l'>Average item price</span></div><div class='n'>" & _f2 & "</div><div class='d'><div class='r'><span>" & _l2 & "</span><b>" & _pf2 & "</b></div><div class='r' title='Week over week: the last 7 days of the selection against the 7 days before them.'><span>WoW</span><b style='color:" & _c2 & "'>" & _t2 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Item revenue divided by units sold.<b>WHY IT MATTERS</b>A falling price with rising units often means promotions drove volume.</div></div><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><path d='M12 3l9 5-9 5-9-5z'/><path d='M3 13l9 5 9-5'/></svg></span><span class='l'>Distinct items sold</span></div><div class='n'>" & _f3 & "</div><div class='d'><div class='r'><span>" & _l3 & "</span><b>" & _pf3 & "</b></div><div class='r' title='Week over week: the last 7 days of the selection against the 7 days before them.'><span>WoW</span><b style='color:" & _c3 & "'>" & _t3 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Different products that sold at least once.<b>WHY IT MATTERS</b>Range. More products selling means less reliance on a few hero items.</div></div></div></body></html>"
	// [Pages\05 Products] — Alt text for the KPI strip.
	MEASURE '_Measures'[05 · 001 KPI Strip Alt Text] =
		"Item revenue " & "$" & IF([Item Revenue] >= 1E6, FORMAT([Item Revenue] / 1E6, "0.00") & "M", IF([Item Revenue] >= 1E4, FORMAT([Item Revenue] / 1E3, "0.0") & "K", FORMAT([Item Revenue], "#,##0"))) & " · " & "Units sold " & IF([Units Purchased] >= 1E6, FORMAT([Units Purchased] / 1E6, "0.00") & "M", IF([Units Purchased] >= 1E4, FORMAT([Units Purchased] / 1E3, "0.0") & "K", FORMAT([Units Purchased], "#,##0"))) & " · " & "Average item price " & "$" & FORMAT([Avg Item Price], "0.00") & " · " & "Distinct items sold " & IF([Items Sold] >= 1E6, FORMAT([Items Sold] / 1E6, "0.00") & "M", IF([Items Sold] >= 1E4, FORMAT([Items Sold] / 1E3, "0.0") & "K", FORMAT([Items Sold], "#,##0"))) & " (" & [Period Label] & ", " & [PP Label] & ")"
	// [Pages\04 Funnel] — HTML Content visual: horizontal funnel with step-to-step rates and the leak highlighted.
	MEASURE '_Measures'[04 · 002 Funnel HTML] =
		VAR _st = { (1, "Viewed a product", CALCULATE([View Item Sessions], KEEPFILTERS(DATESBETWEEN('Date'[date], [Cart Tracking Start], BLANK())))),
		            (2, "Added to cart", CALCULATE([Add to Cart Sessions], KEEPFILTERS(DATESBETWEEN('Date'[date], [Cart Tracking Start], BLANK())))),
		            (3, "Began checkout", CALCULATE([Begin Checkout Sessions], KEEPFILTERS(DATESBETWEEN('Date'[date], [Cart Tracking Start], BLANK())))),
		            (4, "Added payment", CALCULATE([Add Payment Info Sessions], KEEPFILTERS(DATESBETWEEN('Date'[date], [Cart Tracking Start], BLANK())))),
		            (5, "Purchased", CALCULATE([Purchase Sessions], KEEPFILTERS(DATESBETWEEN('Date'[date], [Cart Tracking Start], BLANK())))) }
		VAR _note = [Cart Window Note]
		VAR _top = MAXX(_st, [Value3])
		VAR _min = MINX(FILTER(_st, [Value1] > 1), VAR _i = [Value1] RETURN DIVIDE([Value3], MAXX(FILTER(_st, [Value1] = _i - 1), [Value3])))
		VAR _rows = CONCATENATEX(_st,
		    VAR _i = [Value1]
		    VAR _prev = MAXX(FILTER(_st, [Value1] = _i - 1), [Value3])
		    VAR _r = DIVIDE([Value3], _prev)
		    VAR _w = DIVIDE([Value3], _top)
		    VAR _leak = _i > 1 && _r = _min
		    RETURN
		    "<div class='r'><div class='lb'>" & [Value2] & "</div><div class='tr'><div class='b" & IF(_leak, " leak", "") &
		    "' style='width:" & FORMAT(MAX(_w, 0.02) * 100, "0.0") & "%'></div></div><div class='v'>" & FORMAT([Value3], "#,##0") &
		    "</div><div class='p" & IF(_leak, " leak", "") & "'>" & IF(_i = 1, "100%", FORMAT(_r, "0.0%")) & "</div></div>",
		    "", [Value1], ASC)
		RETURN
		"<!DOCTYPE html><html><head><meta charset='utf-8'><link href='https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap' rel='stylesheet'><style>*{box-sizing:border-box;margin:0;padding:0}html,body{height:100vh;overflow:hidden;background:transparent;font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:#1E1B4B}.c{height:100vh;background:#fff;border-radius:14px;padding:18px 20px;display:flex;flex-direction:column;gap:10px}.t{font-size:14px;font-weight:700}.s{font-size:10.5px;color:#5B5F86}.r{display:grid;grid-template-columns:120px 1fr 64px 52px;align-items:center;gap:10px;flex:1}.lb{font-size:11.5px;font-weight:600}.tr{height:100%;max-height:30px;background:#ECEDFD;border-radius:8px;overflow:hidden}.b{height:100%;background:#5B5BD6;border-radius:8px}.b.leak{background:#E5484D}.v{font-size:12px;font-weight:700;text-align:right}.p{font-size:11px;font-weight:700;color:#5B5F86;text-align:right}.p.leak{color:#E5484D}</style></head><body><div class='c'><div><div class='t'>Purchase funnel</div><div class='s'>Sessions reaching each step · % = step-to-step rate · red = biggest leak" & IF(NOT ISBLANK(_note), " · " & _note) & "</div></div>" & _rows & "</div></body></html>"
	// [Pages\04 Funnel]
	MEASURE '_Measures'[04 · 002 Funnel Alt Text] =
		"Funnel: " & FORMAT([View Item Sessions], "#,##0") & " viewed a product, " & FORMAT([Add to Cart Sessions], "#,##0") &
		" added to cart, " & FORMAT([Begin Checkout Sessions], "#,##0") & " began checkout, " & FORMAT([Add Payment Info Sessions], "#,##0") &
		" added payment, " & FORMAT([Purchase Sessions], "#,##0") & " purchased. Biggest drop: " & [Biggest Drop Step] & "."
	// [Base\Time] — Revenue from the 1st of the month to the last selected day. On a daily axis it is the running month total.
	MEASURE '_Measures'[Revenue MTD] =
		VAR _e = MAX('Date'[date])
		VAR _ms = DATE(YEAR(_e), MONTH(_e), 1)
		VAR _pms = EDATE(_ms, -1)
		VAR _pme = EDATE(_e, -1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN CALCULATE([Revenue], DATESBETWEEN('Date'[date], _ms, _e), REMOVEFILTERS('Date'))
	// [Base\Time] — Revenue for the same days of the previous month (blank before Dec 2020: no October data).
	MEASURE '_Measures'[Revenue PMTD] =
		VAR _e = MAX('Date'[date])
		VAR _ms = DATE(YEAR(_e), MONTH(_e), 1)
		VAR _pms = EDATE(_ms, -1)
		VAR _pme = EDATE(_e, -1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_pms >= _min, CALCULATE([Revenue], DATESBETWEEN('Date'[date], _pms, _pme), REMOVEFILTERS('Date')))
	// [Base\Time] — Month-to-date pacing of Revenue against the same days of the previous month.
	MEASURE '_Measures'[Revenue MTD vs PMTD %] =
		VAR _p = [Revenue PMTD]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Revenue MTD] - _p, _p))
	// [Base\Time] — Sessions from the 1st of the month to the last selected day. On a daily axis it is the running month total.
	MEASURE '_Measures'[Sessions MTD] =
		VAR _e = MAX('Date'[date])
		VAR _ms = DATE(YEAR(_e), MONTH(_e), 1)
		VAR _pms = EDATE(_ms, -1)
		VAR _pme = EDATE(_e, -1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN CALCULATE([Sessions], DATESBETWEEN('Date'[date], _ms, _e), REMOVEFILTERS('Date'))
	// [Base\Time] — Sessions for the same days of the previous month (blank before Dec 2020: no October data).
	MEASURE '_Measures'[Sessions PMTD] =
		VAR _e = MAX('Date'[date])
		VAR _ms = DATE(YEAR(_e), MONTH(_e), 1)
		VAR _pms = EDATE(_ms, -1)
		VAR _pme = EDATE(_e, -1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_pms >= _min, CALCULATE([Sessions], DATESBETWEEN('Date'[date], _pms, _pme), REMOVEFILTERS('Date')))
	// [Base\Time] — Month-to-date pacing of Sessions against the same days of the previous month.
	MEASURE '_Measures'[Sessions MTD vs PMTD %] =
		VAR _p = [Sessions PMTD]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Sessions MTD] - _p, _p))
	// [Base\Time] — Transactions from the 1st of the month to the last selected day. On a daily axis it is the running month total.
	MEASURE '_Measures'[Transactions MTD] =
		VAR _e = MAX('Date'[date])
		VAR _ms = DATE(YEAR(_e), MONTH(_e), 1)
		VAR _pms = EDATE(_ms, -1)
		VAR _pme = EDATE(_e, -1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN CALCULATE([Transactions], DATESBETWEEN('Date'[date], _ms, _e), REMOVEFILTERS('Date'))
	// [Base\Time] — Transactions for the same days of the previous month (blank before Dec 2020: no October data).
	MEASURE '_Measures'[Transactions PMTD] =
		VAR _e = MAX('Date'[date])
		VAR _ms = DATE(YEAR(_e), MONTH(_e), 1)
		VAR _pms = EDATE(_ms, -1)
		VAR _pme = EDATE(_e, -1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_pms >= _min, CALCULATE([Transactions], DATESBETWEEN('Date'[date], _pms, _pme), REMOVEFILTERS('Date')))
	// [Base\Time] — Month-to-date pacing of Transactions against the same days of the previous month.
	MEASURE '_Measures'[Transactions MTD vs PMTD %] =
		VAR _p = [Transactions PMTD]
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Transactions MTD] - _p, _p))
	// [Base\Time]
	MEASURE '_Measures'[Conversion Rate MTD] =
		VAR _e = MAX('Date'[date])
		VAR _ms = DATE(YEAR(_e), MONTH(_e), 1)
		VAR _pms = EDATE(_ms, -1)
		VAR _pme = EDATE(_e, -1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN CALCULATE([Conversion Rate], DATESBETWEEN('Date'[date], _ms, _e), REMOVEFILTERS('Date'))
	// [Base\Time]
	MEASURE '_Measures'[Conversion Rate PMTD] =
		VAR _e = MAX('Date'[date])
		VAR _ms = DATE(YEAR(_e), MONTH(_e), 1)
		VAR _pms = EDATE(_ms, -1)
		VAR _pme = EDATE(_e, -1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_pms >= _min, CALCULATE([Conversion Rate], DATESBETWEEN('Date'[date], _pms, _pme), REMOVEFILTERS('Date')))
	// [Base\Time]
	MEASURE '_Measures'[Conversion Rate MTD vs PMTD pts] =
		VAR _p = [Conversion Rate PMTD]
		RETURN IF(NOT ISBLANK(_p), ([Conversion Rate MTD] - _p) * 100)
	// [Base\Time] — Comparison label for MTD cards, e.g. 'vs Dec 1–31'.
	MEASURE '_Measures'[MTD Label] =
		VAR _e = MAX('Date'[date])
		VAR _ms = DATE(YEAR(_e), MONTH(_e), 1)
		VAR _pms = EDATE(_ms, -1)
		VAR _pme = EDATE(_e, -1)
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_pms < _min, "no prior month in data", "vs " & FORMAT(_pms, "mmm") & " 1–" & FORMAT(DAY(_pme), "0"))
	// [Base\Time] (hidden)
	MEASURE '_Measures'[Day of Month] =
		IF(HASONEVALUE('Date'[date]), DAY(MAX('Date'[date])))
	// [Base\Time] — Cumulative revenue from the first selected day.
	MEASURE '_Measures'[Revenue Running Total] =
		VAR _e = MAX('Date'[date])
		RETURN CALCULATE([Revenue], FILTER(ALLSELECTED('Date'), 'Date'[date] <= _e))
	// [Base\Time] — Share of the selection's revenue banked by this day.
	MEASURE '_Measures'[Revenue Running Share] =
		DIVIDE([Revenue Running Total], CALCULATE([Revenue], ALLSELECTED('Date')))
	// [Base\Time] — Trailing 7-day daily average of Revenue.
	MEASURE '_Measures'[Revenue 7D Avg] =
		VAR _e = MAX('Date'[date])
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 6 >= _min, DIVIDE(CALCULATE([Revenue], DATESBETWEEN('Date'[date], _e - 6, _e), REMOVEFILTERS('Date')), 7))
	// [Base\Time] — Trailing 28-day daily average of Revenue.
	MEASURE '_Measures'[Revenue 28D Avg] =
		VAR _e = MAX('Date'[date])
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 27 >= _min, DIVIDE(CALCULATE([Revenue], DATESBETWEEN('Date'[date], _e - 27, _e), REMOVEFILTERS('Date')), 28))
	// [Base\Time] — Trailing 7-day daily average of Sessions.
	MEASURE '_Measures'[Sessions 7D Avg] =
		VAR _e = MAX('Date'[date])
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 6 >= _min, DIVIDE(CALCULATE([Sessions], DATESBETWEEN('Date'[date], _e - 6, _e), REMOVEFILTERS('Date')), 7))
	// [Base\Time] — Trailing 28-day daily average of Sessions.
	MEASURE '_Measures'[Sessions 28D Avg] =
		VAR _e = MAX('Date'[date])
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 27 >= _min, DIVIDE(CALCULATE([Sessions], DATESBETWEEN('Date'[date], _e - 27, _e), REMOVEFILTERS('Date')), 28))
	// [Base\Time] — Conversion rate over the trailing 7 days (session-weighted, not an average of daily rates).
	MEASURE '_Measures'[Conversion Rate 7D] =
		VAR _e = MAX('Date'[date])
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		RETURN IF(_e - 6 >= _min, CALCULATE([Conversion Rate], DATESBETWEEN('Date'[date], _e - 6, _e), REMOVEFILTERS('Date')))
	// [Base\Time] — 7-day average vs 28-day average on the last selected day. Positive = accelerating.
	MEASURE '_Measures'[Revenue Momentum %] =
		VAR _l = [Revenue 28D Avg]
		RETURN IF(NOT ISBLANK(_l), DIVIDE([Revenue 7D Avg] - _l, _l))
	// [Base\Time]
	MEASURE '_Measures'[Sessions Momentum %] =
		VAR _l = [Sessions 28D Avg]
		RETURN IF(NOT ISBLANK(_l), DIVIDE([Sessions 7D Avg] - _l, _l))
	// [Pages\06 Time Intelligence] — Revenue vs the same days one week earlier (use on a week axis).
	MEASURE '_Measures'[Week Revenue WoW %] =
		VAR _s = MIN('Date'[date])
		VAR _e = MAX('Date'[date])
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		VAR _p = IF(_s - 7 >= _min, CALCULATE([Revenue], DATESBETWEEN('Date'[date], _s - 7, _e - 7), REMOVEFILTERS('Date')))
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Revenue] - _p, _p))
	// [Pages\06 Time Intelligence]
	MEASURE '_Measures'[Week Sessions WoW %] =
		VAR _s = MIN('Date'[date])
		VAR _e = MAX('Date'[date])
		VAR _min = CALCULATE(MIN('Date'[date]), REMOVEFILTERS('Date'))
		VAR _p = IF(_s - 7 >= _min, CALCULATE([Sessions], DATESBETWEEN('Date'[date], _s - 7, _e - 7), REMOVEFILTERS('Date')))
		RETURN IF(NOT ISBLANK(_p), DIVIDE([Sessions] - _p, _p))
	// [Pages\06 Time Intelligence] (hidden)
	MEASURE '_Measures'[Days in Row] =
		COUNTROWS('Date')
	// [Pages\06 Time Intelligence] — Revenue per calendar day in the row (fair across weekdays with different day counts).
	MEASURE '_Measures'[Avg Daily Revenue (Row)] =
		DIVIDE([Revenue], COUNTROWS('Date'))
	// [Pages\06 Time Intelligence]
	MEASURE '_Measures'[Avg Daily Sessions (Row)] =
		DIVIDE([Sessions], COUNTROWS('Date'))
	// [Pages\06 Time Intelligence] — Average daily revenue for the weekday ÷ average daily revenue overall. 1.2× = 20% above a typical day.
	MEASURE '_Measures'[Weekday Revenue Index] =
		DIVIDE([Avg Daily Revenue (Row)], CALCULATE([Avg Daily Revenue (Row)], ALLSELECTED('Date'[day_name], 'Date'[day_short], 'Date'[day_of_week_num], 'Date'[is_weekend])))
	// [Pages\06 Time Intelligence] — Weekday with the highest average daily revenue.
	MEASURE '_Measures'[Best Weekday] =
		VAR _t = ADDCOLUMNS(VALUES('Date'[day_name]), "@v", [Avg Daily Revenue (Row)])
		RETURN MAXX(TOPN(1, _t, [@v], DESC), 'Date'[day_name])
	// [Pages\06 Time Intelligence]
	MEASURE '_Measures'[Worst Weekday] =
		VAR _t = ADDCOLUMNS(VALUES('Date'[day_name]), "@v", [Avg Daily Revenue (Row)])
		RETURN MAXX(TOPN(1, _t, [@v], ASC), 'Date'[day_name])
	// [Pages\06 Time Intelligence]
	MEASURE '_Measures'[Best Weekday Index] =
		VAR _t = ADDCOLUMNS(VALUES('Date'[day_name]), "@v", [Weekday Revenue Index])
		RETURN MAXX(_t, [@v])
	// [Pages\06 Time Intelligence]
	MEASURE '_Measures'[Weekend Revenue Share] =
		DIVIDE(CALCULATE([Revenue], 'Date'[is_weekend] = TRUE()), [Revenue])
	// [Pages\06 Time Intelligence]
	MEASURE '_Measures'[Weekend Day Share] =
		DIVIDE(CALCULATE(COUNTROWS('Date'), 'Date'[is_weekend] = TRUE()), COUNTROWS('Date'))
	// [Pages\06 Time Intelligence]
	MEASURE '_Measures'[Weekend Conversion Rate] =
		CALCULATE([Conversion Rate], 'Date'[is_weekend] = TRUE())
	// [Pages\06 Time Intelligence]
	MEASURE '_Measures'[Weekday Conversion Rate] =
		CALCULATE([Conversion Rate], 'Date'[is_weekend] = FALSE())
	// [Pages\06 Time Intelligence] — Story headline for the time page: month pacing first, then momentum.
	MEASURE '_Measures'[06 Headline] =
		VAR _mtd = [Revenue MTD vs PMTD %]
		VAR _mom = [Revenue Momentum %]
		VAR _e = MAX('Date'[date])
		VAR _best = [Best Weekday]
		VAR _bi = [Best Weekday Index]
		RETURN
		SWITCH(TRUE(),
		    NOT ISBLANK(_mtd),
		        FORMAT(_e, "mmmm") & " revenue is pacing " & FORMAT(ABS(_mtd), "0%") & IF(_mtd >= 0, " ahead of ", " behind ") &
		        "the same days of " & FORMAT(EDATE(_e, -1), "mmmm") & IF(NOT ISBLANK(_mom), ", and the 7-day trend is " &
		        FORMAT(ABS(_mom), "0%") & IF(_mom >= 0, " above", " below") & " the 28-day average.", "."),
		    NOT ISBLANK(_mom),
		        "The 7-day revenue trend ends " & FORMAT(ABS(_mom), "0%") & IF(_mom >= 0, " above", " below") &
		        " the 28-day average; " & _best & "s earn " & FORMAT(_bi, "0.0") & "× a typical day.",
		    _best & "s earn " & FORMAT(_bi, "0.0") & "× a typical day's revenue.")
	// [Pages\06 Time Intelligence] — Header card: page title, story headline and the comparison period (date slicer sits on top, right).
	MEASURE '_Measures'[06 · 000 Headline HTML] =
		VAR _h = SUBSTITUTE(SUBSTITUTE([06 Headline], "&", "&amp;"), "<", "&lt;")
		VAR _c = FORMAT([Period Days], "0") & " days · " & IF(ISBLANK([PP Start]), "no earlier period in data", "compared " & SUBSTITUTE([PP Label], "vs ", "with "))
		RETURN
		"<!DOCTYPE html><html><head><meta charset='utf-8'><link href='https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cormorant+Garamond:ital,wght@1,400&display=swap' rel='stylesheet'><style>*{box-sizing:border-box;margin:0;padding:0}html,body{height:100vh;overflow:hidden;background:transparent;font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:#1A1840}.c{height:100vh;background:#fff;border:1px solid #ECEDF6;border-radius:16px;display:flex;justify-content:space-between;align-items:center;padding:0 22px;gap:24px}.t{display:flex;align-items:center;gap:10px}.n{font-size:10px;font-weight:800;color:#5B5BD6;background:#EEEFFD;border-radius:6px;padding:3px 7px;letter-spacing:.06em}h1{font-size:19px;font-weight:800;letter-spacing:-.3px}p{font-size:12px;line-height:1.5;color:#5E6189;margin-top:5px;max-width:640px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.r{align-self:flex-end;margin-bottom:12px;font-size:10.5px;color:#9A9DC0;white-space:nowrap}</style></head><body><div class='c'><div><div class='t'><span class='n'>06</span><h1>Time Intelligence</h1></div><p>" & _h & "</p></div><div class='r'>" & _c & "</div></div></body></html>"
	// [Pages\06 Time Intelligence] — HTML Content visual: 7/14/28-day windows ending on the last selected day vs the window before, for six metrics.
	MEASURE '_Measures'[06 · 003 Rolling Table HTML] =
		"<!DOCTYPE html><html><head><meta charset='utf-8'><link href='https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap' rel='stylesheet'><style>*{box-sizing:border-box;margin:0;padding:0}html,body{height:100vh;overflow:hidden;background:transparent;font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:#1E1B4B}table{width:100%;border-collapse:collapse;font-size:11.5px}thead th{font-size:9.5px;font-weight:700;letter-spacing:1px;color:#5B5F86;text-align:right;padding:6px 8px;border-bottom:1px solid #E6E7F5}thead tr:first-child th{text-align:center;color:#5B5BD6;border-bottom:none}tbody th{text-align:left;font-weight:600;padding:8px}td{text-align:right;padding:8px;border-bottom:1px solid #F2F3FA}td.p{color:#9A9DC0}.g,.b,.n{font-size:10px;font-weight:700;padding:3px 7px;border-radius:99px}.g{background:#E3F6EF;color:#0E9F6E}.b{background:#FDE8E8;color:#E5484D}.n{color:#9A9DC0}</style></head><body><table><thead><tr><th></th><th colspan='3'>LAST 7 DAYS</th><th colspan='3'>LAST 14 DAYS</th><th colspan='3'>LAST 28 DAYS</th></tr><tr><th style='text-align:left'>METRIC</th><th>VALUE</th><th>PRIOR</th><th>CHANGE</th><th>VALUE</th><th>PRIOR</th><th>CHANGE</th><th>VALUE</th><th>PRIOR</th><th>CHANGE</th></tr></thead><tbody>" & "<tr><th>Sessions</th>" & "<td>" & IF([Sessions L7D] >= 1E6, FORMAT([Sessions L7D] / 1E6, "0.00") & "M", IF([Sessions L7D] >= 1E4, FORMAT([Sessions L7D] / 1E3, "0.0") & "K", FORMAT([Sessions L7D], "#,##0"))) & "</td><td class='p'>" & IF(ISBLANK([Sessions P7D]), "—", IF([Sessions P7D] >= 1E6, FORMAT([Sessions P7D] / 1E6, "0.00") & "M", IF([Sessions P7D] >= 1E4, FORMAT([Sessions P7D] / 1E3, "0.0") & "K", FORMAT([Sessions P7D], "#,##0")))) & "</td><td><span class='" & IF(ISBLANK([Sessions L7D Δ%]), "n", IF([Sessions L7D Δ%] >= 0, "g", "b")) & "'>" & IF(ISBLANK([Sessions L7D Δ%]), "—", IF([Sessions L7D Δ%] >= 0, "▲ +", "▼ −") & FORMAT(ABS([Sessions L7D Δ%]), "0.0%")) & "</span></td>" & "<td>" & IF([Sessions L14D] >= 1E6, FORMAT([Sessions L14D] / 1E6, "0.00") & "M", IF([Sessions L14D] >= 1E4, FORMAT([Sessions L14D] / 1E3, "0.0") & "K", FORMAT([Sessions L14D], "#,##0"))) & "</td><td class='p'>" & IF(ISBLANK([Sessions P14D]), "—", IF([Sessions P14D] >= 1E6, FORMAT([Sessions P14D] / 1E6, "0.00") & "M", IF([Sessions P14D] >= 1E4, FORMAT([Sessions P14D] / 1E3, "0.0") & "K", FORMAT([Sessions P14D], "#,##0")))) & "</td><td><span class='" & IF(ISBLANK([Sessions L14D Δ%]), "n", IF([Sessions L14D Δ%] >= 0, "g", "b")) & "'>" & IF(ISBLANK([Sessions L14D Δ%]), "—", IF([Sessions L14D Δ%] >= 0, "▲ +", "▼ −") & FORMAT(ABS([Sessions L14D Δ%]), "0.0%")) & "</span></td>" & "<td>" & IF([Sessions L28D] >= 1E6, FORMAT([Sessions L28D] / 1E6, "0.00") & "M", IF([Sessions L28D] >= 1E4, FORMAT([Sessions L28D] / 1E3, "0.0") & "K", FORMAT([Sessions L28D], "#,##0"))) & "</td><td class='p'>" & IF(ISBLANK([Sessions P28D]), "—", IF([Sessions P28D] >= 1E6, FORMAT([Sessions P28D] / 1E6, "0.00") & "M", IF([Sessions P28D] >= 1E4, FORMAT([Sessions P28D] / 1E3, "0.0") & "K", FORMAT([Sessions P28D], "#,##0")))) & "</td><td><span class='" & IF(ISBLANK([Sessions L28D Δ%]), "n", IF([Sessions L28D Δ%] >= 0, "g", "b")) & "'>" & IF(ISBLANK([Sessions L28D Δ%]), "—", IF([Sessions L28D Δ%] >= 0, "▲ +", "▼ −") & FORMAT(ABS([Sessions L28D Δ%]), "0.0%")) & "</span></td>" & "</tr>" & "<tr><th>Pageviews</th>" & "<td>" & IF([Pageviews L7D] >= 1E6, FORMAT([Pageviews L7D] / 1E6, "0.00") & "M", IF([Pageviews L7D] >= 1E4, FORMAT([Pageviews L7D] / 1E3, "0.0") & "K", FORMAT([Pageviews L7D], "#,##0"))) & "</td><td class='p'>" & IF(ISBLANK([Pageviews P7D]), "—", IF([Pageviews P7D] >= 1E6, FORMAT([Pageviews P7D] / 1E6, "0.00") & "M", IF([Pageviews P7D] >= 1E4, FORMAT([Pageviews P7D] / 1E3, "0.0") & "K", FORMAT([Pageviews P7D], "#,##0")))) & "</td><td><span class='" & IF(ISBLANK([Pageviews L7D Δ%]), "n", IF([Pageviews L7D Δ%] >= 0, "g", "b")) & "'>" & IF(ISBLANK([Pageviews L7D Δ%]), "—", IF([Pageviews L7D Δ%] >= 0, "▲ +", "▼ −") & FORMAT(ABS([Pageviews L7D Δ%]), "0.0%")) & "</span></td>" & "<td>" & IF([Pageviews L14D] >= 1E6, FORMAT([Pageviews L14D] / 1E6, "0.00") & "M", IF([Pageviews L14D] >= 1E4, FORMAT([Pageviews L14D] / 1E3, "0.0") & "K", FORMAT([Pageviews L14D], "#,##0"))) & "</td><td class='p'>" & IF(ISBLANK([Pageviews P14D]), "—", IF([Pageviews P14D] >= 1E6, FORMAT([Pageviews P14D] / 1E6, "0.00") & "M", IF([Pageviews P14D] >= 1E4, FORMAT([Pageviews P14D] / 1E3, "0.0") & "K", FORMAT([Pageviews P14D], "#,##0")))) & "</td><td><span class='" & IF(ISBLANK([Pageviews L14D Δ%]), "n", IF([Pageviews L14D Δ%] >= 0, "g", "b")) & "'>" & IF(ISBLANK([Pageviews L14D Δ%]), "—", IF([Pageviews L14D Δ%] >= 0, "▲ +", "▼ −") & FORMAT(ABS([Pageviews L14D Δ%]), "0.0%")) & "</span></td>" & "<td>" & IF([Pageviews L28D] >= 1E6, FORMAT([Pageviews L28D] / 1E6, "0.00") & "M", IF([Pageviews L28D] >= 1E4, FORMAT([Pageviews L28D] / 1E3, "0.0") & "K", FORMAT([Pageviews L28D], "#,##0"))) & "</td><td class='p'>" & IF(ISBLANK([Pageviews P28D]), "—", IF([Pageviews P28D] >= 1E6, FORMAT([Pageviews P28D] / 1E6, "0.00") & "M", IF([Pageviews P28D] >= 1E4, FORMAT([Pageviews P28D] / 1E3, "0.0") & "K", FORMAT([Pageviews P28D], "#,##0")))) & "</td><td><span class='" & IF(ISBLANK([Pageviews L28D Δ%]), "n", IF([Pageviews L28D Δ%] >= 0, "g", "b")) & "'>" & IF(ISBLANK([Pageviews L28D Δ%]), "—", IF([Pageviews L28D Δ%] >= 0, "▲ +", "▼ −") & FORMAT(ABS([Pageviews L28D Δ%]), "0.0%")) & "</span></td>" & "</tr>" & "<tr><th>Transactions</th>" & "<td>" & IF([Transactions L7D] >= 1E6, FORMAT([Transactions L7D] / 1E6, "0.00") & "M", IF([Transactions L7D] >= 1E4, FORMAT([Transactions L7D] / 1E3, "0.0") & "K", FORMAT([Transactions L7D], "#,##0"))) & "</td><td class='p'>" & IF(ISBLANK([Transactions P7D]), "—", IF([Transactions P7D] >= 1E6, FORMAT([Transactions P7D] / 1E6, "0.00") & "M", IF([Transactions P7D] >= 1E4, FORMAT([Transactions P7D] / 1E3, "0.0") & "K", FORMAT([Transactions P7D], "#,##0")))) & "</td><td><span class='" & IF(ISBLANK([Transactions L7D Δ%]), "n", IF([Transactions L7D Δ%] >= 0, "g", "b")) & "'>" & IF(ISBLANK([Transactions L7D Δ%]), "—", IF([Transactions L7D Δ%] >= 0, "▲ +", "▼ −") & FORMAT(ABS([Transactions L7D Δ%]), "0.0%")) & "</span></td>" & "<td>" & IF([Transactions L14D] >= 1E6, FORMAT([Transactions L14D] / 1E6, "0.00") & "M", IF([Transactions L14D] >= 1E4, FORMAT([Transactions L14D] / 1E3, "0.0") & "K", FORMAT([Transactions L14D], "#,##0"))) & "</td><td class='p'>" & IF(ISBLANK([Transactions P14D]), "—", IF([Transactions P14D] >= 1E6, FORMAT([Transactions P14D] / 1E6, "0.00") & "M", IF([Transactions P14D] >= 1E4, FORMAT([Transactions P14D] / 1E3, "0.0") & "K", FORMAT([Transactions P14D], "#,##0")))) & "</td><td><span class='" & IF(ISBLANK([Transactions L14D Δ%]), "n", IF([Transactions L14D Δ%] >= 0, "g", "b")) & "'>" & IF(ISBLANK([Transactions L14D Δ%]), "—", IF([Transactions L14D Δ%] >= 0, "▲ +", "▼ −") & FORMAT(ABS([Transactions L14D Δ%]), "0.0%")) & "</span></td>" & "<td>" & IF([Transactions L28D] >= 1E6, FORMAT([Transactions L28D] / 1E6, "0.00") & "M", IF([Transactions L28D] >= 1E4, FORMAT([Transactions L28D] / 1E3, "0.0") & "K", FORMAT([Transactions L28D], "#,##0"))) & "</td><td class='p'>" & IF(ISBLANK([Transactions P28D]), "—", IF([Transactions P28D] >= 1E6, FORMAT([Transactions P28D] / 1E6, "0.00") & "M", IF([Transactions P28D] >= 1E4, FORMAT([Transactions P28D] / 1E3, "0.0") & "K", FORMAT([Transactions P28D], "#,##0")))) & "</td><td><span class='" & IF(ISBLANK([Transactions L28D Δ%]), "n", IF([Transactions L28D Δ%] >= 0, "g", "b")) & "'>" & IF(ISBLANK([Transactions L28D Δ%]), "—", IF([Transactions L28D Δ%] >= 0, "▲ +", "▼ −") & FORMAT(ABS([Transactions L28D Δ%]), "0.0%")) & "</span></td>" & "</tr>" & "<tr><th>Revenue</th>" & "<td>" & "$" & IF([Revenue L7D] >= 1E6, FORMAT([Revenue L7D] / 1E6, "0.00") & "M", IF([Revenue L7D] >= 1E4, FORMAT([Revenue L7D] / 1E3, "0.0") & "K", FORMAT([Revenue L7D], "#,##0"))) & "</td><td class='p'>" & IF(ISBLANK([Revenue P7D]), "—", "$" & IF([Revenue P7D] >= 1E6, FORMAT([Revenue P7D] / 1E6, "0.00") & "M", IF([Revenue P7D] >= 1E4, FORMAT([Revenue P7D] / 1E3, "0.0") & "K", FORMAT([Revenue P7D], "#,##0")))) & "</td><td><span class='" & IF(ISBLANK([Revenue L7D Δ%]), "n", IF([Revenue L7D Δ%] >= 0, "g", "b")) & "'>" & IF(ISBLANK([Revenue L7D Δ%]), "—", IF([Revenue L7D Δ%] >= 0, "▲ +", "▼ −") & FORMAT(ABS([Revenue L7D Δ%]), "0.0%")) & "</span></td>" & "<td>" & "$" & IF([Revenue L14D] >= 1E6, FORMAT([Revenue L14D] / 1E6, "0.00") & "M", IF([Revenue L14D] >= 1E4, FORMAT([Revenue L14D] / 1E3, "0.0") & "K", FORMAT([Revenue L14D], "#,##0"))) & "</td><td class='p'>" & IF(ISBLANK([Revenue P14D]), "—", "$" & IF([Revenue P14D] >= 1E6, FORMAT([Revenue P14D] / 1E6, "0.00") & "M", IF([Revenue P14D] >= 1E4, FORMAT([Revenue P14D] / 1E3, "0.0") & "K", FORMAT([Revenue P14D], "#,##0")))) & "</td><td><span class='" & IF(ISBLANK([Revenue L14D Δ%]), "n", IF([Revenue L14D Δ%] >= 0, "g", "b")) & "'>" & IF(ISBLANK([Revenue L14D Δ%]), "—", IF([Revenue L14D Δ%] >= 0, "▲ +", "▼ −") & FORMAT(ABS([Revenue L14D Δ%]), "0.0%")) & "</span></td>" & "<td>" & "$" & IF([Revenue L28D] >= 1E6, FORMAT([Revenue L28D] / 1E6, "0.00") & "M", IF([Revenue L28D] >= 1E4, FORMAT([Revenue L28D] / 1E3, "0.0") & "K", FORMAT([Revenue L28D], "#,##0"))) & "</td><td class='p'>" & IF(ISBLANK([Revenue P28D]), "—", "$" & IF([Revenue P28D] >= 1E6, FORMAT([Revenue P28D] / 1E6, "0.00") & "M", IF([Revenue P28D] >= 1E4, FORMAT([Revenue P28D] / 1E3, "0.0") & "K", FORMAT([Revenue P28D], "#,##0")))) & "</td><td><span class='" & IF(ISBLANK([Revenue L28D Δ%]), "n", IF([Revenue L28D Δ%] >= 0, "g", "b")) & "'>" & IF(ISBLANK([Revenue L28D Δ%]), "—", IF([Revenue L28D Δ%] >= 0, "▲ +", "▼ −") & FORMAT(ABS([Revenue L28D Δ%]), "0.0%")) & "</span></td>" & "</tr>" & "<tr><th>Conversion Rate</th>" & "<td>" & FORMAT([Conversion Rate L7D], "0.00%") & "</td><td class='p'>" & IF(ISBLANK([Conversion Rate P7D]), "—", FORMAT([Conversion Rate P7D], "0.00%")) & "</td><td><span class='" & IF(ISBLANK([Conversion Rate L7D Δ pts]), "n", IF([Conversion Rate L7D Δ pts] >= 0, "g", "b")) & "'>" & IF(ISBLANK([Conversion Rate L7D Δ pts]), "—", IF([Conversion Rate L7D Δ pts] >= 0, "▲ +", "▼ −") & FORMAT(ABS([Conversion Rate L7D Δ pts]), "0.00") & " pts") & "</span></td>" & "<td>" & FORMAT([Conversion Rate L14D], "0.00%") & "</td><td class='p'>" & IF(ISBLANK([Conversion Rate P14D]), "—", FORMAT([Conversion Rate P14D], "0.00%")) & "</td><td><span class='" & IF(ISBLANK([Conversion Rate L14D Δ pts]), "n", IF([Conversion Rate L14D Δ pts] >= 0, "g", "b")) & "'>" & IF(ISBLANK([Conversion Rate L14D Δ pts]), "—", IF([Conversion Rate L14D Δ pts] >= 0, "▲ +", "▼ −") & FORMAT(ABS([Conversion Rate L14D Δ pts]), "0.00") & " pts") & "</span></td>" & "<td>" & FORMAT([Conversion Rate L28D], "0.00%") & "</td><td class='p'>" & IF(ISBLANK([Conversion Rate P28D]), "—", FORMAT([Conversion Rate P28D], "0.00%")) & "</td><td><span class='" & IF(ISBLANK([Conversion Rate L28D Δ pts]), "n", IF([Conversion Rate L28D Δ pts] >= 0, "g", "b")) & "'>" & IF(ISBLANK([Conversion Rate L28D Δ pts]), "—", IF([Conversion Rate L28D Δ pts] >= 0, "▲ +", "▼ −") & FORMAT(ABS([Conversion Rate L28D Δ pts]), "0.00") & " pts") & "</span></td>" & "</tr>" & "<tr><th>AOV</th>" & "<td>" & "$" & FORMAT([AOV L7D], "0.00") & "</td><td class='p'>" & IF(ISBLANK([AOV P7D]), "—", "$" & FORMAT([AOV P7D], "0.00")) & "</td><td><span class='" & IF(ISBLANK([AOV L7D Δ%]), "n", IF([AOV L7D Δ%] >= 0, "g", "b")) & "'>" & IF(ISBLANK([AOV L7D Δ%]), "—", IF([AOV L7D Δ%] >= 0, "▲ +", "▼ −") & FORMAT(ABS([AOV L7D Δ%]), "0.0%")) & "</span></td>" & "<td>" & "$" & FORMAT([AOV L14D], "0.00") & "</td><td class='p'>" & IF(ISBLANK([AOV P14D]), "—", "$" & FORMAT([AOV P14D], "0.00")) & "</td><td><span class='" & IF(ISBLANK([AOV L14D Δ%]), "n", IF([AOV L14D Δ%] >= 0, "g", "b")) & "'>" & IF(ISBLANK([AOV L14D Δ%]), "—", IF([AOV L14D Δ%] >= 0, "▲ +", "▼ −") & FORMAT(ABS([AOV L14D Δ%]), "0.0%")) & "</span></td>" & "<td>" & "$" & FORMAT([AOV L28D], "0.00") & "</td><td class='p'>" & IF(ISBLANK([AOV P28D]), "—", "$" & FORMAT([AOV P28D], "0.00")) & "</td><td><span class='" & IF(ISBLANK([AOV L28D Δ%]), "n", IF([AOV L28D Δ%] >= 0, "g", "b")) & "'>" & IF(ISBLANK([AOV L28D Δ%]), "—", IF([AOV L28D Δ%] >= 0, "▲ +", "▼ −") & FORMAT(ABS([AOV L28D Δ%]), "0.0%")) & "</span></td>" & "</tr>" & "</tbody></table></body></html>"
	// [Pages\06 Time Intelligence]
	MEASURE '_Measures'[06 · 003 Rolling Table Alt Text] =
		"Last 7 days: revenue " & FORMAT([Revenue L7D], "$#,##0") & " (" & FORMAT([Revenue WoW %], "+0%;-0%") & "), last 28 days: revenue " & FORMAT([Revenue L28D], "$#,##0") & " (" & FORMAT([Revenue L28D Δ%], "+0%;-0%") & ")."
	// [Pages\06 Time Intelligence] — HTML Content visual. KPI cards: icon, value, last-7-day value and week-over-week change, hover card with what it is and why it matters.
	MEASURE '_Measures'[06 · 001 KPI Strip HTML] =
		VAR _v0 = [Revenue MTD]
		VAR _d0 = [Revenue MTD vs PMTD %]
		VAR _p0 = [Revenue PMTD]
		VAR _l0 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE([MTD Label], "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f0 = IF(ISBLANK(_v0), "—", "$" & IF(_v0 >= 1E6, FORMAT(_v0 / 1E6, "0.00") & "M", IF(_v0 >= 1E4, FORMAT(_v0 / 1E3, "0.0") & "K", FORMAT(_v0, "#,##0"))))
		VAR _pf0 = IF(ISBLANK(_p0), "not in data", "$" & IF(_p0 >= 1E6, FORMAT(_p0 / 1E6, "0.00") & "M", IF(_p0 >= 1E4, FORMAT(_p0 / 1E3, "0.0") & "K", FORMAT(_p0, "#,##0"))))
		VAR _c0 = IF(ISBLANK(_d0), "#9A9DC0", IF(_d0 * 1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t0 = IF(ISBLANK(_d0), "—", IF(_d0 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d0), "0.0%"))
		VAR _v1 = [Sessions MTD]
		VAR _d1 = [Sessions MTD vs PMTD %]
		VAR _p1 = [Sessions PMTD]
		VAR _l1 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE([MTD Label], "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f1 = IF(ISBLANK(_v1), "—", IF(_v1 >= 1E6, FORMAT(_v1 / 1E6, "0.00") & "M", IF(_v1 >= 1E4, FORMAT(_v1 / 1E3, "0.0") & "K", FORMAT(_v1, "#,##0"))))
		VAR _pf1 = IF(ISBLANK(_p1), "not in data", IF(_p1 >= 1E6, FORMAT(_p1 / 1E6, "0.00") & "M", IF(_p1 >= 1E4, FORMAT(_p1 / 1E3, "0.0") & "K", FORMAT(_p1, "#,##0"))))
		VAR _c1 = IF(ISBLANK(_d1), "#9A9DC0", IF(_d1 * 1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t1 = IF(ISBLANK(_d1), "—", IF(_d1 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d1), "0.0%"))
		VAR _v2 = [Conversion Rate MTD]
		VAR _d2 = [Conversion Rate MTD vs PMTD pts]
		VAR _p2 = [Conversion Rate PMTD]
		VAR _l2 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE([MTD Label], "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f2 = IF(ISBLANK(_v2), "—", FORMAT(_v2, "0.00%"))
		VAR _pf2 = IF(ISBLANK(_p2), "not in data", FORMAT(_p2, "0.00%"))
		VAR _c2 = IF(ISBLANK(_d2), "#9A9DC0", IF(_d2 * 1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t2 = IF(ISBLANK(_d2), "—", IF(_d2 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d2), "0.00") & " pts")
		VAR _v3 = [Revenue L7D]
		VAR _d3 = [Revenue WoW %]
		VAR _p3 = [Revenue P7D]
		VAR _l3 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Prior 7 days", "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f3 = IF(ISBLANK(_v3), "—", "$" & IF(_v3 >= 1E6, FORMAT(_v3 / 1E6, "0.00") & "M", IF(_v3 >= 1E4, FORMAT(_v3 / 1E3, "0.0") & "K", FORMAT(_v3, "#,##0"))))
		VAR _pf3 = IF(ISBLANK(_p3), "not in data", "$" & IF(_p3 >= 1E6, FORMAT(_p3 / 1E6, "0.00") & "M", IF(_p3 >= 1E4, FORMAT(_p3 / 1E3, "0.0") & "K", FORMAT(_p3, "#,##0"))))
		VAR _c3 = IF(ISBLANK(_d3), "#9A9DC0", IF(_d3 * 1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t3 = IF(ISBLANK(_d3), "—", IF(_d3 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d3), "0.0%"))
		VAR _v4 = [Revenue 7D Avg]
		VAR _d4 = [Revenue Momentum %]
		VAR _p4 = [Revenue 28D Avg]
		VAR _l4 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("28-day average", "vs ", ""), "no earlier period in data", "Prior period"), "no prior month in data", "Prior month")
		VAR _f4 = IF(ISBLANK(_v4), "—", "$" & IF(_v4 >= 1E6, FORMAT(_v4 / 1E6, "0.00") & "M", IF(_v4 >= 1E4, FORMAT(_v4 / 1E3, "0.0") & "K", FORMAT(_v4, "#,##0"))))
		VAR _pf4 = IF(ISBLANK(_p4), "not in data", "$" & IF(_p4 >= 1E6, FORMAT(_p4 / 1E6, "0.00") & "M", IF(_p4 >= 1E4, FORMAT(_p4 / 1E3, "0.0") & "K", FORMAT(_p4, "#,##0"))))
		VAR _c4 = IF(ISBLANK(_d4), "#9A9DC0", IF(_d4 * 1 >= 0, "#0E9F6E", "#E5484D"))
		VAR _t4 = IF(ISBLANK(_d4), "—", IF(_d4 >= 0, "▲ +", "▼ −") & FORMAT(ABS(_d4), "0.0%"))
		RETURN
		"<!DOCTYPE html><html><head><meta charset='utf-8'><link href='https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cormorant+Garamond:ital,wght@1,400&display=swap' rel='stylesheet'><style>*{box-sizing:border-box;margin:0;padding:0}html,body{height:100vh;overflow:hidden;background:transparent;font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:#1A1840}.row{display:flex;gap:12px;height:100vh;padding:1px}.k{position:relative;overflow:hidden;flex:1;min-width:0;background:#fff;border:1px solid #ECEDF6;border-radius:16px;padding:14px 16px 12px;display:flex;flex-direction:column;box-shadow:0 1px 2px rgba(26,24,64,.04)}.h{display:flex;align-items:center;gap:9px}.i{width:26px;height:26px;border-radius:8px;background:#EEEFFD;display:grid;place-items:center;flex:none}.i svg{width:14px;height:14px;stroke:#5B5BD6;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.l{font-size:11px;font-weight:600;color:#5E6189;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.n{font-size:25px;font-weight:800;letter-spacing:-.6px;margin-top:7px;line-height:1}.d{border-top:1px solid #ECEDF6;margin-top:auto;padding-top:7px;display:flex;flex-direction:column;gap:3px}.r{display:flex;justify-content:space-between;gap:8px;font-size:10px}.r span{color:#9A9DC0;font-weight:600;letter-spacing:.04em;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.r b{font-weight:700;white-space:nowrap;color:#5E6189}.w{position:absolute;inset:0;background:#1A1840;color:#fff;padding:12px 14px;font-size:10px;line-height:1.45;opacity:0;transition:opacity .2s;pointer-events:none;border-radius:16px}.w b{display:block;font-size:8.5px;letter-spacing:.12em;color:#C9CAF5;margin:6px 0 2px}.w b:first-child{margin-top:0}.k:hover .w{opacity:1}</style></head><body><div class='row'><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><path d='M12 2v20M17 6.5C17 4.6 14.8 4 12 4S7 5 7 7.5 9.5 10.5 12 11s5 1.5 5 4-2.2 3.5-5 3.5-5-.8-5-2.8'/></svg></span><span class='l'>Revenue MTD</span></div><div class='n'>" & _f0 & "</div><div class='d'><div class='r'><span>" & _l0 & "</span><b>" & _pf0 & "</b></div><div class='r' title=''><span>Change</span><b style='color:" & _c0 & "'>" & _t0 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Revenue from the 1st of the month to the last selected day.<b>WHY IT MATTERS</b>Pace this month, against the same days of the previous month.</div></div><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><circle cx='9' cy='8' r='3.5'/><path d='M2.5 20a6.5 6.5 0 0 1 13 0'/><path d='M16 4.5a3.5 3.5 0 0 1 0 7M18.5 20a6.5 6.5 0 0 0-3-5.5'/></svg></span><span class='l'>Sessions MTD</span></div><div class='n'>" & _f1 & "</div><div class='d'><div class='r'><span>" & _l1 & "</span><b>" & _pf1 & "</b></div><div class='r' title=''><span>Change</span><b style='color:" & _c1 & "'>" & _t1 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Sessions from the 1st of the month to the last selected day.<b>WHY IT MATTERS</b>Traffic pace this month, against the same days last month.</div></div><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><circle cx='12' cy='12' r='9'/><circle cx='12' cy='12' r='5'/><circle cx='12' cy='12' r='1'/></svg></span><span class='l'>Conversion MTD</span></div><div class='n'>" & _f2 & "</div><div class='d'><div class='r'><span>" & _l2 & "</span><b>" & _pf2 & "</b></div><div class='r' title=''><span>Change</span><b style='color:" & _c2 & "'>" & _t2 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Sessions with a purchase divided by all sessions, month to date.<b>WHY IT MATTERS</b>Is buying getting easier or harder this month?</div></div><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><rect x='3' y='5' width='18' height='16' rx='2'/><path d='M3 10h18M8 3v4M16 3v4'/></svg></span><span class='l'>Revenue last 7 days</span></div><div class='n'>" & _f3 & "</div><div class='d'><div class='r'><span>" & _l3 & "</span><b>" & _pf3 & "</b></div><div class='r' title=''><span>Change</span><b style='color:" & _c3 & "'>" & _t3 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Revenue in the 7 days ending on the last selected day.<b>WHY IT MATTERS</b>The latest week. The change shows week over week.</div></div><div class='k'><div class='h'><span class='i'><svg viewBox='0 0 24 24'><path d='M13 2L4 14h7l-1 8 9-12h-7z'/></svg></span><span class='l'>Revenue 7-day average</span></div><div class='n'>" & _f4 & "</div><div class='d'><div class='r'><span>" & _l4 & "</span><b>" & _pf4 & "</b></div><div class='r' title=''><span>Change</span><b style='color:" & _c4 & "'>" & _t4 & "</b></div></div><div class='w'><b>WHAT IT IS</b>Average daily revenue over the last 7 days.<b>WHY IT MATTERS</b>Above the 28-day average means the business is accelerating.</div></div></div></body></html>"
	// [Pages\06 Time Intelligence] — Alt text for the KPI strip.
	MEASURE '_Measures'[06 · 001 KPI Strip Alt Text] =
		"Revenue MTD " & "$" & IF([Revenue MTD] >= 1E6, FORMAT([Revenue MTD] / 1E6, "0.00") & "M", IF([Revenue MTD] >= 1E4, FORMAT([Revenue MTD] / 1E3, "0.0") & "K", FORMAT([Revenue MTD], "#,##0"))) & " · " & "Sessions MTD " & IF([Sessions MTD] >= 1E6, FORMAT([Sessions MTD] / 1E6, "0.00") & "M", IF([Sessions MTD] >= 1E4, FORMAT([Sessions MTD] / 1E3, "0.0") & "K", FORMAT([Sessions MTD], "#,##0"))) & " · " & "Conversion MTD " & FORMAT([Conversion Rate MTD], "0.00%") & " · " & "Revenue last 7 days " & "$" & IF([Revenue L7D] >= 1E6, FORMAT([Revenue L7D] / 1E6, "0.00") & "M", IF([Revenue L7D] >= 1E4, FORMAT([Revenue L7D] / 1E3, "0.0") & "K", FORMAT([Revenue L7D], "#,##0"))) & " · " & "Revenue 7-day average " & "$" & IF([Revenue 7D Avg] >= 1E6, FORMAT([Revenue 7D Avg] / 1E6, "0.00") & "M", IF([Revenue 7D Avg] >= 1E4, FORMAT([Revenue 7D Avg] / 1E3, "0.0") & "K", FORMAT([Revenue 7D Avg], "#,##0"))) & " (" & [Period Label] & ", " & [PP Label] & ")"
	// [Pages\00 Welcome] — One-line scope of the dataset for the cover page (ignores slicers).
	MEASURE '_Measures'[00 Welcome Facts] =
		"92 days · " & FORMAT(CALCULATE([Sessions], REMOVEFILTERS('Date')), "#,##0") & " sessions · " &
		FORMAT(CALCULATE([Revenue], REMOVEFILTERS('Date')), "$#,##0") & " revenue · " &
		FORMAT(CALCULATE([Transactions], REMOVEFILTERS('Date')), "#,##0") & " orders"
	// [Pages\00 Welcome] — Cover page hero. Daily revenue (3-day average) is drawn as an animated light trail; weekly sessions as a faint skyline. Ignores slicers.
	MEASURE '_Measures'[00 · 001 Cover HTML] =
		VAR _d = ADDCOLUMNS(FILTER(CALCULATETABLE(VALUES('Date'[date]), REMOVEFILTERS('Date')), NOT ISBLANK('Date'[date])), "@r",
		    VAR _x = 'Date'[date] RETURN DIVIDE(CALCULATE([Revenue], DATESBETWEEN('Date'[date], _x - 2, _x), REMOVEFILTERS('Date')), 3))
		VAR _min = MINX(_d, 'Date'[date])
		VAR _n = COUNTROWS(_d)
		VAR _mx = MAXX(_d, [@r])
		VAR _path = "M" & CONCATENATEX(_d, FORMAT(90 + INT('Date'[date] - _min) * 1100 / (_n - 1), "0.0") & "," & FORMAT(600 - DIVIDE([@r], _mx) * 150, "0.0"), " L", 'Date'[date], ASC)
		VAR _pk = TOPN(1, _d, [@r], DESC)
		VAR _px = FORMAT(90 + INT(MAXX(_pk, 'Date'[date]) - _min) * 1100 / (_n - 1), "0.0")
		VAR _py = FORMAT(600 - DIVIDE(MAXX(_pk, [@r]), _mx) * 150, "0.0")
		VAR _w = FILTER(ADDCOLUMNS(FILTER(CALCULATETABLE(VALUES('Date'[week_start]), REMOVEFILTERS('Date')), NOT ISBLANK('Date'[week_start])), "@n", CALCULATE(COUNTROWS('Date')), "@s", CALCULATE([Sessions])), [@n] = 7)
		VAR _ms = MAXX(_w, [@s])
		VAR _nw = COUNTROWS(_w)
		VAR _bars = CONCATENATEX(_w,
		    VAR _i = RANKX(_w, 'Date'[week_start], , ASC) - 1
		    VAR _h = 22 + DIVIDE([@s], _ms) * 70
		    RETURN "<rect class='bar' x='" & FORMAT(640 - _nw * 28 + _i * 56, "0") & "' y='" & FORMAT(500 - _h, "0.0") & "' width='46' height='" & FORMAT(_h, "0.0") & "' style='animation-delay:" & FORMAT(0.15 + _i * 0.06, "0.00") & "s'/>", "", 'Date'[week_start], ASC)
		RETURN
		"<!DOCTYPE html><html><head><meta charset='utf-8'><link href='https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cormorant+Garamond:ital,wght@1,400&display=swap' rel='stylesheet'><style>*{box-sizing:border-box;margin:0;padding:0}html,body{height:100vh;overflow:hidden;background:#07061A;font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:#fff}.w{position:relative;width:100%;height:100vh;overflow:hidden}svg{position:absolute;inset:0;width:100%;height:100%}.glow{position:absolute;inset:0;background:radial-gradient(ellipse 60% 50% at 50% 62%,rgba(91,91,214,.30),transparent 70%),radial-gradient(ellipse 40% 30% at 18% 90%,rgba(91,214,176,.10),transparent 70%)}.dim{position:absolute;inset:0;background:linear-gradient(180deg,rgba(7,6,26,.55),rgba(7,6,26,.25) 45%,rgba(7,6,26,.65));opacity:0;animation:fi 1.6s ease 2.8s forwards}.cv{stroke-dasharray:3000;stroke-dashoffset:3000;animation:dr 3.2s cubic-bezier(.65,0,.35,1) .3s forwards}@keyframes dr{to{stroke-dashoffset:0}}.bar{transform-box:fill-box;transform-origin:bottom;transform:scaleY(0);animation:ri 1.4s cubic-bezier(.16,1,.3,1) forwards}@keyframes ri{to{transform:scaleY(1)}}.wv{stroke-dasharray:14 22;animation:fl 9s linear infinite}@keyframes fl{to{stroke-dashoffset:-720}}.pt{animation:up linear infinite}@keyframes up{0%{transform:translateY(0);opacity:0}15%{opacity:.9}100%{transform:translateY(-140px);opacity:0}}.pu{transform-box:fill-box;transform-origin:center;animation:pu 2.2s ease-out 3.4s infinite;opacity:0}@keyframes pu{0%{transform:scale(.6);opacity:.9}100%{transform:scale(3.2);opacity:0}}@keyframes fi{to{opacity:1}}.rv{opacity:0;filter:blur(12px);transform:translateY(18px);animation:rv 1.6s cubic-bezier(.16,1,.3,1) forwards}@keyframes rv{to{opacity:1;filter:blur(0);transform:none}}.top{position:absolute;left:40px;top:28px;display:flex;align-items:center;gap:10px;font-size:11px;font-weight:700;letter-spacing:.14em;color:rgba(255,255,255,.85);opacity:0;animation:fi 1.2s ease 3.6s forwards}.top i{width:28px;height:28px;border-radius:8px;border:1.5px solid rgba(255,255,255,.5);display:grid;place-items:center;font-style:normal;font-size:11px;font-weight:800;letter-spacing:0}.c{position:absolute;left:0;right:0;top:21%;text-align:center}.eb{font-size:11px;letter-spacing:.42em;color:rgba(255,255,255,.62);font-weight:500}h1{font-size:58px;font-weight:800;color:#FFFFFF!important;font-family:'Plus Jakarta Sans','Segoe UI',sans-serif;letter-spacing:-.025em;margin-top:18px;line-height:1.04;text-shadow:0 10px 50px rgba(7,6,26,.8)}.sub{font-size:15.5px;color:rgba(255,255,255,.80);margin-top:16px}.ev{font-size:10px;letter-spacing:.3em;font-weight:700;color:rgba(255,255,255,.42);margin-top:22px}.ev span{color:#C7C8F7}.band{position:absolute;left:0;right:0;bottom:0;height:132px;border-top:1px solid rgba(255,255,255,.08);background:linear-gradient(180deg,rgba(7,6,26,.55),rgba(7,6,26,.9));text-align:center;padding-top:28px;opacity:0;animation:fi 1.2s ease 4s forwards}.band small{font-size:9.5px;letter-spacing:.3em;font-weight:600;color:rgba(255,255,255,.45)}.sig{position:absolute;right:42px;top:86px;text-align:right;opacity:0;animation:fi 1.5s ease 4.4s forwards}.sig b{display:block;font:italic 400 26px/1 'Cormorant Garamond',Georgia,serif;color:rgba(255,255,255,.75)}.sig small{font-size:8.5px;letter-spacing:.3em;color:rgba(255,255,255,.45)}</style></head><body><div class='w'><div class='glow'></div>
		<svg viewBox='0 0 1280 720' preserveAspectRatio='xMidYMid slice'><defs><filter id='g' x='-20%' y='-20%' width='140%' height='140%'><feGaussianBlur stdDeviation='5' result='b'/><feMerge><feMergeNode in='b'/><feMergeNode in='SourceGraphic'/></feMerge></filter>
		<linearGradient id='c' x1='0' x2='1'><stop offset='0' stop-color='#8B8CF0' stop-opacity='.2'/><stop offset='.35' stop-color='#A5A6FF'/><stop offset='.62' stop-color='#C7C8F7'/><stop offset='1' stop-color='#8B8CF0' stop-opacity='.35'/></linearGradient>
		<linearGradient id='f' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#8B8CF0' stop-opacity='0'/><stop offset='1' stop-color='#8B8CF0' stop-opacity='.9'/></linearGradient></defs>
		<g stroke='url(#f)' stroke-width='1' fill='none' opacity='.45'><line x1='444' y1='500' x2='-1040' y2='720'/><line x1='458' y1='500' x2='-920' y2='720'/><line x1='472' y1='500' x2='-800' y2='720'/><line x1='486' y1='500' x2='-680' y2='720'/><line x1='500' y1='500' x2='-560' y2='720'/><line x1='514' y1='500' x2='-440' y2='720'/><line x1='528' y1='500' x2='-320' y2='720'/><line x1='542' y1='500' x2='-200' y2='720'/><line x1='556' y1='500' x2='-80' y2='720'/><line x1='570' y1='500' x2='40' y2='720'/><line x1='584' y1='500' x2='160' y2='720'/><line x1='598' y1='500' x2='280' y2='720'/><line x1='612' y1='500' x2='400' y2='720'/><line x1='626' y1='500' x2='520' y2='720'/><line x1='640' y1='500' x2='640' y2='720'/><line x1='654' y1='500' x2='760' y2='720'/><line x1='668' y1='500' x2='880' y2='720'/><line x1='682' y1='500' x2='1000' y2='720'/><line x1='696' y1='500' x2='1120' y2='720'/><line x1='710' y1='500' x2='1240' y2='720'/><line x1='724' y1='500' x2='1360' y2='720'/><line x1='738' y1='500' x2='1480' y2='720'/><line x1='752' y1='500' x2='1600' y2='720'/><line x1='766' y1='500' x2='1720' y2='720'/><line x1='780' y1='500' x2='1840' y2='720'/><line x1='794' y1='500' x2='1960' y2='720'/><line x1='808' y1='500' x2='2080' y2='720'/><line x1='822' y1='500' x2='2200' y2='720'/><line x1='836' y1='500' x2='2320' y2='720'/><line x1='0' y1='503.4' x2='1280' y2='503.4' stroke-opacity='0.16'/><line x1='0' y1='512.6' x2='1280' y2='512.6' stroke-opacity='0.18'/><line x1='0' y1='527.3' x2='1280' y2='527.3' stroke-opacity='0.21'/><line x1='0' y1='547.1' x2='1280' y2='547.1' stroke-opacity='0.26'/><line x1='0' y1='572.0' x2='1280' y2='572.0' stroke-opacity='0.31'/><line x1='0' y1='601.8' x2='1280' y2='601.8' stroke-opacity='0.38'/><line x1='0' y1='636.5' x2='1280' y2='636.5' stroke-opacity='0.46'/><line x1='0' y1='675.9' x2='1280' y2='675.9' stroke-opacity='0.55'/><line x1='0' y1='720.0' x2='1280' y2='720.0' stroke-opacity='0.65'/></g><g fill='rgba(139,140,240,.04)' stroke='rgba(167,168,255,.16)'>" & _bars & "</g>
		<path d='M-40,690 C160,560 260,720 470,610 S760,520 1320,560' fill='none' stroke='#5BD6B0' stroke-opacity='.35' stroke-width='1.6' class='wv'/>
		<path d='M-40,712 C180,600 300,740 520,640 S820,560 1320,600' fill='none' stroke='#8B8CF0' stroke-opacity='.35' stroke-width='1.2' class='wv' style='animation-duration:13s'/>
		<path d='" & _path & "' fill='none' stroke='#8B8CF0' stroke-width='9' stroke-opacity='.18' filter='url(#g)' class='cv'/><path d='" & _path & "' fill='none' stroke='url(#c)' stroke-width='2.2' filter='url(#g)' class='cv'/>
		<g fill='#C7C8F7'><circle class='pt' cx='485' cy='493' r='2.0' style='animation-duration:5.5s;animation-delay:3.2s'/><circle class='pt' cx='522' cy='479' r='1.7' style='animation-duration:5.3s;animation-delay:2.6s'/><circle class='pt' cx='261' cy='484' r='1.6' style='animation-duration:10.8s;animation-delay:0.7s'/><circle class='pt' cx='396' cy='564' r='2.5' style='animation-duration:9.0s;animation-delay:2.4s'/><circle class='pt' cx='1059' cy='477' r='2.3' style='animation-duration:7.0s;animation-delay:0.9s'/><circle class='pt' cx='304' cy='516' r='2.3' style='animation-duration:6.3s;animation-delay:3.5s'/><circle class='pt' cx='762' cy='526' r='1.8' style='animation-duration:5.4s;animation-delay:0.4s'/><circle class='pt' cx='381' cy='572' r='1.6' style='animation-duration:7.2s;animation-delay:3.5s'/><circle class='pt' cx='599' cy='515' r='2.2' style='animation-duration:9.9s;animation-delay:1.5s'/><circle class='pt' cx='705' cy='549' r='2.4' style='animation-duration:10.1s;animation-delay:1.7s'/><circle class='pt' cx='1063' cy='488' r='1.6' style='animation-duration:10.3s;animation-delay:0.9s'/><circle class='pt' cx='630' cy='476' r='2.0' style='animation-duration:10.4s;animation-delay:3.4s'/><circle class='pt' cx='970' cy='517' r='2.1' style='animation-duration:9.2s;animation-delay:3.5s'/><circle class='pt' cx='601' cy='596' r='2.5' style='animation-duration:8.3s;animation-delay:4.0s'/><circle class='pt' cx='253' cy='575' r='2.0' style='animation-duration:12.0s;animation-delay:4.9s'/><circle class='pt' cx='450' cy='528' r='2.0' style='animation-duration:5.2s;animation-delay:2.8s'/><circle class='pt' cx='348' cy='488' r='0.9' style='animation-duration:10.4s;animation-delay:0.8s'/><circle class='pt' cx='418' cy='529' r='2.4' style='animation-duration:5.6s;animation-delay:2.7s'/><circle class='pt' cx='684' cy='603' r='2.3' style='animation-duration:11.0s;animation-delay:1.7s'/><circle class='pt' cx='565' cy='524' r='2.4' style='animation-duration:11.7s;animation-delay:0.9s'/><circle class='pt' cx='355' cy='505' r='1.2' style='animation-duration:8.4s;animation-delay:3.5s'/><circle class='pt' cx='431' cy='471' r='1.6' style='animation-duration:7.6s;animation-delay:3.4s'/><circle class='pt' cx='1039' cy='574' r='1.7' style='animation-duration:9.3s;animation-delay:4.1s'/><circle class='pt' cx='248' cy='605' r='2.2' style='animation-duration:11.1s;animation-delay:4.8s'/><circle class='pt' cx='545' cy='530' r='1.0' style='animation-duration:9.4s;animation-delay:0.4s'/><circle class='pt' cx='259' cy='501' r='1.1' style='animation-duration:7.4s;animation-delay:0.3s'/><circle class='pt' cx='200' cy='493' r='1.0' style='animation-duration:7.5s;animation-delay:0.2s'/><circle class='pt' cx='969' cy='562' r='1.1' style='animation-duration:6.8s;animation-delay:2.1s'/><circle class='pt' cx='520' cy='488' r='2.3' style='animation-duration:12.0s;animation-delay:2.8s'/><circle class='pt' cx='626' cy='483' r='1.0' style='animation-duration:7.4s;animation-delay:1.6s'/><circle class='pt' cx='929' cy='494' r='0.8' style='animation-duration:11.7s;animation-delay:3.2s'/><circle class='pt' cx='329' cy='551' r='0.8' style='animation-duration:8.7s;animation-delay:5.9s'/><circle class='pt' cx='960' cy='574' r='1.3' style='animation-duration:7.6s;animation-delay:1.0s'/><circle class='pt' cx='879' cy='550' r='2.2' style='animation-duration:7.3s;animation-delay:1.3s'/></g><circle cx='" & _px & "' cy='" & _py & "' r='9' fill='none' stroke='#C7C8F7' stroke-width='1.5' class='pu'/></svg>
		<div class='dim'></div><div class='top'><i>DP</i>DATAPAT.AI</div><div class='sig'><b>DataPat.ai</b><small>PATRICIO RIOS</small></div>
		<div class='c'><div class='eb rv' style='animation-delay:3s'>DATAPAT.AI PRESENTS</div><h1 class='rv' style='animation-delay:3.2s'>From Click to Checkout</h1>
		<div class='sub rv' style='animation-delay:3.7s'>GA4 marketing performance: acquisition, engagement, funnel and revenue for the Google Merchandise Store</div>
		<div class='ev rv' style='animation-delay:4s'>NOV 2020 — JAN 2021 · GA4 SAMPLE · <span>BUILT ON MICROSOFT FABRIC</span></div></div>
		<div class='band'><small>SELECT AN AREA TO EXPLORE</small></div></div></body></html>"
	// [Pages\00 Welcome]
	MEASURE '_Measures'[00 · 001 Cover Alt Text] =
		"From Click to Checkout: GA4 marketing performance for the Google Merchandise Store, Nov 2020 to Jan 2021. " & [00 Welcome Facts]
	// [Pages\01 Overview] — Dark insight card for page 1: peak-season concentration and the January drop (always the full 92 days).
	MEASURE '_Measures'[01 · 002 Key Insight HTML] =
		VAR _sh = CALCULATE([Peak Season Revenue Share], REMOVEFILTERS('Date'))
		VAR _ds = CALCULATE([Peak Season Day Share], REMOVEFILTERS('Date'))
		VAR _lift = CALCULATE([Peak Conversion Lift], REMOVEFILTERS('Date'))
		VAR _jr = CALCULATE([Revenue Δ%], DATESBETWEEN('Date'[date], DATE(2021,1,1), DATE(2021,1,31)), REMOVEFILTERS('Date'))
		VAR _js = CALCULATE([Sessions Δ%], DATESBETWEEN('Date'[date], DATE(2021,1,1), DATE(2021,1,31)), REMOVEFILTERS('Date'))
		RETURN
		"<!DOCTYPE html><html><head><meta charset='utf-8'><link href='https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cormorant+Garamond:ital,wght@1,400&display=swap' rel='stylesheet'><style>*{box-sizing:border-box;margin:0;padding:0}html,body{height:100vh;overflow:hidden;background:transparent;font-family:'Plus Jakarta Sans',system-ui,sans-serif}.c{height:100vh;border-radius:16px;background:linear-gradient(150deg,#1B1946,#2E2A7A);color:#fff;padding:18px 20px;display:flex;flex-direction:column}.l{font-size:9.5px;font-weight:700;letter-spacing:.16em;color:#C7C8F7}.row{display:flex;gap:18px;align-items:flex-end;margin-top:10px}.b{font-size:32px;font-weight:800;letter-spacing:-1px;line-height:1}.s{font-size:10.5px;color:#C9CAF5;margin-top:4px}.t{font-size:11px;line-height:1.55;color:#E3E4FF;margin-top:auto}</style></head><body><div class='c'><div class='l'>KEY INSIGHT · PEAK SEASON</div><div class='row'><div><div class='b'>" & FORMAT(_sh, "0%") & "</div><div class='s'>of revenue in " & FORMAT(_ds, "0%") & " of the days</div></div>
		<div><div class='b' style='color:#C7C8F7'>+" & FORMAT(_lift, "0%") & "</div><div class='s'>conversion lift vs off-peak days</div></div></div>
		<div class='t'>In January revenue falls " & FORMAT(-_jr, "0%") & " but sessions only " & FORMAT(-_js, "0%") & ": the visitors stay, the buyers leave.</div></div></body></html>"
	// [Pages\02 Acquisition] — Dark insight card for page 2: self-referral share of revenue.
	MEASURE '_Measures'[02 · 002 Attribution HTML] =
		VAR _sh = [Self-Referral Revenue Share]
		VAR _r = [Self-Referral Revenue]
		RETURN
		"<!DOCTYPE html><html><head><meta charset='utf-8'><link href='https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cormorant+Garamond:ital,wght@1,400&display=swap' rel='stylesheet'><style>*{box-sizing:border-box;margin:0;padding:0}html,body{height:100vh;overflow:hidden;background:transparent;font-family:'Plus Jakarta Sans',system-ui,sans-serif}.c{height:100vh;border-radius:16px;background:linear-gradient(150deg,#1B1946,#2E2A7A);color:#fff;padding:18px 20px;display:flex;flex-direction:column}.l{font-size:9.5px;font-weight:700;letter-spacing:.16em;color:#C7C8F7}.row{display:flex;gap:18px;align-items:flex-end;margin-top:10px}.b{font-size:32px;font-weight:800;letter-spacing:-1px;line-height:1}.s{font-size:10.5px;color:#C9CAF5;margin-top:4px}.t{font-size:11px;line-height:1.55;color:#E3E4FF;margin-top:auto}</style></head><body><div class='c'><div class='l'>ATTRIBUTION CHECK</div><div class='row' style='align-items:center'><div class='b'>" & FORMAT(_sh, "0%") & "</div>
		<div class='t' style='margin-top:0'>of revenue (" & FORMAT(_r, "$#,##0") & ") is credited to the store’s own domain, a checkout redirect rather than a partner. Read Referral’s lead with caution.</div></div></div></body></html>"
	// [Pages\04 Funnel] — Dark insight card for page 4: share of sessions reaching a product page and best vs worst channel.
	MEASURE '_Measures'[04 · 003 Where To Act HTML] =
		VAR _v = [Session to View Item Rate]
		VAR _ch = FILTER(ADDCOLUMNS(VALUES('Channel'[channel_group]), "@vi", CALCULATE([View Item Sessions], KEEPFILTERS(DATESBETWEEN('Date'[date], [Cart Tracking Start], BLANK()))), "@r", CALCULATE([View Item to Purchase Rate], KEEPFILTERS(DATESBETWEEN('Date'[date], [Cart Tracking Start], BLANK())))), [@vi] > 500)
		VAR _b = TOPN(1, _ch, [@r], DESC)
		VAR _w = TOPN(1, _ch, [@r], ASC)
		RETURN
		"<!DOCTYPE html><html><head><meta charset='utf-8'><link href='https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cormorant+Garamond:ital,wght@1,400&display=swap' rel='stylesheet'><style>*{box-sizing:border-box;margin:0;padding:0}html,body{height:100vh;overflow:hidden;background:transparent;font-family:'Plus Jakarta Sans',system-ui,sans-serif}.c{height:100vh;border-radius:16px;background:linear-gradient(150deg,#1B1946,#2E2A7A);color:#fff;padding:18px 20px;display:flex;flex-direction:column}.l{font-size:9.5px;font-weight:700;letter-spacing:.16em;color:#C7C8F7}.row{display:flex;gap:18px;align-items:flex-end;margin-top:10px}.b{font-size:32px;font-weight:800;letter-spacing:-1px;line-height:1}.s{font-size:10.5px;color:#C9CAF5;margin-top:4px}.t{font-size:11px;line-height:1.55;color:#E3E4FF;margin-top:auto}</style></head><body><div class='c'><div class='l'>WHERE TO ACT</div><div class='row' style='align-items:center'><div class='b'>" & FORMAT(_v, "0%") & "</div>
		<div class='t' style='margin-top:0'>of sessions ever open a product page. Fixing view → cart helps those; getting more visitors to a product page widens the whole funnel. " &
		IF(COUNTROWS(_ch) > 1, MAXX(_b, 'Channel'[channel_group]) & " turns " & FORMAT(MAXX(_b, [@r]), "0.0%") & " of viewers into buyers vs " & FORMAT(MAXX(_w, [@r]), "0.0%") & " for " & MAXX(_w, 'Channel'[channel_group]) & ".") & "</div></div></div></body></html>"
	// [Pages\05 Products] — HTML Content visual: cumulative share of item revenue (Pareto curve) with the half-revenue marker.
	MEASURE '_Measures'[05 · 002 Pareto HTML] =
		VAR _t = FILTER(ADDCOLUMNS(VALUES('Items Daily'[item_name]), "@r", [Item Revenue]), [@r] > 0)
		VAR _n = COUNTROWS(_t)
		VAR _tot = SUMX(_t, [@r])
		VAR _half = [Items for Half of Revenue]
		VAR _pts = CONCATENATEX(_t,
		    VAR _cur = [@r]
		    VAR _rk = COUNTROWS(FILTER(_t, [@r] > _cur)) + 1
		    VAR _cum = SUMX(FILTER(_t, [@r] >= _cur), [@r])
		    RETURN FORMAT(DIVIDE(_rk, _n) * 1000, "0.0") & "," & FORMAT(1000 - DIVIDE(_cum, _tot) * 1000, "0.0"), " L", [@r], DESC)
		VAR _hx = FORMAT(DIVIDE(_half, _n) * 1000, "0.0")
		RETURN
		"<!DOCTYPE html><html><head><meta charset='utf-8'><link href='https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cormorant+Garamond:ital,wght@1,400&display=swap' rel='stylesheet'><style>*{margin:0;padding:0}html,body{height:100vh;overflow:hidden;background:transparent;font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:#1A1840}.w{position:relative;height:100vh}svg{width:100%;height:calc(100vh - 18px)}.x{font-size:10px;color:#5E6189;text-align:center}.lb{position:absolute;font-size:10.5px;font-weight:800}</style></head><body><div class='w'>
		<svg viewBox='0 0 1000 1000' preserveAspectRatio='none'><line x1='0' x2='1000' y1='500' y2='500' stroke='#C7C8F7' stroke-dasharray='8 8' vector-effect='non-scaling-stroke'/>
		<line x1='" & _hx & "' x2='" & _hx & "' y1='500' y2='1000' stroke='#5B5BD6' stroke-dasharray='8 8' vector-effect='non-scaling-stroke'/>
		<path d='M0,1000 L" & _pts & " L1000,1000 Z' fill='#5B5BD6' fill-opacity='.12'/><path d='M0,1000 L" & _pts & "' fill='none' stroke='#5B5BD6' stroke-width='2.2' vector-effect='non-scaling-stroke'/></svg>
		<div class='lb' style='left:calc(" & FORMAT(DIVIDE(_half, _n) * 100, "0.0") & "% + 8px);top:calc(50% - 4px)'>" & _half & " items = 50%</div><div class='x'>" & _n & " items sold, best first</div></div></body></html>"
	// [Pages\01 Overview] — Page body: the prototype's chart code (pbi_runtime.js) fed with model data for the current filters.
	MEASURE '_Measures'[01 · 002 Body HTML] =
		VAR _range = "{" & "s:" & "'" & FORMAT([Period Start], "yyyy-mm-dd") & "'" & "," & "e:" & "'" & FORMAT([Period End], "yyyy-mm-dd") & "'" & "}"
		VAR _daily = ADDCOLUMNS(FILTER(CALCULATETABLE(SUMMARIZE('Date', 'Date'[date], 'Date'[holiday_name], 'Date'[is_peak_season]), REMOVEFILTERS('Date')), NOT ISBLANK('Date'[date])),
		    "@r", VAR _d = 'Date'[date] RETURN CALCULATE([Revenue], REMOVEFILTERS('Date'), 'Date'[date] = _d), "@s", VAR _d = 'Date'[date] RETURN CALCULATE([Sessions], REMOVEFILTERS('Date'), 'Date'[date] = _d), "@cr", VAR _d = 'Date'[date] RETURN CALCULATE([Conversion Rate], REMOVEFILTERS('Date'), 'Date'[date] = _d))
		VAR _ch = FILTER(ADDCOLUMNS(FILTER(VALUES('Channel'[channel_group]), NOT ISBLANK('Channel'[channel_group])), "@r", [Revenue], "@s", [Sessions], "@rs", [Revenue Share], "@ss", [Session Share], "@cr", [Conversion Rate], "@aov", [AOV]), NOT ISBLANK([@s]))
		VAR _jr = CALCULATE([Revenue Δ%], DATESBETWEEN('Date'[date], DATE(2021,1,1), DATE(2021,1,31)), REMOVEFILTERS('Date'))
		VAR _js = CALCULATE([Sessions Δ%], DATESBETWEEN('Date'[date], DATE(2021,1,1), DATE(2021,1,31)), REMOVEFILTERS('Date'))
		VAR _data = "{" & "page:" & 1 & "," & "range:" & _range & "," & "daily:" & "[" & CONCATENATEX(_daily, "{" & "date:" & "'" & FORMAT('Date'[date], "yyyy-mm-dd") & "T00:00:00'" & "," & "r:" & IF(ISBLANK([@r]), "null", FORMAT([@r], "0.##########")) & "," & "s:" & IF(ISBLANK([@s]), "null", FORMAT([@s], "0.##########")) & "," & "cr:" & IF(ISBLANK([@cr]), "null", FORMAT([@cr], "0.##########")) & "," & "holiday_name:" & IF('Date'[holiday_name] = "", "null", IF(ISBLANK('Date'[holiday_name]), "null", "'" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE('Date'[holiday_name] & "", "\", "\\"), "'", "\'"), "<", "\x3c") & "'")) & "," & "is_peak_season:" & IF('Date'[is_peak_season], "true", "false") & "}", ",", 'Date'[date], ASC) & "]" & "," & "allkpi:" & "{" & "'Peak Season Day Share':" & IF(ISBLANK(CALCULATE([Peak Season Day Share], REMOVEFILTERS('Date'))), "null", FORMAT(CALCULATE([Peak Season Day Share], REMOVEFILTERS('Date')), "0.##########")) & "," & "'Peak Season Revenue Share':" & IF(ISBLANK(CALCULATE([Peak Season Revenue Share], REMOVEFILTERS('Date'))), "null", FORMAT(CALCULATE([Peak Season Revenue Share], REMOVEFILTERS('Date')), "0.##########")) & "," & "'Peak Conversion Lift':" & IF(ISBLANK(CALCULATE([Peak Conversion Lift], REMOVEFILTERS('Date'))), "null", FORMAT(CALCULATE([Peak Conversion Lift], REMOVEFILTERS('Date')), "0.##########")) & "}" & "," & "jankpi:" & "{" & "'Revenue Δ%':" & IF(ISBLANK(_jr), "null", FORMAT(_jr, "0.##########")) & "," & "'Sessions Δ%':" & IF(ISBLANK(_js), "null", FORMAT(_js, "0.##########")) & "}" & "," & "view:" & "{" & "kpi:" & "{" & "'Revenue Share of Top Channel':" & IF(ISBLANK([Revenue Share of Top Channel]), "null", FORMAT([Revenue Share of Top Channel], "0.##########")) & "," & "'Best Revenue Day':" & IF(ISBLANK([Best Revenue Day]), "null", "'" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE([Best Revenue Day] & "", "\", "\\"), "'", "\'"), "<", "\x3c") & "'") & "}" & "," & "channel:" & "[" & CONCATENATEX(_ch, "{" & "channel_group:" & IF(ISBLANK('Channel'[channel_group]), "null", "'" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE('Channel'[channel_group] & "", "\", "\\"), "'", "\'"), "<", "\x3c") & "'") & "," & "r:" & IF(ISBLANK([@r]), "null", FORMAT([@r], "0.##########")) & "," & "s:" & IF(ISBLANK([@s]), "null", FORMAT([@s], "0.##########")) & "," & "rs:" & IF(ISBLANK([@rs]), "null", FORMAT([@rs], "0.##########")) & "," & "ss:" & IF(ISBLANK([@ss]), "null", FORMAT([@ss], "0.##########")) & "," & "cr:" & IF(ISBLANK([@cr]), "null", FORMAT([@cr], "0.##########")) & "," & "aov:" & IF(ISBLANK([@aov]), "null", FORMAT([@aov], "0.##########")) & "}", ",", [@r], DESC) & "]" & "}" & "}"
		RETURN
		"<!DOCTYPE html><html><head><meta charset='utf-8'><link href='https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cormorant+Garamond:ital,wght@1,400&display=swap' rel='stylesheet'><style>
		:root{
		  --bg:#F3F4FA; --card:#FFFFFF; --ink:#1A1840; --sub:#5E6189; --muted:#9A9DC0; --line:#ECEDF6; --line2:#F3F4FA;
		  --acc:#5B5BD6; --acc-d:#4338CA; --acc2:#8B8CF0; --acc3:#C7C8F7; --soft:#EEEFFD;
		  --good:#0E9F6E; --bad:#E5484D; --warn:#F59E0B; --navy1:#1B1946; --navy2:#0F0D2E;
		  --r:16px; --shadow:0 1px 2px rgba(26,24,64,.04),0 8px 24px rgba(26,24,64,.05);
		  --rail:200px;
		}
		*{box-sizing:border-box;margin:0;padding:0}
		html,body{height:100%;background:#DCDEF2;font-family:'Plus Jakarta Sans',system-ui,-apple-system,Segoe UI,sans-serif;color:var(--ink);-webkit-font-smoothing:antialiased}
		#stage{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;overflow:hidden}
		#canvas{width:1280px;height:720px;background:var(--bg);position:relative;transform-origin:center center;border-radius:8px;overflow:hidden;box-shadow:0 24px 70px rgba(26,24,64,.20)}
		#canvas.collapsed{--rail:68px}
		/* ---------- rail ---------- */
		.rail{position:absolute;left:0;top:0;bottom:0;width:var(--rail);background:linear-gradient(180deg,var(--navy1) 0%,var(--navy2) 100%);color:#fff;padding:22px 14px 16px;display:flex;flex-direction:column;transition:width .25s ease;overflow:hidden;z-index:20}
		.rail::after{content:'';position:absolute;left:-60px;bottom:-80px;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(91,91,214,.35),transparent 65%);pointer-events:none}
		.brand{display:flex;gap:11px;align-items:center;padding:0 4px;min-height:38px}
		.logo{width:36px;height:36px;flex:none;border-radius:10px;background:linear-gradient(135deg,var(--acc),#7C7DF0);display:grid;place-items:center;font-weight:800;font-size:12.5px;box-shadow:0 6px 16px rgba(91,91,214,.4)}
		.brand b{font-size:13.5px;display:block;line-height:1.2;white-space:nowrap}.brand small{font-size:10px;color:rgba(255,255,255,.55);white-space:nowrap}
		.sec{font-size:9.5px;font-weight:700;letter-spacing:.16em;color:rgba(255,255,255,.42);margin:28px 0 10px 8px;white-space:nowrap}
		.nav{display:flex;flex-direction:column;gap:3px}
		.nav button,.sup button{all:unset;cursor:pointer;position:relative;display:flex;gap:12px;align-items:center;height:38px;padding:0 11px;border-radius:10px;font-size:12.5px;font-weight:500;color:rgba(255,255,255,.72);transition:background .15s,color .15s;white-space:nowrap}
		.nav button svg,.sup button svg{width:17px;height:17px;flex:none;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
		.nav button:hover,.sup button:hover{background:rgba(255,255,255,.07);color:#fff}
		.nav button.on{background:rgba(255,255,255,.12);color:#fff;font-weight:700}
		.nav button.on::before{content:'';position:absolute;left:-14px;top:9px;bottom:9px;width:3px;border-radius:0 3px 3px 0;background:var(--acc2)}
		.sup{margin-top:auto;display:flex;flex-direction:column;gap:3px;position:relative;z-index:1}
		.sup button.on{background:rgba(245,158,11,.18);color:#FCD34D}
		.collapsed .lbl,.collapsed .brand div{display:none}
		.collapsed .sec{opacity:0;pointer-events:none}
		.collapsed .brand{justify-content:center;padding:0}
		.collapsed .nav button,.collapsed .sup button{justify-content:center;padding:0}
		.lbl{transition:opacity .15s}
		#btnCol svg{transition:transform .25s}.collapsed #btnCol svg{transform:rotate(180deg)}
		/* ---------- main ---------- */
		.main{position:absolute;left:calc(var(--rail) + 18px);right:18px;top:16px;bottom:16px;display:flex;flex-direction:column;gap:12px;transition:left .25s ease}
		.hdr{height:80px;flex:none;background:var(--card);border-radius:var(--r);box-shadow:var(--shadow);border:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:24px;padding:0 22px}
		.hl{min-width:0}
		.ht{display:flex;align-items:center;gap:10px}
		.hn{font-size:10px;font-weight:800;color:var(--acc);background:var(--soft);border-radius:6px;padding:3px 7px;letter-spacing:.06em}
		.ht h1{font-size:19px;font-weight:800;letter-spacing:-.3px}
		.hs{font-size:12px;line-height:1.5;color:var(--sub);margin-top:5px;max-width:640px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
		.hr{display:flex;flex-direction:column;align-items:flex-end;gap:6px;flex:none}
		.pick{all:unset;cursor:pointer;display:flex;align-items:center;gap:9px;height:36px;padding:0 13px;border:1px solid var(--line);border-radius:10px;background:#fff;font-size:12px;font-weight:600;color:var(--ink);transition:border-color .15s,box-shadow .15s}
		.pick:hover,.pick.on{border-color:var(--acc2);box-shadow:0 0 0 3px var(--soft)}
		.pick svg{width:15px;height:15px;stroke:var(--acc);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
		.pick .chev{stroke:var(--muted)}
		.cmp{font-size:10.5px;color:var(--muted)}
		.cmp b{color:var(--sub);font-weight:600}
		/* ---------- kpi cards ---------- */
		.kpis{height:120px;flex:none;display:flex;gap:12px}
		.k{flex:1;min-width:0;background:var(--card);border-radius:var(--r);border:1px solid var(--line);padding:14px 16px 12px;display:flex;flex-direction:column;box-shadow:var(--shadow);position:relative;overflow:hidden}
		.kh{display:flex;align-items:center;gap:9px}
		.ki{width:26px;height:26px;border-radius:8px;background:var(--soft);display:grid;place-items:center;flex:none}
		.ki svg{width:14px;height:14px;stroke:var(--acc);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
		.kl{font-size:11px;font-weight:600;color:var(--sub);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
		.kn{font-size:25px;font-weight:800;letter-spacing:-.6px;margin-top:7px;line-height:1}
		.kd{border-top:1px solid var(--line);margin-top:auto;padding-top:7px;display:flex;flex-direction:column;gap:3px}
		.kr{display:flex;justify-content:space-between;gap:8px;font-size:10px}
		.kr span{color:var(--muted);font-weight:600;letter-spacing:.04em;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
		.kr b{font-weight:700;white-space:nowrap}
		.k .why{position:absolute;inset:0;background:var(--ink);color:#fff;padding:14px 16px;font-size:10.5px;line-height:1.55;opacity:0;transition:opacity .2s;pointer-events:none}
		.k .why b{display:block;font-size:9px;letter-spacing:.14em;color:var(--acc3);margin-bottom:5px}
		.k:hover .why{opacity:1}
		/* ---------- body ---------- */
		#pages{flex:1;position:relative;min-height:0}
		.body{position:absolute;inset:0;display:grid;gap:12px}
		.card{background:var(--card);border-radius:var(--r);border:1px solid var(--line);box-shadow:var(--shadow);padding:18px 20px;position:relative;overflow:hidden;display:flex;flex-direction:column;min-height:0}
		.ct{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
		.ct h3{font-size:14px;font-weight:700;letter-spacing:-.15px}
		.ct p{font-size:11px;line-height:1.45;color:var(--sub);margin-top:4px}
		.tog{display:flex;gap:2px;flex:none;background:var(--line2);border-radius:9px;padding:3px}
		.tog button{all:unset;cursor:pointer;font-size:10.5px;font-weight:700;padding:5px 10px;border-radius:7px;color:var(--sub)}
		.tog button.on{background:#fff;color:var(--acc-d);box-shadow:0 1px 3px rgba(26,24,64,.12)}
		.fill{flex:1;min-height:0;position:relative;margin-top:14px}
		.fill[style*=""overflow""]{overflow-x:hidden!important;scrollbar-width:thin}
		.foot{font-size:10.5px;color:var(--muted);margin-top:10px;line-height:1.45}
		.pill{display:inline-flex;align-items:center;gap:4px;font-size:9.5px;font-weight:700;padding:3px 8px;border-radius:99px;letter-spacing:.2px}
		.pill.good{background:#E3F6EF;color:var(--good)}.pill.bad{background:#FDE8E8;color:var(--bad)}.pill.acc{background:var(--soft);color:var(--acc-d)}.pill.warn{background:#FEF3DD;color:#B45309}.pill.mute{background:#F1F2F8;color:var(--sub)}
		table{width:100%;border-collapse:collapse;font-size:11px}
		th{font-size:9.5px;font-weight:700;letter-spacing:.08em;color:var(--muted);text-align:right;padding:7px 8px;border-bottom:1px solid var(--line);cursor:pointer;white-space:nowrap;user-select:none;position:sticky;top:0;background:#fff}
		th:first-child,td:first-child{text-align:left}
		table[data-id=""it""] td:nth-child(2),table[data-id=""it""] th:nth-child(2){text-align:left}
		th.sorted{color:var(--acc)}
		td{padding:7px 8px;text-align:right;border-bottom:1px solid var(--line2);white-space:nowrap}
		tr:hover td{background:#FAFAFE}
		td .bar{display:inline-block;height:6px;border-radius:3px;background:var(--acc2);vertical-align:middle;margin-left:6px}
		.trunc{max-width:230px;overflow:hidden;text-overflow:ellipsis;display:inline-block;vertical-align:bottom}
		#tip{position:absolute;pointer-events:none;background:var(--ink);color:#fff;font-size:10.5px;line-height:1.5;padding:9px 11px;border-radius:10px;opacity:0;transition:opacity .12s;z-index:60;max-width:260px;box-shadow:0 10px 28px rgba(26,24,64,.3)}
		#tip b{color:var(--acc3)}
		.insight{background:linear-gradient(150deg,var(--navy1),#2E2A7A);color:#fff;border:none}
		.insight .ct p{color:#C9CAF5}
		.big{font-size:32px;font-weight:800;letter-spacing:-1px;line-height:1}
		.insight .lbl2{font-size:9.5px;font-weight:700;letter-spacing:.16em;color:var(--acc3)}
		.ovl{position:absolute;inset:0;z-index:50;display:none}
		.ovl.on{display:block}
		#howto{background:rgba(26,24,64,.45);backdrop-filter:blur(3px)}
		#howto .panel{position:absolute;right:20px;top:20px;bottom:20px;width:370px;background:#fff;border-radius:18px;padding:26px;overflow:auto}
		#howto h4{font-size:16px;margin-bottom:4px;line-height:1.35}
		#howto ol{margin-top:14px;padding-left:0;list-style:none;display:flex;flex-direction:column;gap:14px}
		#howto li{display:flex;gap:11px;font-size:11.5px;line-height:1.55;color:var(--sub)}
		#howto li i{flex:none;width:24px;height:24px;border-radius:8px;background:var(--soft);color:var(--acc-d);font-style:normal;font-weight:800;display:grid;place-items:center;font-size:11px}
		#howto li b{color:var(--ink)}
		#howto .x{all:unset;cursor:pointer;position:absolute;right:16px;top:12px;font-size:22px;color:var(--sub)}
		.eyebrow{font-size:10px;font-weight:700;letter-spacing:.16em;color:var(--acc)}
		.build .card,.build .k{outline:2px dashed var(--warn);outline-offset:-2px}
		.tag{display:none;position:absolute;right:8px;bottom:8px;z-index:30;background:#FFF7E6;color:#92400E;border:1px solid #F5C66B;font-size:9px;font-weight:700;padding:3px 6px;border-radius:6px;max-width:92%;line-height:1.35;text-align:left}
		.build .tag{display:block}
		.legend{display:flex;gap:14px;font-size:10.5px;color:var(--sub);align-items:center}
		.legend i{display:inline-block;width:9px;height:9px;border-radius:3px;margin-right:5px;vertical-align:-1px}
		.chips{display:flex;flex-wrap:wrap;gap:5px}
		.chips button{all:unset;cursor:pointer;font-size:10px;font-weight:700;padding:4px 10px;border-radius:99px;background:var(--line2);color:var(--sub);text-transform:capitalize}
		.chips button.on{background:var(--acc);color:#fff}
		.note{display:inline-flex;align-items:center;gap:5px;font-size:9.5px;font-weight:700;color:#B45309;background:#FEF3DD;border-radius:6px;padding:2px 7px}
		/* ---------- date picker ---------- */
		#pop{position:absolute;z-index:55;display:none;background:#fff;border-radius:16px;border:1px solid var(--line);box-shadow:0 24px 60px rgba(26,24,64,.22);width:760px;overflow:hidden}
		#pop.on{display:flex}
		.pp-pre{width:190px;flex:none;border-right:1px solid var(--line);padding:14px 10px;display:flex;flex-direction:column;gap:2px;background:#FBFBFE}
		.pp-pre small{font-size:9.5px;font-weight:700;letter-spacing:.14em;color:var(--muted);padding:2px 10px 8px}
		.pp-pre button{all:unset;cursor:pointer;font-size:12px;font-weight:500;color:var(--sub);padding:8px 10px;border-radius:8px}
		.pp-pre button:hover{background:var(--soft);color:var(--ink)}
		.pp-pre button.on{background:var(--acc);color:#fff;font-weight:700}
		.pp-main{flex:1;padding:16px 18px;display:flex;flex-direction:column;gap:12px}
		.pp-cals{display:flex;gap:18px}
		.cal{flex:1}
		.cal h5{font-size:12px;font-weight:700;text-align:center;margin-bottom:8px}
		.cal .g{display:grid;grid-template-columns:repeat(7,1fr);gap:2px 0}
		.cal .g span{font-size:9.5px;font-weight:700;color:var(--muted);text-align:center;padding-bottom:4px}
		.cal .g button{all:unset;cursor:pointer;height:28px;display:grid;place-items:center;font-size:11px;color:var(--ink);border-radius:0}
		.cal .g button:hover{background:var(--soft);border-radius:7px}
		.cal .g button.in{background:var(--soft);color:var(--acc-d)}
		.cal .g button.edge{background:var(--acc);color:#fff;font-weight:700;border-radius:7px}
		.cal .g button.hol{text-decoration:underline;text-decoration-color:var(--acc2);text-underline-offset:3px}
		.pp-ft{display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--line);padding-top:12px}
		.pp-ft p{font-size:11px;color:var(--sub);flex:1;padding-right:14px;line-height:1.45}.pp-ft p b{color:var(--ink)}
		.pp-ft div{display:flex;gap:8px}
		.pp-ft button{all:unset;cursor:pointer;white-space:nowrap;font-size:11.5px;font-weight:700;padding:8px 16px;border-radius:9px;background:var(--line2);color:var(--sub)}
		.pp-ft button.pri{background:var(--acc);color:#fff}
		.pp-ft button:disabled{opacity:.4;cursor:default}
		/* ---------- rolling table ---------- */
		.rt th{cursor:default;text-align:right}
		.rt thead tr:first-child th{text-align:center;color:var(--acc);border-bottom:none;padding-bottom:0;letter-spacing:.14em}
		.rt tbody th{position:static;text-align:left;font-size:11.5px;font-weight:600;color:var(--ink);letter-spacing:0;border-bottom:1px solid var(--line2);padding:4px 8px}
		.rt td{padding:4px 10px;font-size:11.5px}
		.rt thead th{padding:5px 8px}
		.rt td.p{color:var(--muted)}
		.rt td.sep,.rt th.sep{border-left:1px solid var(--line)}
		
		html,body{background:transparent!important;height:100vh;overflow:hidden}
		#pages{position:absolute;inset:0}
		#tip{position:fixed}
		</style></head><body><div id='pages'></div><div id='tip'></div><script>window.__D=" & _data & ";</script><script>
		const DATA = window.__D;
		const D = {day: DATA.days || [], ch_day: [], dev_day: [], daily: DATA.daily || [], ti_daily: DATA.ti_daily || [],
