# Placeholder names only. Copy to .env locally (gitignored).
# Never commit real values.

# GCP billing/quota project for the BigQuery Storage Read API export.
# Required: the public dataset is free, but the Storage Read API needs a billable project.
GCP_PROJECT=your-gcp-project

# Microsoft Fabric targets for the OneLake upload.
# Names are fine to keep; replace the IDs with your own.
FABRIC_WORKSPACE_NAME=GA4-Report
FABRIC_LAKEHOUSE_NAME=GA4Lakehouse
FABRIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
FABRIC_LAKEHOUSE_ID=00000000-0000-0000-0000-000000000000
